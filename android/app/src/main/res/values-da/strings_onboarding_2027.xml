    <string name="ob27_anon_title">Intet nummer nødvendigt</string>
    <string name="ob27_anon_body">Ingen konto, ingen e-mail, intet nummer at tilmelde dig med. Din identitet er en nøgle, der oprettes på denne telefon.</string>
    <string name="ob27_together_title">Tag dine folk med</string>

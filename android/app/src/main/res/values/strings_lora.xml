    <string name="lora_name_save">Save name</string>
    <string name="lora_name_saved">Sent to the node. Other clients pick it up on the next announcement.</string>
    <string name="lora_name_footer">The short name is what fits on the node\u2019s own display and in other clients\u2019 lists. Meshtastic allows four BYTES there, so one emoji uses the whole budget.</string>

    <string name="lora_routing_section">ROUTING</string>
    <string name="lora_routing_prefer_radio">Prefer my radio over the internet</string>
    <string name="lora_routing_prefer_radio_note">Text messages go out over LoRa first. Photos and files keep using the network when one is available — over the radio they would take minutes.</string>
    <string name="lora_routing_no_internet">Never send over the internet</string>
    <string name="lora_routing_no_internet_note">Nothing you send touches the relay — not a message, not a read receipt. Anything that cannot go by radio or to a nearby phone waits as pending. Incoming messages still arrive over the internet.</string>
    <string name="lora_routing_no_route_warning">No radio is paired, so nothing can be sent until one is — or until a phone running OSHI is close enough for the mesh.</string>

    <!-- __LORA_CHANNEL_2026_10_26__ Which mesh the node is on. Asked for by a
         Play reviewer in Chile: the region was settable from the node screen,
         the channel was not. -->
    <string name="lora_channel_section">Mesh channel</string>
    <string name="lora_channel_footer">The channel is which mesh you are on: two radios only hear each other when the name AND the key match. Leave both empty for LongFast, the channel the Meshtastic app ships with. Type a name to join a community mesh, and paste its key if it has one.</string>
    <string name="lora_channel_name">Channel name</string>
    <string name="lora_channel_name_budget">%1$d of %2$d bytes</string>
    <string name="lora_channel_key">Channel key (optional)</string>
    <string name="lora_channel_key_default">Default key</string>
    <string name="lora_channel_key_hint">Empty uses the public default key, like a stock Meshtastic node. Paste the base64 key from a channel URL to use a private one.</string>
    <string name="lora_channel_key_invalid">That is not a channel key. Paste the base64 key from a Meshtastic channel URL (16 or 32 bytes), or leave it empty for the default.</string>

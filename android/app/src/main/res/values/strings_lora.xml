<?xml version="1.0" encoding="utf-8"?>
<!--
    LoRa / Meshtastic strings — the Android port of the iOS LoRa screens.

    Kept in their own file so no existing strings.xml (or any values-* locale
    folder) is touched. English only; every key here still needs translating.

    Wording is copied from iOS en.lproj/Localizable.strings (keys "lora.*" and
    "meshtastic.*", lines 4583-4767) so both platforms say the same thing. Keys
    marked NEW have no iOS counterpart — they cover controls iOS reaches through
    a different route (owner rename, the diagnostics read-out).
-->

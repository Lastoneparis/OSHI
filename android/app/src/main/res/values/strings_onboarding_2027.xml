    <string name="ob27_private_title">Only you and them</string>
    <string name="ob27_private_body">Messages and calls are end-to-end encrypted on your phone. Nobody in between can read them — not even OSHI.</string>

    <string name="ob27_offline_title">Works without internet</string>
    <string name="ob27_offline_body">No network? Messages hop phone to phone through people nearby who have OSHI open. A LoRa radio takes them further.</string>
    <!-- Short labels under the three distances (~100 m / ~500 m / ~30 km) -->
    <string name="ob27_range_direct">direct</string>
    <string name="ob27_range_relayed">relayed</string>
    <string name="ob27_range_lora">LoRa radio</string>

    <string name="ob27_anon_title">No phone number needed</string>
    <string name="ob27_anon_body">No account, no email, no number to sign up with. Your identity is a key created on this phone.</string>

    <string name="ob27_together_title">Bring your people</string>
    <string name="ob27_together_body">Chat one to one or in groups. Add someone by scanning their QR code or sending them an invite link.</string>

    <string name="ob27_rules_title">Before you start</string>
    <string name="ob27_rules_subtitle">A few house rules, and what OSHI can and can’t do yet.</string>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Parity strings added by the settings/platform parity pass (2026-08-13).
  English values only — every key here still needs translating into the other
  33 locales. Kept in a separate file from values/strings.xml on purpose so
  concurrent edits to that file do not conflict.
-->
<resources>


         hardcoded English literals (FCMService.kt, CallService.kt,
         IncomingCallService.kt, MeshNetworkService.kt, MessageSyncService.kt,
         ScheduledCallReceiver.kt). iOS has no equivalent (no channels on iOS).
         =================================================================== -->
    <string name="channel_messages_name">Messages</string>
    <string name="channel_messages_desc">New message notifications</string>
    <string name="channel_calls_name">Calls</string>
    <string name="channel_calls_desc">Incoming call notifications</string>

    <string name="ob27_anon_title">Geen telefoonnummer nodig</string>
    <string name="ob27_anon_body">Geen account, geen e-mail, geen nummer om je aan te melden. Je identiteit is een sleutel die op deze telefoon is gemaakt.</string>
    <string name="ob27_together_title">Haal je mensen erbij</string>

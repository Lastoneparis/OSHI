    <string name="ob27_range_lora">radio LoRa</string>
    <string name="ob27_anon_title">Bez numeru telefonu</string>
    <string name="ob27_anon_body">Bez konta, e-maila i numeru do rejestracji. Twoja tożsamość to klucz utworzony na tym telefonie.</string>
    <string name="ob27_together_title">Zaproś swoich</string>
    <string name="ob27_together_body">Rozmawiaj we dwoje lub w grupach. Dodaj kogoś, skanując jego kod QR lub wysyłając link z zaproszeniem.</string>
    <string name="ob27_rules_title">Zanim zaczniesz</string>
    <string name="ob27_rules_subtitle">Kilka zasad oraz to, co OSHI już potrafi, a czego jeszcze nie.</string>
    <string name="ob27_rules_do">Co robić</string>

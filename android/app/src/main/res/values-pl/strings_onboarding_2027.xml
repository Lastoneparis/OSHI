    <string name="ob27_notif_title">Nie przegap wiadomości</string>
    <string name="ob27_notif_body">Zezwól na powiadomienia, aby widzieć nowe wiadomości i połączenia. Możesz je wyłączyć w każdej chwili w Ustawieniach.</string>
    <string name="ob27_notif_allow">Zezwól na powiadomienia</string>
    <string name="ob27_not_now">Nie teraz</string>

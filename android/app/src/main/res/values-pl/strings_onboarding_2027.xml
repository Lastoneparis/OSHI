    <string name="ob27_private_title">Tylko ty i oni</string>
    <string name="ob27_private_body">Wiadomości i połączenia są szyfrowane end-to-end na twoim telefonie. Nikt po drodze ich nie przeczyta — nawet OSHI.</string>
    <string name="ob27_offline_title">Działa bez internetu</string>
    <string name="ob27_offline_body">Brak sieci? Wiadomości przeskakują z telefonu na telefon przez osoby w pobliżu, które mają otwarte OSHI. Radio LoRa niesie je jeszcze dalej.</string>
    <string name="ob27_range_direct">bezpośrednio</string>

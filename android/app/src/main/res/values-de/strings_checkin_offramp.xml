<?xml version="1.0" encoding="utf-8"?>
<!--
    Check-in OFF-RAMP strings (added 2026-08-24, feature-check fix).

    Own file, per locale, deliberately: `values-*/strings.xml` is co-owned by
    several passes in flight and appending 34 copies of the same keys to it is how
    two sessions clobber each other. Nothing else references this file.

    These are the words on the only controls a user has for ending their own
    check-in: three notification buttons, an in-chat banner and the "Are you okay?"
    dialog. Before this pass those controls did not exist and every overdue check-in
    escalated to an emergency alert sent to a contact.
-->
<resources>
    <!-- Notification action + banner button: extend the deadline by a quarter hour.
         iOS: "checkin.extend_15" (NotificationManager.swift:174). -->
    <string name="checkin_extend_15">+15 Min.</string>

    <!-- Body of the in-app "Are you okay?" dialog.
         iOS: "checkin.warning.message" (CheckInView.swift:900). -->
    <string name="checkin_warning_message">Du bist noch nicht am Ziel angekommen. Dein Kontakt wird benachrichtigt, wenn du nicht reagierst.</string>

    <!-- Trip-duration picker in the check-in sheet. This IS the deadline the
         emergency escalation is measured against; it used to be hardcoded to
         30 minutes with the comment "For demo". -->
    <string name="checkin_duration">Wie lange dauert es?</string>
    <string name="checkin_duration_min">%1$d Min.</string>

    <!-- Under the destination field: what a resolved / unresolved place means. -->
    <string name="checkin_dest_hint">OSHI erkennt deine Ankunft und beendet den Check-in für dich.</string>
    <string name="checkin_dest_no_fix">Kein Ort ausgewählt – OSHI kann deine Ankunft nicht erkennen. Du musst selbst auf „Ich bin angekommen“ tippen.</string>
</resources>

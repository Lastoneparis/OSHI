   ============================================ */

"about.navigationTitle" = "Acerca de";
"about.tagline" = "El Mensajero Soberano";
"about.tag.offline" = "Sin Conexión";
"about.tag.secure" = "Seguro";
"about.tag.decentralized" = "Descentralizado";
"about.vision.title" = "La Visión";
"about.vision.paragraph1" = "OSHI no es solo un mensajero — es un **protocolo de comunicación para la libertad digital**. Construido sobre principios de soberanía, privacidad y resiliencia.";
"about.vision.paragraph2" = "Cuando alguien está al alcance, OSHI funciona **sin Internet y sin ningún servidor**, enrutando los mensajes por una **red mallada entre pares** a través de enlaces Bluetooth/Wi-Fi directos o relés de varios saltos. Cuando no hay nadie al alcance, recurre a nuestro relé para que el mensaje llegue igualmente.";
"about.vision.paragraph3" = "Cada mensaje está protegido por el **Double Ratchet** con acuerdo de claves **X3DH** y **AES-256-GCM** — la misma construcción que usa Signal — y se mantiene a través de relés sin conexión y entregas desordenadas.";
"about.principles.title" = "Principios Fundamentales";
"about.principles.privacy.title" = "Privacidad por Defecto";
"about.principles.privacy.desc" = "Sin número de teléfono, sin correo electrónico, sin cuenta, sin seguimiento. Los mensajes enviados por la red mallada no dejan absolutamente nada en ningún servidor.";
"about.principles.decentralization.title" = "Descentralización";
"about.principles.decentralization.desc" = "Sin autoridad central, sin punto único de falla. Poder distribuido a través de la red.";
"about.principles.sovereignty.title" = "Soberanía";
"about.principles.sovereignty.desc" = "Tú controlas tu identidad, tus datos y tus conexiones. Sin corporaciones, sin vigilancia.";
"about.principles.resilience.title" = "Resiliencia";
"about.principles.resilience.desc" = "Funciona en apagones de internet, censura o escenarios de desastre. La comunicación no puede ser detenida.";
"about.features.title" = "Características Técnicas";
"about.features.doubleRatchet.title" = "Protocolo Double Ratchet";
"about.features.doubleRatchet.desc" = "Cifrado de extremo a extremo basado en Double Ratchet con X3DH y AES-256-GCM. Cuando ambos dispositivos lo admiten, el acuerdo de claves ejecuta además una capa híbrida poscuántica (ML-KEM-768 combinado con X25519), de modo que el tráfico capturado hoy no será legible para un futuro ordenador cuántico.";
"about.features.mesh.title" = "Enrutamiento Mesh Multi-Salto";
"about.features.mesh.desc" = "Los mensajes se retransmiten a través de pares confiables para llegar a su destino, incluso sin conexión.";
"about.features.fallback.title" = "Respaldo Híbrido en la Nube";
"about.features.fallback.desc" = "Primero el mesh, sin ningún servidor. Si así no llega a tu contacto, el mensaje pasa por nuestro propio relé, que lo guarda cifrado y no puede leerlo.";
"about.features.identity.title" = "Identidad Criptográfica";
"about.features.identity.desc" = "Tu identidad es un par de claves Curve25519 generado en tu dispositivo. Nada que registrar, nada que confiscar.";
"about.features.ordering.title" = "Manejo Fuera de Orden";
"about.features.ordering.desc" = "Almacenamiento avanzado de mensajes maneja el caos de la red con gracia.";
"about.features.media.title" = "Multimedia Cifrada";
"about.features.media.desc" = "Envía fotos y videos con cifrado AES-256-GCM, descifrados solo por el destinatario.";
"about.features.qr.title" = "Emparejamiento por Código QR";
"about.features.qr.desc" = "Escanea para verificar y añadir contactos con números de seguridad criptográficos.";
"about.features.serverless.title" = "Arquitectura Sin Servidores";
"about.howItWorks.title" = "Cómo Funciona";
"about.howItWorks.step1.title" = "Genera Tu Identidad";
"about.howItWorks.step1.desc" = "Crea una identidad criptográfica que se convierte en tu identidad única y verificable.";
"about.howItWorks.step2.title" = "Conecta con Pares";
"about.howItWorks.step2.desc" = "Descubre dispositivos cercanos vía Bluetooth o WiFi mesh, o escanea códigos QR para añadir contactos confiables.";
"about.howItWorks.step3.title" = "Envía Mensajes Cifrados";
"about.howItWorks.step3.desc" = "Los mensajes se cifran con Double Ratchet y se envían directamente a pares o se retransmiten a través del mesh.";
"about.howItWorks.step4.title" = "Respaldo en la Nube";
"about.howItWorks.step4.desc" = "Si el mesh no llega a tu contacto, el mensaje cifrado se queda en nuestro propio servidor de relé hasta que se entrega. El relé no puede leerlo y nunca se publica en ninguna red pública.";
"about.howItWorks.step5.title" = "Claves que siguen cambiando";
"about.howItWorks.step5.desc" = "Cada mensaje recibe su propia clave, y la cadena avanza después de cada envío.";
"about.useCases.title" = "Construido Para";
"about.useCases.journalists.title" = "Periodistas";
"about.useCases.journalists.desc" = "Comunicación segura en ambientes hostiles";
"about.useCases.activists.title" = "Activistas";
"about.useCases.activists.desc" = "Organízate sin vigilancia o censura";
"about.useCases.emergency.title" = "Respuesta de Emergencia";
"about.useCases.emergency.desc" = "Coordina cuando falla la infraestructura";
"about.useCases.travelers.title" = "Viajeros";
"about.useCases.travelers.desc" = "Mantente conectado sin roaming o internet";
"about.useCases.privacy.title" = "Defensores de la Privacidad";
"about.useCases.privacy.desc" = "Comunícate sin intermediarios corporativos";
"about.useCases.crypto.title" = "Usuarios de Cripto";
"about.useCases.crypto.desc" = "Integración de identidad nativa para coordinación segura";
"about.openSource.title" = "Código Abierto y Transparencia";
"about.openSource.paragraph1" = "OSHI es **100% código abierto**, construido con transparencia y auditabilidad en su núcleo. Cada línea de código es pública y verificable.";
"about.openSource.paragraph2" = "Creemos que las herramientas de privacidad deben ser abiertas para ser confiables. Sin puertas traseras, sin telemetría oculta, sin algoritmos propietarios.";
"about.openSource.contribute" = "¡Las contribuciones de la comunidad son bienvenidas!";
"about.openSource.viewCode" = "Ver Código Fuente en GitHub";
"about.philosophy.title" = "Filosofía";
"about.philosophy.quote1" = "La comunicación es un derecho humano fundamental, no un producto para monetizar.";
"about.philosophy.quote2" = "La privacidad debe ser la opción predeterminada, no una característica premium.";
"about.philosophy.quote3" = "Nadie debería tener el poder de silenciar tu voz o leer tus pensamientos.";
"about.philosophy.quote4" = "La verdadera libertad requiere herramientas que no puedan ser controladas, censuradas o vigiladas.";

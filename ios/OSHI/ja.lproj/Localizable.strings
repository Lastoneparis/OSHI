/* About View */
"about.navigationTitle" = "このアプリについて";
"about.tagline" = "ソブリンメッセンジャー";
"about.tag.offline" = "オフライン";
"about.tag.secure" = "セキュア";
"about.tag.decentralized" = "分散型";
"about.vision.title" = "ビジョン";
"about.vision.paragraph1" = "OSHIは単なるメッセンジャーではなく、**デジタル自由のための通信プロトコル**です。主権、プライバシー、レジリエンスの原則に基づいて構築されています。";
"about.vision.paragraph2" = "相手が通信範囲内にいるときは、OSHI は**インターネットもサーバーも一切使わずに**動作し、Bluetooth/Wi-Fi の直接接続やマルチホップ中継を通じて**ピアツーピアのメッシュネットワーク**でメッセージを転送します。範囲内に誰もいない場合は、当社のリレーに切り替えてメッセージが届くようにします。";
"about.vision.paragraph3" = "すべてのメッセージは **X3DH** 鍵合意と **AES-256-GCM** を用いた **Double Ratchet** で保護されます。Signal と同じ構成であり、オフライン中継や順序が入れ替わった配信でもそのまま機能します。";
"about.principles.title" = "コア原則";
"about.principles.privacy.title" = "デフォルトでプライバシー";
"about.principles.privacy.desc" = "電話番号なし、メールアドレスなし、アカウントなし、トラッキングなし。メッシュ経由で送られたメッセージは、どのサーバーにも一切残りません。";
"about.principles.decentralization.title" = "分散化";
"about.principles.decentralization.desc" = "中央権限なし、単一障害点なし。パワーはネットワーク全体に分散されています。";
"about.principles.sovereignty.title" = "主権";
"about.principles.sovereignty.desc" = "あなたのID、データ、接続はあなたがコントロールします。企業なし、監視なし。";
"about.principles.resilience.title" = "レジリエンス";
"about.principles.resilience.desc" = "インターネット遮断、検閲、災害シナリオでも動作します。通信は止められません。";
"about.features.title" = "技術機能";
"about.features.doubleRatchet.title" = "ダブルラチェットプロトコル";
"about.features.doubleRatchet.desc" = "Double Ratchet に X3DH と AES-256-GCM を組み合わせたエンドツーエンド暗号化。両方の端末が対応している場合は、鍵合意でハイブリッドな耐量子計算機層（ML-KEM-768 と X25519 の組み合わせ）も実行されるため、今日記録された通信を将来の量子コンピュータが読むことはできません。";
"about.features.mesh.title" = "マルチホップメッシュルーティング";
"about.features.mesh.desc" = "メッセージはオフラインでも信頼できるピアを通じて目的地に中継されます。";
"about.features.fallback.title" = "ハイブリッドクラウドフォールバック";
"about.features.fallback.desc" = "まずメッシュで、サーバーは一切介しません。それで相手に届かない場合は、当方のリレーを経由します。リレーは暗号化したまま保管し、中身を読むことはできません。";
"about.features.identity.title" = "暗号化ID";
"about.features.identity.desc" = "あなたの識別情報は、端末上で生成される Curve25519 の鍵ペアです。登録するものも、押収されるものもありません。";
"about.features.ordering.title" = "順序外処理";

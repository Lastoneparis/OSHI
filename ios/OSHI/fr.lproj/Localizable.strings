   ============================================ */

"about.navigationTitle" = "À propos";
"about.tagline" = "La messagerie souveraine";
"about.tag.offline" = "Hors ligne";
"about.tag.secure" = "Sécurisé";
"about.tag.decentralized" = "Décentralisé";
"about.vision.title" = "La vision";
"about.vision.paragraph1" = "OSHI n'est pas qu'une messagerie — c'est un **protocole de communication pour la liberté numérique**. Construit sur des principes de souveraineté, de confidentialité et de résilience.";
"about.vision.paragraph2" = "Quand quelqu'un est à portée, OSHI fonctionne **sans aucun Internet et sans aucun serveur**, en acheminant les messages via un **réseau maillé pair-à-pair** par liaisons Bluetooth/Wi-Fi directes ou relais multi-sauts. Quand personne n'est à portée, il bascule sur notre relais pour que le message arrive quand même.";
"about.vision.paragraph3" = "Chaque message est protégé par le **Double Ratchet** avec l'accord de clés **X3DH** et **AES-256-GCM** — la même construction que celle utilisée par Signal — et cela tient aussi à travers les relais hors ligne et les livraisons dans le désordre.";
"about.principles.title" = "Principes fondamentaux";
"about.principles.privacy.title" = "Confidentialité par défaut";
"about.principles.privacy.desc" = "Pas de numéro de téléphone, pas d'e-mail, pas de compte, pas de suivi. Les messages envoyés par le réseau maillé ne laissent absolument rien sur aucun serveur.";
"about.principles.decentralization.title" = "Décentralisation";
"about.principles.decentralization.desc" = "Pas d'autorité centrale, pas de point de défaillance unique. Pouvoir distribué à travers le réseau.";
"about.principles.sovereignty.title" = "Souveraineté";
"about.principles.sovereignty.desc" = "Vous contrôlez votre identité, vos données et vos connexions. Pas d'entreprises, pas de surveillance.";
"about.principles.resilience.title" = "Résilience";
"about.principles.resilience.desc" = "Fonctionne en cas de panne d'Internet, de censure ou de catastrophe. La communication ne peut pas être arrêtée.";
"about.features.title" = "Caractéristiques techniques";
"about.features.doubleRatchet.title" = "Protocole Double Ratchet";
"about.features.doubleRatchet.desc" = "Chiffrement de bout en bout fondé sur Double Ratchet avec X3DH et AES-256-GCM. Lorsque les deux appareils le prennent en charge, l'accord de clés exécute en plus une couche hybride post-quantique (ML-KEM-768 combiné à X25519), afin que le trafic capté aujourd'hui ne soit pas lisible par un futur ordinateur quantique.";
"about.features.mesh.title" = "Routage maillé multi-sauts";
"about.features.mesh.desc" = "Les messages relaient à travers des pairs de confiance pour atteindre leur destination, même hors ligne.";
"about.features.fallback.title" = "Basculement cloud hybride";
"about.features.fallback.desc" = "Le maillage d'abord, sans aucun serveur. S'il n'atteint pas votre contact, le message passe par notre propre relais, qui le stocke chiffré et ne peut pas le lire.";
"about.features.identity.title" = "Identité cryptographique";
"about.features.identity.desc" = "Votre identité est une paire de clés Curve25519 générée sur votre appareil. Rien à enregistrer, rien à saisir.";
"about.features.ordering.title" = "Gestion des messages dans le désordre";
"about.features.ordering.desc" = "La mise en mémoire tampon avancée des messages gère le chaos du réseau avec élégance.";
"about.features.media.title" = "Médias chiffrés";
"about.features.media.desc" = "Envoyez des photos et des vidéos avec chiffrement AES-256-GCM, déchiffrables uniquement par le destinataire.";
"about.features.qr.title" = "Appairage par QR code";
"about.features.qr.desc" = "Scannez pour vérifier et ajouter des contacts avec des numéros de sécurité cryptographiques.";
"about.features.serverless.title" = "Architecture sans serveur";
"about.howItWorks.title" = "Comment ça marche";
"about.howItWorks.step1.title" = "Générez votre identité";
"about.howItWorks.step1.desc" = "Créez une identité cryptographique qui devient votre identité unique et vérifiable.";
"about.howItWorks.step2.title" = "Connectez-vous aux pairs";
"about.howItWorks.step2.desc" = "Découvrez les appareils à proximité via le maillage Bluetooth ou WiFi, ou scannez des QR codes pour ajouter des contacts de confiance.";
"about.howItWorks.step3.title" = "Envoyez des messages chiffrés";
"about.howItWorks.step3.desc" = "Les messages sont chiffrés avec Double Ratchet et envoyés directement aux pairs ou relayés à travers le maillage.";
"about.howItWorks.step4.title" = "Basculement vers le cloud";
"about.howItWorks.step4.desc" = "Si le maillage n'atteint pas votre contact, le message chiffré reste sur notre propre serveur relais jusqu'à sa remise. Le relais ne peut pas le lire, et il n'est jamais publié sur un réseau public.";
"about.howItWorks.step5.title" = "Des clés qui ne cessent de changer";
"about.howItWorks.step5.desc" = "Chaque message reçoit sa propre clé, et la chaîne avance après chaque envoi.";
"about.useCases.title" = "Conçu pour";
"about.useCases.journalists.title" = "Journalistes";
"about.useCases.journalists.desc" = "Communication sécurisée dans des environnements hostiles";
"about.useCases.activists.title" = "Activistes";
"about.useCases.activists.desc" = "S'organiser sans surveillance ni censure";
"about.useCases.emergency.title" = "Intervention d'urgence";
"about.useCases.emergency.desc" = "Coordonner lorsque l'infrastructure tombe en panne";
"about.useCases.travelers.title" = "Voyageurs";
"about.useCases.travelers.desc" = "Rester connecté sans itinérance ni Internet";
"about.useCases.privacy.title" = "Défenseurs de la vie privée";
"about.useCases.privacy.desc" = "Communiquer sans intermédiaires corporatifs";
"about.useCases.crypto.title" = "Utilisateurs de crypto";
"about.useCases.crypto.desc" = "Intégration d'identité native pour une coordination sécurisée";
"about.openSource.title" = "Open source et transparence";
"about.openSource.paragraph1" = "OSHI est **100% open source**, construit avec la transparence et l'auditabilité comme fondements. Chaque ligne de code est publique et vérifiable.";
"about.openSource.paragraph2" = "Nous croyons que les outils de confidentialité doivent être ouverts pour être dignes de confiance. Pas de portes dérobées, pas de télémétrie cachée, pas d'algorithmes propriétaires.";
"about.openSource.contribute" = "Les contributions de la communauté sont les bienvenues !";
"about.openSource.viewCode" = "Voir le code source sur GitHub";

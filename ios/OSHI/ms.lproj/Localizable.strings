   ============================================ */

"about.navigationTitle" = "Perihal";
"about.tagline" = "Pemesej Berdaulat";
"about.tag.offline" = "Luar Talian";
"about.tag.secure" = "Selamat";
"about.tag.decentralized" = "Ternyahpusat";
"about.vision.title" = "Visi";
"about.vision.paragraph1" = "OSHI bukan sekadar pemesej — ia adalah **protokol komunikasi untuk kebebasan digital**. Dibina atas prinsip kedaulatan, privasi dan daya tahan.";
"about.vision.paragraph2" = "Apabila ada orang dalam lingkungan, OSHI berfungsi **tanpa internet dan tanpa sebarang pelayan**, menghalakan mesej melalui **rangkaian mesh rakan-ke-rakan** menerusi sambungan Bluetooth/Wi-Fi terus atau geganti berbilang lompatan. Apabila tiada sesiapa dalam lingkungan, ia beralih kepada geganti kami supaya mesej tetap sampai.";
"about.vision.paragraph3" = "Setiap mesej dilindungi oleh **Double Ratchet** dengan persetujuan kunci **X3DH** dan **AES-256-GCM** — binaan yang sama seperti yang digunakan Signal — dan ia kekal merentasi geganti luar talian serta penghantaran tidak mengikut urutan.";
"about.principles.title" = "Prinsip Teras";
"about.principles.privacy.title" = "Privasi secara Lalai";
"about.principles.privacy.desc" = "Tiada nombor telefon, tiada e-mel, tiada akaun, tiada penjejakan. Mesej yang dihantar melalui rangkaian mesh tidak meninggalkan apa-apa pun pada mana-mana pelayan.";
"about.principles.decentralization.title" = "Penyahpusatan";
"about.principles.decentralization.desc" = "Tiada autoriti pusat, tiada titik kegagalan tunggal. Kuasa diagihkan merentas rangkaian.";
"about.principles.sovereignty.title" = "Kedaulatan";
"about.principles.sovereignty.desc" = "Anda mengawal identiti, data dan sambungan anda. Tiada syarikat, tiada pengawasan.";
"about.principles.resilience.title" = "Daya Tahan";
"about.principles.resilience.desc" = "Berfungsi dalam gelap gelita internet, penapisan atau senario bencana. Komunikasi tidak boleh dihentikan.";
"about.features.title" = "Ciri Teknikal";
"about.features.doubleRatchet.title" = "Protokol Double Ratchet";
"about.features.doubleRatchet.desc" = "Penyulitan hujung-ke-hujung yang dibina atas Double Ratchet dengan X3DH dan AES-256-GCM. Apabila kedua-dua peranti menyokongnya, persetujuan kunci turut menjalankan lapisan hibrid pasca-kuantum (ML-KEM-768 digabungkan dengan X25519), supaya trafik yang dirakam hari ini tidak boleh dibaca oleh komputer kuantum masa depan.";
"about.features.mesh.title" = "Penghalaan Mesh Berbilang Lompatan";
"about.features.mesh.desc" = "Mesej digeganti melalui rakan dipercayai untuk sampai ke destinasinya, walaupun luar talian.";
"about.features.fallback.title" = "Sandaran Awan Hibrid";
"about.features.fallback.desc" = "Mesh dahulu, tanpa sebarang pelayan. Jika cara itu tidak sampai kepada kenalan anda, mesej melalui relay milik kami sendiri, yang menyimpannya tersulit dan tidak boleh membacanya.";
"about.features.identity.title" = "Identiti Kriptografi";
"about.features.identity.desc" = "Identiti anda ialah pasangan kunci Curve25519 yang dijana pada peranti anda sendiri. Tiada apa untuk didaftarkan, tiada apa untuk dirampas.";
"about.features.ordering.title" = "Pengendalian Tidak Teratur";
"about.features.ordering.desc" = "Penimbalan mesej termaju mengendalikan kekacauan rangkaian dengan anggun.";
"about.features.media.title" = "Media Tersulit";
"about.features.media.desc" = "Hantar foto dan video dengan penyulitan AES-256-GCM, dinyahsulit hanya oleh penerima.";
"about.features.qr.title" = "Pemasangan Kod QR";
"about.features.qr.desc" = "Imbas untuk mengesahkan dan menambah kenalan dengan nombor keselamatan kriptografi.";
"about.features.serverless.title" = "Seni Bina Tanpa Pelayan";
"about.features.serverless.desc" = "Tiada akaun pengguna, tiada nombor telefon, tiada e-mel, tiada pengumpulan data, tiada penjejakan.";
"about.howItWorks.title" = "Cara Ia Berfungsi";
"about.howItWorks.step1.title" = "Jana Identiti Anda";
"about.howItWorks.step1.desc" = "Cipta identiti kriptografi yang menjadi identiti unik dan boleh disahkan anda.";
"about.howItWorks.step2.title" = "Sambung ke Rakan";
"about.howItWorks.step2.desc" = "Temui peranti berdekatan melalui mesh Bluetooth atau WiFi, atau imbas kod QR untuk menambah kenalan dipercayai.";
"about.howItWorks.step3.title" = "Hantar Mesej Tersulit";
"about.howItWorks.step3.desc" = "Mesej disulitkan dengan Double Ratchet dan dihantar terus ke rakan atau digeganti melalui mesh.";
"about.howItWorks.step4.title" = "Sandaran ke Awan";
"about.howItWorks.step4.desc" = "Jika mesh tidak dapat sampai kepada kenalan anda, mesej tersulit disimpan pada pelayan relay milik kami sendiri sehingga ia dihantar. Relay tidak boleh membacanya, dan ia tidak pernah diterbitkan ke mana-mana rangkaian awam.";
"about.howItWorks.step5.title" = "Kunci yang Sentiasa Berubah";
"about.howItWorks.step5.desc" = "Setiap mesej mendapat kuncinya sendiri, dan rantaian bergerak ke hadapan selepas setiap penghantaran.";
"about.useCases.title" = "Dibina Untuk";

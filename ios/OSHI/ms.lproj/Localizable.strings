"about.useCases.travelers.title" = "Pengembara";
"about.useCases.travelers.desc" = "Kekal berhubung tanpa perayauan atau internet";
"about.useCases.privacy.title" = "Penyokong Privasi";
"about.useCases.privacy.desc" = "Berkomunikasi tanpa perantara korporat";
"about.useCases.crypto.title" = "Pengguna Kripto";
"about.useCases.crypto.desc" = "Integrasi identiti asli untuk penyelarasan selamat";
"about.openSource.title" = "Sumber Terbuka & Ketelusan";
"about.openSource.paragraph1" = "OSHI adalah **100% sumber terbuka**, dibina dengan ketelusan dan kebolehauditan di terasnya. Setiap baris kod adalah awam dan boleh disahkan.";
"about.openSource.paragraph2" = "Kami percaya bahawa alat privasi mesti terbuka untuk dipercayai. Tiada pintu belakang, tiada telemetri tersembunyi, tiada algoritma proprietari.";
"about.openSource.contribute" = "Sumbangan komuniti dialu-alukan!";

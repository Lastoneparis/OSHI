"peers.info.what.title" = "Apakah Rangkaian Mesh?";
"peers.info.what.description" = "Rangkaian mesh membolehkan peranti anda berkomunikasi dengan peranti berdekatan tanpa internet. Mesej boleh melompat melalui beberapa peranti untuk sampai ke destinasinya.";
"peers.info.how.title" = "Cara Ia Berfungsi";
"peers.info.how.description" = "Peranti anda menggunakan Bluetooth dan WiFi Direct untuk menyambung dengan rakan berdekatan. Apabila anda menghantar mesej, ia boleh bergerak melalui rangkaian mesh untuk sampai ke penerima walaupun mereka tidak disambung terus kepada anda.";
"peers.info.control.title" = "Kawalan Sambungan Manual";
"peers.info.control.description" = "Ketik rakan yang disambung untuk memutuskan sambungan mereka sementara. Mereka tidak akan menyambung semula sehingga anda mengetiknya lagi atau membuka semula apl. Ini berguna jika anda mahu menggunakan pemesejan awan dan bukan mesh untuk rakan tertentu.";
"peers.info.privacy.title" = "Privasi & Keselamatan";
"peers.info.privacy.description" = "Apabila mesej melompat antara iPhone, peranti penggeganti hanya melihat data tersulit dan tidak boleh membacanya. Jambatan ke peranti Android dan ke radio Meshtastic LoRa tidak menambah penyulitan sendiri.";
"peers.info.range.title" = "Julat & Ketersambungan";
"peers.info.range.description" = "Bluetooth: ~30 kaki (10m)\nWiFi Direct: ~200 kaki (60m)\n\nSemakin banyak peranti dalam rangkaian, semakin jauh mesej anda boleh sampai!";
"peers.info.best_practices.title" = "Amalan Terbaik";
"peers.info.best_practices.description" = "• Pastikan kedua-dua 'Jadikan Boleh Ditemui' dan 'Temui Rakan' didayakan\n• Benarkan kebenaran Bluetooth dan Rangkaian Tempatan\n• Kekal dalam julat pengguna lain untuk hasil terbaik\n• Mesej secara automatik beralih ke awan apabila mesh tidak tersedia";


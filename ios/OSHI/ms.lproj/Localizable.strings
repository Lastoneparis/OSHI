/* Guide Step Titles */
"guide_welcome_title" = "Selamat datang ke OSHI!";
"guide_messages_tab_title" = "Mesej";
"guide_groups_tab_title" = "Kumpulan";
"guide_new_tab_title" = "Perbualan Baharu";

/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Sobre";
"about.tagline" = "O Mensageiro Soberano";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Seguro";
"about.tag.decentralized" = "Descentralizado";
"about.vision.title" = "A Visão";
"about.vision.paragraph1" = "OSHI não é apenas um mensageiro — é um **protocolo de comunicação para liberdade digital**. Construído sobre princípios de soberania, privacidade e resiliência.";
"about.vision.paragraph2" = "Quando alguém está ao alcance, o OSHI funciona **sem Internet e sem nenhum servidor**, roteando as mensagens por uma **rede em malha ponto a ponto** através de links Bluetooth/Wi-Fi diretos ou relés de múltiplos saltos. Quando não há ninguém ao alcance, ele recorre ao nosso relé para que a mensagem chegue mesmo assim.";
"about.vision.paragraph3" = "Cada mensagem é protegida pelo **Double Ratchet** com acordo de chaves **X3DH** e **AES-256-GCM** — a mesma construção que o Signal usa — e isso se mantém através de relés offline e entregas fora de ordem.";
"about.principles.title" = "Princípios Fundamentais";
"about.principles.privacy.title" = "Privacidade por Padrão";
"about.principles.privacy.desc" = "Sem número de telefone, sem e-mail, sem conta, sem rastreamento. Mensagens enviadas pela rede em malha não deixam absolutamente nada em nenhum servidor.";
"about.principles.decentralization.title" = "Descentralização";
"about.principles.decentralization.desc" = "Sem autoridade central, sem ponto único de falha. Poder distribuído pela rede.";
"about.principles.sovereignty.title" = "Soberania";
"about.principles.sovereignty.desc" = "Você controla sua identidade, seus dados e suas conexões. Sem corporações, sem vigilância.";
"about.principles.resilience.title" = "Resiliência";
"about.principles.resilience.desc" = "Funciona em apagões de internet, censura ou cenários de desastre. A comunicação não pode ser interrompida.";
"about.features.title" = "Recursos Técnicos";
"about.features.doubleRatchet.title" = "Protocolo Double Ratchet";
"about.features.doubleRatchet.desc" = "Criptografia de ponta a ponta baseada no Double Ratchet com X3DH e AES-256-GCM. Quando os dois aparelhos têm suporte, o acordo de chaves executa também uma camada híbrida pós-quântica (ML-KEM-768 combinado com X25519), de modo que o tráfego capturado hoje não será legível por um futuro computador quântico.";
"about.features.mesh.title" = "Roteamento em Malha Multi-Salto";
"about.features.mesh.desc" = "Mensagens retransmitem através de pares confiáveis para alcançar seu destino, mesmo offline.";
"about.features.fallback.title" = "Fallback Híbrido na Nuvem";
"about.features.fallback.desc" = "Primeiro a malha, sem servidor nenhum. Se assim não chegar ao seu contato, a mensagem passa pelo nosso próprio relay, que a guarda criptografada e não consegue lê-la.";
"about.features.identity.title" = "Identidade Criptográfica";
"about.features.identity.desc" = "Sua identidade é um par de chaves Curve25519 gerado no seu dispositivo. Nada para registrar, nada para apreender.";
"about.features.ordering.title" = "Tratamento Fora de Ordem";
"about.features.ordering.desc" = "Buffer avançado de mensagens lida com o caos da rede de forma elegante.";
"about.features.media.title" = "Mídia Criptografada";
"about.features.media.desc" = "Envie fotos e vídeos com criptografia AES-256-GCM, descriptografados apenas pelo destinatário.";
"about.features.qr.title" = "Emparelhamento por Código QR";
"about.features.qr.desc" = "Escaneie para verificar e adicionar contatos com números de segurança criptográficos.";
"about.features.serverless.title" = "Arquitetura Sem Servidor";
"about.howItWorks.title" = "Como Funciona";
"about.howItWorks.step1.title" = "Gere Sua Identidade";
"about.howItWorks.step1.desc" = "Crie uma identidade criptográfica que se torna sua identidade única e verificável.";
"about.howItWorks.step2.title" = "Conecte-se a Pares";
"about.howItWorks.step2.desc" = "Descubra dispositivos próximos via Bluetooth ou malha WiFi, ou escaneie códigos QR para adicionar contatos confiáveis.";
"about.howItWorks.step3.title" = "Envie Mensagens Criptografadas";
"about.howItWorks.step3.desc" = "Mensagens são criptografadas com Double Ratchet e enviadas diretamente para pares ou retransmitidas pela malha.";
"about.howItWorks.step4.title" = "Fallback para Nuvem";
"about.howItWorks.step4.desc" = "Se a malha não alcançar seu contato, a mensagem criptografada fica no nosso próprio servidor de relay até ser entregue. O relay não consegue lê-la, e ela nunca é publicada em nenhuma rede pública.";
"about.howItWorks.step5.title" = "Chaves que estão sempre mudando";
"about.howItWorks.step5.desc" = "Cada mensagem recebe sua própria chave, e a cadeia avança depois de cada envio.";
"about.useCases.title" = "Construído Para";
"about.useCases.journalists.title" = "Jornalistas";
"about.useCases.journalists.desc" = "Comunicação segura em ambientes hostis";
"about.useCases.activists.title" = "Ativistas";
"about.useCases.activists.desc" = "Organize sem vigilância ou censura";
"about.useCases.emergency.title" = "Resposta de Emergência";

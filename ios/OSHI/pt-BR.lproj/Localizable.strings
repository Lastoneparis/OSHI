"onboarding_disclaimer_audit_desc" = "Esta aplicação não foi submetida a uma auditoria de segurança profissional. Embora utilizemos encriptação forte, utilize-a por sua conta e risco.";
"onboarding_disclaimer_anonymous_title" = "Concebido para anonimato";
"onboarding_disclaimer_anonymous_desc" = "O OSHI é 100% concebido para anonimato total. Sem contas, sem números de telefone, sem rastreio. A sua identidade permanece sua.";
"onboarding_disclaimer_notifications_title" = "Notificações seguras";
"onboarding_disclaimer_notifications_desc" = "Por segurança, mensagens e chamadas só são recebidas quando o app está aberto. Em situações de crise (guerra, sequestro), se o celular estiver bloqueado ou o app protegido por senha, as notificações só chegam depois que o app fica aberto por 2+ segundos. Manter o app aberto também permite que seu celular retransmita mensagens para outras pessoas por perto.";
"onboarding_disclaimer_mesh_title" = "Tecnologia de rede mesh";
"onboarding_disclaimer_mesh_desc" = "Envie mensagens e faça chamadas sem internet, de celular para celular. Cerca de 100 m diretamente, e mais longe apenas quando outras pessoas por perto estão com o OSHI aberto para retransmitir. Os dois celulares precisam do app aberto.";
"onboarding_disclaimer_critical_title" = "Para situações críticas";
"onboarding_disclaimer_critical_desc" = "Concebido para cenários em que um país está desconectado da internet. Comunique livremente mesmo quando as redes estão em baixo.";
"onboarding_disclaimer_note" = "Suas mensagens e chamadas individuais são criptografadas de ponta a ponta. Nenhum número de telefone ou conta necessário.";
/* Guide Step Titles */
"guide_welcome_title" = "Bem-vindo ao OSHI!";
"guide_messages_tab_title" = "Mensagens";
"guide_groups_tab_title" = "Grupos";
"guide_new_tab_title" = "Nova Conversa";
"guide_settings_tab_title" = "Configurações e Identidade";
"guide_collaborative_title" = "Rede Colaborativa";
"guide_complete_title" = "Você Está Pronto!";

/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI é um mensageiro criptografado colaborativo. Sem internet, as mensagens saltam de celular em celular pelas pessoas por perto que estão com o OSHI aberto. Vamos mostrar tudo.";
"guide_messages_tab_desc" = "Suas conversas privadas aparecem aqui. Faça chamadas de voz criptografadas tocando em uma conversa. Mensagens e chamadas só chegam quando o app está aberto por 2+ segundos - isso é intencional para segurança.";
"guide_groups_tab_desc" = "Crie grupos privados ou entre em públicos próximos. Descubra grupos dentro do alcance do mesh, cerca de 100 m, e mais longe quando outros retransmitem. Mantenha o app aberto para detectar grupos ao seu redor!";
"guide_new_tab_desc" = "Inicie uma nova conversa aqui. Escaneie o código QR de um contato ou cole sua chave pública. Sem números de telefone, sem contas - apenas chaves criptográficas.";
"guide_settings_tab_desc" = "Sua identidade crypto está aqui. Compartilhe seu código QR ou chave pública para que outros possam te enviar mensagens. Você também pode ativar o bloqueio biométrico.";
"guide_collaborative_desc" = "OSHI é colaborativo: quando você mantém o app aberto, seu dispositivo ajuda a retransmitir mensagens para outras pessoas por perto. Em situações de crise (guerra, queda de internet), isso cria uma rede resiliente. Cada celular alcança cerca de 100 m, então quanto mais pessoas com o OSHI aberto, mais longe as mensagens podem viajar.";
"guide_complete_desc" = "Tudo pronto! Lembre-se: mantenha o OSHI aberto para receber mensagens e ajudar outros a se comunicar em emergências. Bem-vindo à rede!";


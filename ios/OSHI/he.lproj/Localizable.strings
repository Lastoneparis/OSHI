"about.features.fallback.desc" = "קודם mesh, בלי שום שרת. אם כך ההודעה לא מגיעה לאיש הקשר שלך, היא עוברת דרך הממסר שלנו, ששומר אותה מוצפנת ולא יכול לקרוא אותה.";
"about.features.identity.title" = "זהות קריפטוגרפית";

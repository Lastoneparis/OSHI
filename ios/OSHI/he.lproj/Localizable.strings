"about.tag.decentralized" = "מבוזר";
"about.vision.title" = "החזון";
"about.vision.paragraph1" = "OSHI הוא לא רק מסנג׳ר — זה **פרוטוקול תקשורת לחופש דיגיטלי**. בנוי על עקרונות של ריבונות, פרטיות וחוסן.";
"about.vision.paragraph2" = "כשמישהו נמצא בטווח, OSHI פועלת **בלי אינטרנט ובלי שום שרת**, ומנתבת הודעות ברשת **מש עמית-לעמית** דרך חיבורי Bluetooth/Wi-Fi ישירים או ממסרים מרובי-קפיצות. כשאף אחד לא נמצא בטווח, היא עוברת לממסר שלנו כדי שההודעה בכל זאת תגיע.";
"about.vision.paragraph3" = "כל הודעה מוגנת באמצעות **Double Ratchet** עם החלפת מפתחות **X3DH** והצפנת **AES-256-GCM** — אותה בנייה שבה משתמשת Signal — וזה מתקיים גם דרך ממסרים לא מקוונים ומסירה שלא לפי הסדר.";
"about.principles.title" = "עקרונות ליבה";
"about.principles.privacy.title" = "פרטיות כברירת מחדל";
"about.principles.privacy.desc" = "בלי מספר טלפון, בלי אימייל, בלי חשבון, בלי מעקב. הודעות שנשלחות ברשת המש לא משאירות שום דבר על אף שרת.";
"about.principles.decentralization.title" = "ביזור";
"about.principles.decentralization.desc" = "אין רשות מרכזית, אין נקודת כשל בודדת. כוח מופץ ברחבי הרשת.";
"about.principles.sovereignty.title" = "ריבונות";
"about.principles.sovereignty.desc" = "אתה שולט בזהות שלך, בנתונים שלך ובחיבורים שלך. ללא תאגידים, ללא מעקב.";
"about.principles.resilience.title" = "חוסן";
"about.principles.resilience.desc" = "עובד בהפסקות אינטרנט, צנזורה או תרחישי אסון. לא ניתן לעצור את התקשורת.";
"about.features.title" = "תכונות טכניות";
"about.features.doubleRatchet.title" = "פרוטוקול Double Ratchet";
"about.features.doubleRatchet.desc" = "הצפנה מקצה לקצה המבוססת על Double Ratchet עם X3DH ו-AES-256-GCM. כששני המכשירים תומכים בכך, הסכמת המפתחות מריצה גם שכבה היברידית פוסט-קוונטית (ML-KEM-768 בשילוב עם X25519), כך שתעבורה שנקלטת היום לא תהיה קריאה למחשב קוונטי עתידי.";
"about.features.mesh.title" = "ניתוב Mesh רב-קפיצה";

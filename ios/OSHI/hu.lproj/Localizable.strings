"about.navigationTitle" = "Névjegy";
"about.tagline" = "A szuverén üzenetküldő";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Biztonságos";
"about.tag.decentralized" = "Decentralizált";
"about.vision.title" = "A jövőkép";
"about.vision.paragraph1" = "Az OSHI nem csupán egy üzenetküldő — ez egy **kommunikációs protokoll a digitális szabadságért**. A szuverenitás, az adatvédelem és az ellenálló képesség elveire épül.";
"about.vision.paragraph2" = "Ha valaki hatótávolságon belül van, az OSHI **internet és bármiféle szerver nélkül** működik, és **peer-to-peer mesh hálózaton** továbbítja az üzeneteket közvetlen Bluetooth/Wi-Fi kapcsolatokon vagy több ugrásos továbbításokon keresztül. Ha senki sincs hatótávolságon belül, a saját továbbítónkra vált, hogy az üzenet így is megérkezzen.";
"about.vision.paragraph3" = "Minden üzenetet a **Double Ratchet** véd **X3DH** kulcsegyeztetéssel és **AES-256-GCM** titkosítással — ugyanaz a felépítés, amelyet a Signal is használ —, és ez offline továbbításnál és sorrenden kívüli kézbesítésnél is érvényes.";
"about.principles.title" = "Alapelvek";
"about.principles.privacy.title" = "Adatvédelem alapértelmezetten";
"about.principles.privacy.desc" = "Nincs telefonszám, nincs e-mail, nincs fiók, nincs nyomkövetés. A mesh hálózaton küldött üzenetek semmilyen szerveren nem hagynak semmit.";
"about.principles.decentralization.title" = "Decentralizáció";
"about.principles.decentralization.desc" = "Nincs központi hatóság, nincs egyetlen meghibásodási pont. A hatalom a hálózaton elosztva.";
"about.principles.sovereignty.title" = "Szuverenitás";
"about.principles.sovereignty.desc" = "Ön irányítja a személyazonosságát, az adatait és a kapcsolatait. Nincsenek vállalatok, nincs megfigyelés.";
"about.principles.resilience.title" = "Ellenálló képesség";
"about.principles.resilience.desc" = "Működik internetkimaradás, cenzúra vagy katasztrófahelyzetek esetén. A kommunikációt nem lehet megállítani.";
"about.features.title" = "Műszaki jellemzők";
"about.features.doubleRatchet.title" = "Double Ratchet protokoll";
"about.features.doubleRatchet.desc" = "Végponttól végpontig tartó titkosítás Double Ratchet alapon, X3DH-val és AES-256-GCM-mel. Ha mindkét eszköz támogatja, a kulcsegyeztetés egy hibrid posztkvantum réteget is lefuttat (ML-KEM-768 X25519-cel kombinálva), így a ma rögzített forgalmat egy jövőbeli kvantumszámítógép sem tudja elolvasni.";
"about.features.mesh.title" = "Többugrásos mesh-útválasztás";
"about.features.mesh.desc" = "Az üzenetek megbízható társakon keresztül továbbítódnak a célállomásukra, még offline is.";
"about.features.fallback.title" = "Hibrid felhőtartalék";
"about.features.fallback.desc" = "Először a mesh, szerver nélkül. Ha így nem éri el a partneredet, az üzenet a saját relénken halad át, amely titkosítva tárolja, és nem tudja elolvasni.";
"about.features.identity.title" = "Kriptográfiai személyazonosság";
"about.features.identity.desc" = "A személyazonosságod egy Curve25519 kulcspár, amely a saját eszközödön jön létre. Nincs mit regisztrálni, nincs mit lefoglalni.";
"about.features.ordering.title" = "Nem megfelelő sorrend kezelése";
"about.features.ordering.desc" = "A fejlett üzenetpufferelés elegánsan kezeli a hálózati káoszt.";
"about.features.media.title" = "Titkosított média";
"about.features.media.desc" = "Küldjön fényképeket és videókat AES-256-GCM titkosítással, amelyeket csak a címzett tud visszafejteni.";
"about.features.qr.title" = "QR-kódos párosítás";
"about.features.qr.desc" = "Olvassa be a névjegyek ellenőrzéséhez és hozzáadásához kriptográfiai biztonsági számokkal.";
"about.features.serverless.title" = "Szerver nélküli architektúra";
"about.features.serverless.desc" = "Nincsenek felhasználói fiókok, nincs telefonszám, nincs e-mail-cím, nincs adatgyűjtés, nincs nyomkövetés.";
"about.howItWorks.title" = "Hogyan működik";
"about.howItWorks.step1.title" = "Hozza létre a személyazonosságát";
"about.howItWorks.step1.desc" = "Hozzon létre egy kriptográfiai személyazonosságot, amely az Ön egyedi, ellenőrizhető személyazonosságává válik.";
"about.howItWorks.step2.title" = "Csatlakozzon társakhoz";
"about.howItWorks.step2.desc" = "Fedezzen fel közeli eszközöket Bluetooth- vagy Wi-Fi-mesh segítségével, vagy olvasson be QR-kódokat megbízható névjegyek hozzáadásához.";
"about.howItWorks.step3.title" = "Küldjön titkosított üzeneteket";
"about.howItWorks.step3.desc" = "Az üzeneteket Double Ratchet-tel titkosítjuk, és közvetlenül a társaknak küldjük, vagy a mesh-en keresztül továbbítjuk.";
"about.howItWorks.step4.title" = "Felhőtartalék";
"about.howItWorks.step4.desc" = "Ha a mesh nem éri el a partneredet, a titkosított üzenet a saját relészerverünkön vár a kézbesítésre. A relé nem tudja elolvasni, és soha nem kerül nyilvános hálózatra.";
"about.howItWorks.step5.title" = "Kulcsok, amelyek folyamatosan változnak";
"about.howItWorks.step5.desc" = "Minden üzenet saját kulcsot kap, és a lánc minden küldés után továbblép.";
"about.useCases.title" = "Kiknek készült";
"about.useCases.journalists.title" = "Újságírók";
"about.useCases.journalists.desc" = "Biztonságos kommunikáció ellenséges környezetben";
"about.useCases.activists.title" = "Aktivisták";
"about.useCases.activists.desc" = "Szervezkedés megfigyelés vagy cenzúra nélkül";
"about.useCases.emergency.title" = "Vészhelyzeti reagálás";
"about.useCases.emergency.desc" = "Koordináció, amikor az infrastruktúra meghibásodik";
"about.useCases.travelers.title" = "Utazók";
"about.useCases.travelers.desc" = "Maradjon kapcsolatban roaming vagy internet nélkül";
"about.useCases.privacy.title" = "Adatvédelmi szószólók";
"about.useCases.privacy.desc" = "Kommunikáció vállalati közvetítők nélkül";
"about.useCases.crypto.title" = "Kriptofelhasználók";
"about.useCases.crypto.desc" = "Natív személyazonosság-integráció a biztonságos koordinációhoz";
"about.openSource.title" = "Nyílt forráskód és átláthatóság";
"about.openSource.paragraph1" = "Az OSHI **100%-ban nyílt forráskódú**, az átláthatóság és az ellenőrizhetőség a lényege. A kód minden sora nyilvános és ellenőrizhető.";
"about.openSource.paragraph2" = "Úgy gondoljuk, hogy az adatvédelmi eszközöknek nyíltnak kell lenniük ahhoz, hogy megbízhatóak legyenek. Nincsenek hátsó kapuk, nincs rejtett telemetria, nincsenek szabadalmaztatott algoritmusok.";
"about.openSource.contribute" = "Szívesen fogadjuk a közösségi hozzájárulásokat!";
"about.openSource.viewCode" = "Forráskód megtekintése a GitHubon";
"about.philosophy.title" = "Filozófia";
"about.philosophy.quote1" = "A kommunikáció alapvető emberi jog, nem pénzzé teendő termék.";
"about.philosophy.quote2" = "Az adatvédelemnek alapértelmezettnek kell lennie, nem prémium funkciónak.";
"about.philosophy.quote3" = "Senkinek sem szabadna hatalommal rendelkeznie ahhoz, hogy elhallgattassa a hangját vagy olvassa a gondolatait.";
"about.philosophy.quote4" = "Az igazi szabadsághoz olyan eszközök kellenek, amelyeket nem lehet irányítani, cenzúrázni vagy megfigyelni.";

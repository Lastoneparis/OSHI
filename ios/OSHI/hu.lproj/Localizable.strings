"onboarding_disclaimer_mesh_title" = "Mesh-hálózati technológia";
"onboarding_disclaimer_mesh_desc" = "Küldjön üzeneteket és indítson hívásokat internet nélkül, telefonról telefonra. Közvetlenül körülbelül 100 m, és csak akkor messzebb, ha a közelben másoknál nyitva van az OSHI a relézéshez. Mindkét telefonon nyitva kell lennie az alkalmazásnak.";
"onboarding_disclaimer_critical_title" = "Kritikus helyzetekre";
"onboarding_disclaimer_critical_desc" = "Olyan helyzetekre tervezve, amikor egy ország le van választva az internetről. Kommunikáljon szabadon, még akkor is, amikor a hálózatok nem működnek.";

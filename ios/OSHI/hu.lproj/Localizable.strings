"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Bitcoin küldése csevegésben";
"guide.cashu.s1" = "Az OSHI-nak nincs tárcája, és soha nem tartja a pénzedet. Egy Cashu tokent szállít — bitcoinnal fedezett ecash-t —, ugyanúgy, ahogy egy fotót.";
"guide.cashu.s2" = "Először egy Cashu tárcára van szükséged. eNuts, Minibits vagy cashu.me a böngészőben: mind ingyenes, körülbelül egy perc alatt beállítható.";
"guide.cashu.s3" = "A tárcában válassz egy mintet, és tegyél rá egy kis pénzt Lightningon. Pár száz sat elég a kipróbáláshoz.";
"guide.cashu.s4" = "Készíts tokent: a tárcában koppints a Küldésre, adj meg egy összeget, majd másold ki. Egy hosszú, cashuB-vel kezdődő szövegsort kapsz. Ez a szöveg MAGA a pénz.";
"guide.cashu.s6" = "A másik fél a Beváltásra koppint, és a pénz az ő tárcájába kerül. A neked küldött token ugyanígy jelenik meg: koppints a Beváltásra. Az OSHI csak a boríték.";
"guide.cashu.s5" = "A csevegésben írj / a üzenetmezőbe, válaszd a /pay parancsot, és illeszd be a tokent. Az OSHI küldés előtt megmutatja az összeget, hogy ellenőrizhesd.";
"guide.cashu.sub" = "Cashu ecash — az OSHI soha nem tartja a pénzedet";
"guide.cashu.warning" = "A Cashu token készpénz. Aki megkapja a szöveget, elköltheti, és aki először beváltja, az tartja meg — ezért csak annak küldd el, akinek szántad. Az OSHI nem tudja megkérdezni a mintet, hogy a tokent elköltötték-e már: csak akkor lesz a tiéd, amikor a saját tárcád beváltja.";
"guide.cashu.learn_more" = "Mi az a Cashu?";

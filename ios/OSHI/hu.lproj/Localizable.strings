"info.mesh.title" = "Mesh-hálózat";
"info.mesh.section.about" = "NÉVJEGY";
"info.mesh.section.features" = "FUNKCIÓK";
"info.mesh.section.tips" = "TIPPEK";
"info.mesh.what_title" = "Mi az a mesh?";
"info.mesh.what_description" = "A mesh-hálózatkezelés közvetlen kapcsolatokat hoz létre a közeli eszközök között Bluetooth és Wi-Fi segítségével, lehetővé téve az üzenetek küldését internet nélkül.";
"info.mesh.range_title" = "Hatótávolság";
"info.mesh.range_description" = "A körülményektől függően körülbelül 30-100 méteren belüli eszközökhöz csatlakozik.";
"info.mesh.connection_title" = "Kapcsolat";
"info.mesh.connection_description" = "Az üzenetek a csatlakoztatott eszközök között ugranak, hogy elérjék a célállomásukat.";
"info.mesh.encryption_title" = "Biztonság";
"info.mesh.encryption_description" = "Az iPhone-ok között a meshen továbbított üzenetek végpontok között titkosítottak maradnak, így a relézést végző eszközök csak titkosított adatot látnak. Az Android-eszközök és a Meshtastic LoRa rádiók felé vezető híd nem ad hozzá saját titkosítást, ezért ezeket a kapcsolatokat ne tekintse magánjellegűnek.";
"info.mesh.tip1" = "Maradjon közel más OSHI-felhasználókhoz a legjobb kapcsolódás érdekében";
"info.mesh.tip2" = "Engedélyezze a Bluetooth-t és a Wi-Fi-t is az optimális hatótávolsághoz";
"info.mesh.tip3" = "Az iPhone-ok közötti relék csak titkosított adatot látnak; az Android- és LoRa-hidak nem titkosítanak";
"info.mesh.disclaimer_title" = "Mielőtt rá támaszkodna";
"info.mesh.disclaimer_description" = "Az offline mesh rövid hatótávú. Mindkét telefonon nyitva kell lennie az OSHI-nak, hogy megtalálják egymást, nyílt terepen körülbelül 100 m, falakon át sokkal kevesebb. Csak akkor jut messzebbre, ha a közelben mások is nyitva tartják az OSHI-t, és továbbadják az üzenetet. Ha senki sincs hatótávon belül, az OSHI interneten keresztül küldi el.";

/* About View - Additional */
"about.vision.paragraph1" = "OSHI सिर्फ एक मैसेंजर नहीं है — यह **डिजिटल स्वतंत्रता के लिए एक संचार प्रोटोकॉल** है। संप्रभुता, गोपनीयता और लचीलेपन के सिद्धांतों पर निर्मित।";
"about.vision.paragraph2" = "जब कोई पास हो, तो OSHI **बिना इंटरनेट और बिना किसी सर्वर के** काम करता है और संदेशों को सीधे Bluetooth/Wi-Fi लिंक या मल्टी-हॉप रिले के ज़रिए **पीयर-टू-पीयर मेश नेटवर्क** पर भेजता है। जब कोई पास न हो, तो यह हमारे रिले का सहारा लेता है ताकि संदेश फिर भी पहुँच जाए।";
"about.vision.paragraph3" = "हर संदेश **Double Ratchet** से सुरक्षित है, जिसमें **X3DH** कुंजी समझौता और **AES-256-GCM** शामिल है — वही संरचना जो Signal इस्तेमाल करता है — और यह ऑफ़लाइन रिले तथा क्रम से बाहर डिलीवरी में भी बना रहता है।";
"about.principles.decentralization.title" = "विकेंद्रीकरण";
"about.principles.decentralization.desc" = "कोई केंद्रीय प्राधिकरण नहीं, विफलता का कोई एकल बिंदु नहीं। नेटवर्क में शक्ति वितरित।";
"about.principles.resilience.title" = "लचीलापन";
"about.principles.resilience.desc" = "इंटरनेट ब्लैकआउट, सेंसरशिप, या आपदा परिदृश्यों में काम करता है। संचार को रोका नहीं जा सकता।";
"about.features.doubleRatchet.title" = "डबल रैचेट प्रोटोकॉल";
"about.features.doubleRatchet.desc" = "Double Ratchet पर आधारित एंड-टू-एंड एन्क्रिप्शन, X3DH और AES-256-GCM के साथ। जब दोनों डिवाइस इसका समर्थन करते हैं, तो कुंजी समझौते में एक हाइब्रिड पोस्ट-क्वांटम परत भी चलती है (ML-KEM-768 को X25519 के साथ मिलाकर), ताकि आज पकड़ा गया ट्रैफ़िक भविष्य के किसी क्वांटम कंप्यूटर से भी न पढ़ा जा सके।";
"about.features.mesh.title" = "मल्टी-हॉप मेश रूटिंग";
"about.features.mesh.desc" = "संदेश विश्वसनीय पीयर्स के माध्यम से अपने गंतव्य तक पहुंचते हैं, यहां तक कि ऑफलाइन भी।";
"about.features.fallback.title" = "हाइब्रिड क्लाउड फॉलबैक";
"about.features.fallback.desc" = "पहले मेश, बिना किसी सर्वर के। अगर इससे आपका संपर्क नहीं मिलता, तो संदेश हमारे अपने रिले से होकर जाता है, जो उसे एन्क्रिप्टेड रखता है और पढ़ नहीं सकता।";
"about.features.identity.title" = "क्रिप्टोग्राफिक पहचान";
"about.features.identity.desc" = "आपकी पहचान आपके डिवाइस पर बनी एक Curve25519 कुंजी-जोड़ी है। न कुछ पंजीकृत करने को, न कुछ ज़ब्त करने को।";
"about.features.ordering.title" = "आउट-ऑफ-ऑर्डर हैंडलिंग";
"about.features.ordering.desc" = "उन्नत संदेश बफरिंग नेटवर्क अराजकता को सुचारू रूप से संभालती है।";
"about.features.media.title" = "एन्क्रिप्टेड मीडिया";
"about.features.media.desc" = "AES-256-GCM एन्क्रिप्शन के साथ फोटो और वीडियो भेजें, केवल प्राप्तकर्ता द्वारा डिक्रिप्ट किया जा सकता है।";
"about.features.qr.title" = "QR कोड पेयरिंग";
"about.features.qr.desc" = "क्रिप्टोग्राफिक सुरक्षा संख्याओं के साथ संपर्कों को सत्यापित और जोड़ने के लिए स्कैन करें।";
"about.features.serverless.title" = "सर्वरलेस आर्किटेक्चर";
"about.features.serverless.desc" = "कोई उपयोगकर्ता खाता नहीं, कोई फ़ोन नंबर नहीं, कोई ईमेल नहीं, कोई डेटा संग्रह नहीं, कोई ट्रैकिंग नहीं।";
"about.howItWorks.title" = "यह कैसे काम करता है";
"about.howItWorks.step1.title" = "अपनी पहचान बनाएं";
"about.howItWorks.step1.desc" = "एक क्रिप्टोग्राफिक पहचान बनाएं जो आपकी अद्वितीय, सत्यापन योग्य पहचान बन जाती है।";
"about.howItWorks.step2.title" = "पीयर्स से कनेक्ट करें";
"about.howItWorks.step2.desc" = "ब्लूटूथ या WiFi मेश के माध्यम से पास के उपकरणों को खोजें, या विश्वसनीय संपर्क जोड़ने के लिए QR कोड स्कैन करें।";
"about.howItWorks.step3.title" = "एन्क्रिप्टेड संदेश भेजें";
"about.howItWorks.step3.desc" = "संदेश डबल रैचेट से एन्क्रिप्ट किए जाते हैं और सीधे पीयर्स को भेजे जाते हैं या मेश के माध्यम से रिले किए जाते हैं।";
"about.howItWorks.step4.title" = "क्लाउड में फॉलबैक";
"about.howItWorks.step4.desc" = "अगर मेश आपके संपर्क तक नहीं पहुँच पाता, तो एन्क्रिप्टेड संदेश डिलीवरी होने तक हमारे अपने रिले सर्वर पर रखा रहता है। रिले उसे पढ़ नहीं सकता, और वह कभी किसी सार्वजनिक नेटवर्क पर प्रकाशित नहीं होता।";
"about.howItWorks.step5.title" = "कुंजियाँ जो बदलती रहती हैं";
"about.howItWorks.step5.desc" = "हर संदेश को अपनी अलग कुंजी मिलती है, और हर बार भेजने के बाद शृंखला आगे बढ़ जाती है।";
"about.useCases.title" = "इनके लिए बनाया गया";

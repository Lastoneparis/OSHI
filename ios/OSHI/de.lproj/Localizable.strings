/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Über";
"about.tagline" = "Der souveräne Messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Sicher";
"about.tag.decentralized" = "Dezentral";
"about.vision.title" = "Die Vision";
"about.vision.paragraph1" = "OSHI ist nicht nur ein Messenger – es ist ein **Kommunikationsprotokoll für digitale Freiheit**. Aufgebaut auf den Prinzipien von Souveränität, Datenschutz und Resilienz.";
"about.vision.paragraph2" = "Wenn jemand in Reichweite ist, funktioniert OSHI **ganz ohne Internet und ohne jeden Server** und leitet Nachrichten über ein **Peer-to-Peer-Mesh-Netzwerk** per direkter Bluetooth/Wi-Fi-Verbindung oder über mehrere Zwischenstationen weiter. Ist niemand in Reichweite, greift es auf unser Relay zurück, damit die Nachricht trotzdem ankommt.";
"about.vision.paragraph3" = "Jede Nachricht wird durch den **Double Ratchet** mit **X3DH**-Schlüsselaustausch und **AES-256-GCM** geschützt — dieselbe Konstruktion, die auch Signal verwendet — und das gilt auch über Offline-Relays und bei Zustellung in falscher Reihenfolge.";
"about.principles.title" = "Kernprinzipien";
"about.principles.privacy.title" = "Datenschutz als Standard";
"about.principles.privacy.desc" = "Keine Telefonnummer, keine E-Mail-Adresse, kein Konto, kein Tracking. Über das Mesh gesendete Nachrichten hinterlassen auf keinem Server auch nur die geringste Spur.";
"about.principles.decentralization.title" = "Dezentralisierung";
"about.principles.decentralization.desc" = "Keine zentrale Autorität, kein einzelner Fehlerpunkt. Macht ist über das Netzwerk verteilt.";
"about.principles.sovereignty.title" = "Souveränität";
"about.principles.sovereignty.desc" = "Sie kontrollieren Ihre Identität, Ihre Daten und Ihre Verbindungen. Keine Unternehmen, keine Überwachung.";
"about.principles.resilience.title" = "Resilienz";
"about.principles.resilience.desc" = "Funktioniert bei Internet-Ausfällen, Zensur oder Katastrophenszenarien. Kommunikation kann nicht gestoppt werden.";
"about.features.title" = "Technische Merkmale";
"about.features.doubleRatchet.title" = "Double-Ratchet-Protokoll";
"about.features.doubleRatchet.desc" = "Ende-zu-Ende-Verschlüsselung auf Basis von Double Ratchet mit X3DH und AES-256-GCM. Wenn beide Geräte es unterstützen, läuft beim Schlüsselaustausch zusätzlich eine hybride Post-Quanten-Schicht (ML-KEM-768 kombiniert mit X25519), sodass heute mitgeschnittener Datenverkehr auch für einen künftigen Quantencomputer nicht lesbar ist.";
"about.features.mesh.title" = "Multi-Hop-Mesh-Routing";
"about.features.mesh.desc" = "Nachrichten werden über vertrauenswürdige Peers weitergeleitet, um ihr Ziel zu erreichen, auch offline.";
"about.features.fallback.title" = "Hybrid-Cloud-Fallback";
"about.features.fallback.desc" = "Zuerst das Mesh, ganz ohne Server. Erreicht es Ihren Kontakt nicht, läuft die Nachricht über unser eigenes Relay, das sie verschlüsselt speichert und nicht lesen kann.";
"about.features.identity.title" = "Kryptografische Identität";
"about.features.identity.desc" = "Ihre Identität ist ein Curve25519-Schlüsselpaar, das auf Ihrem Gerät erzeugt wird. Nichts zu registrieren, nichts zu beschlagnahmen.";
"about.features.ordering.title" = "Behandlung außer der Reihe";
"about.features.ordering.desc" = "Erweiterte Nachrichtenpufferung behandelt Netzwerkchaos elegant.";
"about.features.media.title" = "Verschlüsselte Medien";
"about.features.media.desc" = "Senden Sie Fotos und Videos mit AES-256-GCM-Verschlüsselung, die nur vom Empfänger entschlüsselt werden können.";
"about.features.qr.title" = "QR-Code-Pairing";
"about.features.qr.desc" = "Scannen, um Kontakte mit kryptografischen Sicherheitsnummern zu verifizieren und hinzuzufügen.";
"about.features.serverless.title" = "Serverlose Architektur";
"about.howItWorks.title" = "So funktioniert es";
"about.howItWorks.step1.title" = "Identität generieren";
"about.howItWorks.step1.desc" = "Erstellen Sie eine kryptografische Identität, die Ihre eindeutige, verifizierbare Identität wird.";
"about.howItWorks.step2.title" = "Mit Peers verbinden";
"about.howItWorks.step2.desc" = "Entdecken Sie Geräte in der Nähe über Bluetooth- oder WLAN-Mesh oder scannen Sie QR-Codes, um vertrauenswürdige Kontakte hinzuzufügen.";
"about.howItWorks.step3.title" = "Verschlüsselte Nachrichten senden";
"about.howItWorks.step3.desc" = "Nachrichten werden mit Double Ratchet verschlüsselt und direkt an Peers gesendet oder über das Mesh weitergeleitet.";
"about.howItWorks.step4.title" = "Fallback zur Cloud";
"about.howItWorks.step4.desc" = "Erreicht das Mesh Ihren Kontakt nicht, bleibt die verschlüsselte Nachricht auf unserem eigenen Relay-Server, bis sie zugestellt ist. Das Relay kann sie nicht lesen, und sie wird nie in einem öffentlichen Netzwerk veröffentlicht.";
"about.howItWorks.step5.title" = "Schlüssel, die ständig weiterwandern";
"about.howItWorks.step5.desc" = "Jede Nachricht erhält ihren eigenen Schlüssel, und die Kette rückt nach jedem Senden weiter.";
"about.useCases.title" = "Entwickelt für";
"about.useCases.journalists.title" = "Journalisten";
"about.useCases.journalists.desc" = "Sichere Kommunikation in feindlichen Umgebungen";
"about.useCases.activists.title" = "Aktivisten";
"about.useCases.activists.desc" = "Organisieren ohne Überwachung oder Zensur";
"about.useCases.emergency.title" = "Notfallreaktion";
"about.useCases.emergency.desc" = "Koordinieren, wenn die Infrastruktur ausfällt";
"about.useCases.travelers.title" = "Reisende";
"about.useCases.travelers.desc" = "Verbunden bleiben ohne Roaming oder Internet";
"about.useCases.privacy.title" = "Datenschutz-Befürworter";
"about.useCases.privacy.desc" = "Kommunizieren ohne Unternehmens-Vermittler";
"about.useCases.crypto.title" = "Krypto-Benutzer";
"about.useCases.crypto.desc" = "Native Identitätsintegration für sichere Koordination";
"about.openSource.title" = "Open Source & Transparenz";
"about.openSource.paragraph1" = "OSHI ist **100% Open Source**, mit Transparenz und Überprüfbarkeit im Kern. Jede Codezeile ist öffentlich und verifizierbar.";
"about.openSource.paragraph2" = "Wir glauben, dass Datenschutz-Tools offen sein müssen, um vertrauenswürdig zu sein. Keine Hintertüren, keine versteckte Telemetrie, keine proprietären Algorithmen.";
"about.openSource.contribute" = "Community-Beiträge sind willkommen!";
"about.openSource.viewCode" = "Quellcode auf GitHub anzeigen";
"about.philosophy.title" = "Philosophie";
"about.philosophy.quote1" = "Kommunikation ist ein grundlegendes Menschenrecht, kein zu monetarisierendes Produkt.";
"about.philosophy.quote2" = "Datenschutz sollte der Standard sein, kein Premium-Feature.";
"about.philosophy.quote3" = "Niemand sollte die Macht haben, Ihre Stimme zum Schweigen zu bringen oder Ihre Gedanken zu lesen.";
"about.philosophy.quote4" = "Wahre Freiheit erfordert Werkzeuge, die nicht kontrolliert, zensiert oder überwacht werden können.";

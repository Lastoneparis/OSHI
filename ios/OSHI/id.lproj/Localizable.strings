"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Kirim bitcoin di obrolan";
"guide.cashu.s1" = "OSHI tidak punya dompet dan tidak pernah menyimpan uang Anda. Ia membawa token Cashu — ecash yang dijamin bitcoin — sebagaimana ia membawa sebuah foto.";
"guide.cashu.s2" = "Anda perlu dompet Cashu terlebih dahulu. eNuts, Minibits, atau cashu.me di peramban: semuanya gratis dan siap dalam sekitar satu menit.";
"guide.cashu.s3" = "Di dompet, pilih sebuah mint dan isi sedikit uang melalui Lightning. Beberapa ratus sat sudah cukup untuk mencoba.";
"guide.cashu.s4" = "Buat token: di dompet ketuk Kirim, masukkan jumlah, lalu salin. Anda mendapat satu baris teks panjang yang dimulai dengan cashuB. Teks itulah uangnya.";
"guide.cashu.s6" = "Penerima mengetuk Tukarkan dan uangnya masuk ke dompet mereka. Token yang dikirim kepada Anda tampak sama: ketuk Tukarkan. OSHI hanyalah amplopnya.";
"guide.cashu.s5" = "Di obrolan, ketik / pada kotak pesan, pilih /pay, lalu tempel tokennya. OSHI menampilkan jumlahnya sebelum mengirim agar Anda bisa memeriksanya.";
"guide.cashu.sub" = "Ecash Cashu — OSHI tidak pernah menyimpan uang Anda";
"guide.cashu.warning" = "Token Cashu adalah uang tunai. Siapa pun yang mendapat teksnya bisa membelanjakannya, dan siapa yang menukarkan lebih dulu akan memilikinya — jadi kirimkan hanya kepada orang yang Anda maksud. OSHI tidak bisa menanyakan ke mint apakah sebuah token sudah dibelanjakan: ia baru milik Anda setelah dompet Anda sendiri menukarkannya.";

/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Tentang";
"about.tagline" = "Messenger Berdaulat";
"about.tag.offline" = "Luring";
"about.tag.secure" = "Aman";
"about.tag.decentralized" = "Terdesentralisasi";
"about.vision.title" = "Visi";
"about.vision.paragraph1" = "OSHI bukan sekadar messenger — ini adalah **protokol komunikasi untuk kebebasan digital**. Dibangun di atas prinsip kedaulatan, privasi, dan ketahanan.";
"about.vision.paragraph2" = "Ketika ada orang dalam jangkauan, OSHI bekerja **tanpa internet dan tanpa server sama sekali**, merutekan pesan melalui **jaringan mesh peer-to-peer** lewat koneksi Bluetooth/Wi-Fi langsung atau relai multi-lompatan. Ketika tidak ada siapa pun dalam jangkauan, aplikasi beralih ke relai kami agar pesan tetap sampai.";
"about.vision.paragraph3" = "Setiap pesan dilindungi oleh **Double Ratchet** dengan kesepakatan kunci **X3DH** dan **AES-256-GCM** — konstruksi yang sama seperti yang dipakai Signal — dan itu tetap berlaku melalui relai luring maupun pengiriman yang tidak berurutan.";
"about.principles.title" = "Prinsip Inti";
"about.principles.privacy.title" = "Privasi secara Default";
"about.principles.privacy.desc" = "Tanpa nomor telepon, tanpa email, tanpa akun, tanpa pelacakan. Pesan yang dikirim lewat jaringan mesh tidak meninggalkan apa pun di server mana pun.";
"about.principles.decentralization.title" = "Desentralisasi";
"about.principles.decentralization.desc" = "Tanpa otoritas pusat, tanpa titik kegagalan tunggal. Kekuatan terdistribusi di seluruh jaringan.";
"about.principles.sovereignty.title" = "Kedaulatan";
"about.principles.sovereignty.desc" = "Anda mengontrol identitas, data, dan koneksi Anda. Tanpa korporasi, tanpa pengawasan.";
"about.principles.resilience.title" = "Ketahanan";
"about.principles.resilience.desc" = "Berfungsi saat pemadaman internet, sensor, atau skenario bencana. Komunikasi tidak dapat dihentikan.";
"about.features.title" = "Fitur Teknis";
"about.features.doubleRatchet.title" = "Protokol Double Ratchet";
"about.features.doubleRatchet.desc" = "Enkripsi ujung-ke-ujung yang dibangun di atas Double Ratchet dengan X3DH dan AES-256-GCM. Bila kedua perangkat mendukungnya, kesepakatan kunci juga menjalankan lapisan hibrida pascakuantum (ML-KEM-768 dikombinasikan dengan X25519), sehingga lalu lintas yang direkam hari ini tidak terbaca oleh komputer kuantum di masa depan.";
"about.features.mesh.title" = "Perutean Mesh Multi-Hop";
"about.features.mesh.desc" = "Pesan direlay melalui peer tepercaya untuk mencapai tujuannya, bahkan offline.";
"about.features.fallback.title" = "Fallback Cloud Hibrida";
"about.features.fallback.desc" = "Mesh lebih dulu, tanpa server sama sekali. Jika cara itu tidak menjangkau kontak Anda, pesan melewati relay milik kami sendiri, yang menyimpannya terenkripsi dan tidak bisa membacanya.";
"about.features.identity.title" = "Identitas Kriptografis";
"about.features.identity.desc" = "Identitas Anda adalah pasangan kunci Curve25519 yang dibuat di perangkat Anda sendiri. Tidak ada yang perlu didaftarkan, tidak ada yang bisa disita.";
"about.features.ordering.title" = "Penanganan Tidak Berurutan";
"about.features.ordering.desc" = "Buffering pesan tingkat lanjut menangani kekacauan jaringan dengan mulus.";
"about.features.media.title" = "Media Terenkripsi";
"about.features.media.desc" = "Kirim foto dan video dengan enkripsi AES-256-GCM, hanya didekripsi oleh penerima.";
"about.features.qr.title" = "Pemasangan Kode QR";
"about.features.qr.desc" = "Pindai untuk memverifikasi dan menambahkan kontak dengan nomor keamanan kriptografis.";
"about.features.serverless.title" = "Arsitektur Tanpa Server";

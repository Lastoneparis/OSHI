"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Poslat bitcoin v chatu";
"guide.cashu.s1" = "OSHI nemá peněženku a nikdy nedrží vaše peníze. Přenáší token Cashu — ecash krytý bitcoinem — stejně jako přenáší fotku.";
"guide.cashu.s2" = "Nejdřív potřebujete peněženku Cashu. eNuts, Minibits nebo cashu.me v prohlížeči: všechny jsou zdarma a nastavíte je asi za minutu.";
"guide.cashu.s3" = "V peněžence vyberte mint a nahrajte trochu peněz přes Lightning. Pár stovek satoshi na vyzkoušení stačí.";
"guide.cashu.s4" = "Vytvořte token: v peněžence stiskněte Poslat, zadejte částku a zkopírujte. Dostanete dlouhou řádku textu začínající cashuB. Ten text JSOU ty peníze.";
"guide.cashu.s6" = "Druhý člověk stiskne Vyplatit a peníze mu přijdou do peněženky. Token poslaný vám vypadá stejně: stiskněte Vyplatit. OSHI je jen obálka.";
"guide.cashu.s5" = "V chatu napište / do pole zprávy, vyberte /pay a vložte token. OSHI před odesláním zobrazí částku, abyste si ji mohli zkontrolovat.";
"guide.cashu.sub" = "Cashu ecash — OSHI nikdy nedrží vaše peníze";
"guide.cashu.warning" = "Token Cashu jsou hotové peníze. Kdokoli získá ten text, může ho utratit, a kdo ho vyplatí první, ten si ho nechá — posílejte ho tedy jen tomu, komu chcete. OSHI se nemůže mintu zeptat, jestli už byl token utracen: je váš teprve ve chvíli, kdy ho vyplatí vaše vlastní peněženka.";

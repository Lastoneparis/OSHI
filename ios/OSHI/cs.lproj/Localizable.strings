   ============================================ */

"about.navigationTitle" = "O aplikaci";
"about.tagline" = "Suverénní Messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Bezpečné";
"about.tag.decentralized" = "Decentralizované";
"about.vision.title" = "Vize";
"about.vision.paragraph1" = "OSHI není jen messenger — je to **komunikační protokol pro digitální svobodu**. Postavený na principech suverenity, soukromí a odolnosti.";
"about.vision.paragraph2" = "Když je někdo v dosahu, OSHI funguje **zcela bez internetu a bez jakéhokoli serveru** a směruje zprávy přes **peer-to-peer mesh síť** pomocí přímých spojení Bluetooth/Wi-Fi nebo víceskokových přenosů. Když není nikdo v dosahu, přepne se na náš relay, aby zpráva přesto dorazila.";
"about.vision.paragraph3" = "Každá zpráva je chráněna protokolem **Double Ratchet** s výměnou klíčů **X3DH** a šifrováním **AES-256-GCM** — stejnou konstrukcí, jakou používá Signal — a platí to i napříč offline přenosy a doručením mimo pořadí.";
"about.principles.title" = "Základní principy";
"about.principles.privacy.title" = "Soukromí jako výchozí";
"about.principles.privacy.desc" = "Žádné telefonní číslo, žádný e-mail, žádný účet, žádné sledování. Zprávy odeslané přes mesh síť nezanechají na žádném serveru vůbec nic.";
"about.principles.decentralization.title" = "Decentralizace";
"about.principles.decentralization.desc" = "Žádná centrální autorita, žádný jediný bod selhání. Moc rozdělená napříč sítí.";
"about.principles.sovereignty.title" = "Suverenita";
"about.principles.sovereignty.desc" = "Ovládáte svou identitu, svá data a svá spojení. Žádné korporace, žádný dohled.";
"about.principles.resilience.title" = "Odolnost";
"about.principles.resilience.desc" = "Funguje při výpadcích internetu, cenzuře nebo katastrofách. Komunikaci nelze zastavit.";
"about.features.title" = "Technické funkce";
"about.features.doubleRatchet.title" = "Protokol Double Ratchet";
"about.features.doubleRatchet.desc" = "Koncové šifrování postavené na Double Ratchet s X3DH a AES-256-GCM. Pokud to podporují obě zařízení, provede se při dohodě klíčů navíc hybridní postkvantová vrstva (ML-KEM-768 v kombinaci s X25519), takže dnes zachycený provoz nebude čitelný ani pro budoucí kvantový počítač.";
"about.features.mesh.title" = "Víceskokové mesh směrování";
"about.features.mesh.desc" = "Zprávy se přenášejí přes důvěryhodné uzly, aby dosáhly cíle, i offline.";
"about.features.fallback.title" = "Hybridní cloudová záloha";
"about.features.fallback.desc" = "Nejdřív mesh, zcela bez serveru. Pokud takto vašeho kontaktu nedosáhne, zpráva projde naším vlastním relayem, který ji uloží zašifrovanou a nedokáže ji přečíst.";
"about.features.identity.title" = "Kryptografická identita";
"about.features.identity.desc" = "Vaše identita je pár klíčů Curve25519 vygenerovaný přímo ve vašem zařízení. Není co registrovat, není co zabavit.";
"about.features.ordering.title" = "Zpracování mimo pořadí";
"about.features.ordering.desc" = "Pokročilé bufferování zpráv elegantně zvládá síťový chaos.";
"about.features.media.title" = "Šifrovaná média";
"about.features.media.desc" = "Posílejte fotky a videa se šifrováním AES-256-GCM, dešifrované pouze příjemcem.";
"about.features.qr.title" = "Párování QR kódem";
"about.features.qr.desc" = "Skenujte pro ověření a přidání kontaktů s kryptografickými bezpečnostními čísly.";
"about.features.serverless.title" = "Architektura bez serverů";
"about.features.serverless.desc" = "Žádné uživatelské účty, žádné telefonní číslo, žádný e-mail, žádný sběr dat, žádné sledování.";
"about.howItWorks.title" = "Jak to funguje";
"about.howItWorks.step1.title" = "Vygenerujte svou identitu";
"about.howItWorks.step1.desc" = "Vytvořte kryptografickou identitu, která se stane vaší jedinečnou, ověřitelnou identitou.";
"about.howItWorks.step2.title" = "Připojte se k uzlům";
"about.howItWorks.step2.desc" = "Objevujte zařízení v okolí přes Bluetooth nebo WiFi mesh, nebo skenujte QR kódy pro přidání důvěryhodných kontaktů.";
"about.howItWorks.step3.title" = "Posílejte šifrované zprávy";
"about.howItWorks.step3.desc" = "Zprávy jsou šifrovány pomocí Double Ratchet a odesílány přímo uzlům nebo přenášeny přes mesh.";
"about.howItWorks.step4.title" = "Záloha do cloudu";
"about.howItWorks.step4.desc" = "Pokud mesh vašeho kontaktu nedosáhne, zašifrovaná zpráva zůstane na našem vlastním relay serveru, dokud není doručena. Relay ji nedokáže přečíst a nikdy se nezveřejňuje v žádné veřejné síti.";
"about.howItWorks.step5.title" = "Klíče, které se stále mění";
"about.howItWorks.step5.desc" = "Každá zpráva dostane vlastní klíč a řetěz se po každém odeslání posune dál.";
"about.useCases.title" = "Vytvořeno pro";
"about.useCases.journalists.title" = "Novináři";
"about.useCases.journalists.desc" = "Bezpečná komunikace v nepřátelském prostředí";
"about.useCases.activists.title" = "Aktivisté";
"about.useCases.activists.desc" = "Organizujte bez dohledu nebo cenzury";
"about.useCases.emergency.title" = "Reakce na mimořádné události";
"about.useCases.emergency.desc" = "Koordinujte, když selže infrastruktura";
"about.useCases.travelers.title" = "Cestovatelé";
"about.useCases.travelers.desc" = "Zůstaňte ve spojení bez roamingu nebo internetu";
"about.useCases.privacy.title" = "Zastánci soukromí";
"about.useCases.privacy.desc" = "Komunikujte bez korporátních prostředníků";
"about.useCases.crypto.title" = "Uživatelé kryptoměn";
"about.useCases.crypto.desc" = "Nativní integrace identity pro bezpečnou koordinaci";
"about.openSource.title" = "Otevřený zdroj a transparentnost";
"about.openSource.paragraph1" = "OSHI je **100% open source**, postavený s transparentností a auditovatelností v jádru. Každý řádek kódu je veřejný a ověřitelný.";
"about.openSource.paragraph2" = "Věříme, že nástroje na ochranu soukromí musí být otevřené, aby si zasloužily důvěru. Žádná zadní vrátka, žádná skrytá telemetrie, žádné proprietární algoritmy.";
"about.openSource.contribute" = "Příspěvky komunity jsou vítány!";
"about.openSource.viewCode" = "Zobrazit zdrojový kód na GitHubu";
"about.philosophy.title" = "Filozofie";
"about.philosophy.quote1" = "Komunikace je základní lidské právo, ne produkt k monetizaci.";
"about.philosophy.quote2" = "Soukromí by mělo být výchozí, ne prémiová funkce.";
"about.philosophy.quote3" = "Nikdo by neměl mít moc umlčet váš hlas nebo číst vaše myšlenky.";
"about.philosophy.quote4" = "Skutečná svoboda vyžaduje nástroje, které nelze ovládat, cenzurovat ani sledovat.";
"about.techStack.title" = "Technologický stack";

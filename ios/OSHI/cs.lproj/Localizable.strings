/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI je společný šifrovaný messenger. Bez internetu zprávy skáčou z telefonu na telefon přes lidi v okolí, kteří mají OSHI otevřené. Pojďme vám to ukázat.";
"guide_messages_tab_desc" = "Vaše soukromé konverzace se zobrazují zde. Šifrované hlasové hovory uskutečníte klepnutím na libovolnou konverzaci. Zprávy a hovory dorazí pouze tehdy, když je aplikace otevřená 2+ sekundy – to je z bezpečnostních důvodů.";
"guide_groups_tab_desc" = "Vytvářejte soukromé skupiny nebo se připojte k veřejným v okolí. Objevujte skupiny v dosahu mesh, přibližně 100 m, a dál, když ostatní přenášejí. Mějte aplikaci otevřenou pro detekci skupin kolem vás!";
"guide_new_tab_desc" = "Zde zahajte novou konverzaci. Naskenujte QR kód kontaktu nebo vložte jeho veřejný klíč. Žádná telefonní čísla, žádné účty – jen kryptografické klíče.";
"guide_settings_tab_desc" = "Zde žije vaše krypto identita. Sdílejte svůj QR kód nebo veřejný klíč s ostatními, aby vám mohli psát. Můžete také povolit biometrický zámek pro extra zabezpečení.";
"guide_collaborative_desc" = "OSHI je společné: když máte aplikaci otevřenou, vaše zařízení pomáhá přenášet zprávy pro ostatní lidi v okolí. V krizových situacích (válka, výpadek internetu) to vytváří odolnou síť. Každý telefon dosáhne asi 100 m, takže čím více lidí má OSHI otevřené, tím dále mohou zprávy cestovat.";
"guide_complete_desc" = "Vše je připraveno! Pamatujte: mějte OSHI otevřené pro příjem zpráv a pomáhejte ostatním komunikovat v nouzových situacích. Vítejte v síti!";


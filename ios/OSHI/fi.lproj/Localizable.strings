"peers.row.connected" = "Yhdistetty";
"peers.row.tap_connect" = "Napauta yhdistääksesi";
"peers.info.title" = "Mesh-verkko";
"peers.info.header" = "Mesh-verkostoituminen";
"peers.info.what.title" = "Mitä on mesh-verkostoituminen?";
"peers.info.what.description" = "Mesh-verkostoituminen mahdollistaa laitteesi viestinnän lähellä olevien laitteiden kanssa ilman internetiä. Viestit voivat hypätä useiden laitteiden kautta määränpäähänsä.";
"peers.info.how.title" = "Miten se toimii";
"peers.info.how.description" = "Laitteesi käyttää Bluetoothia ja WiFi Directiä yhdistääkseen lähellä oleviin vertaisiin. Kun lähetät viestin, se voi kulkea mesh-verkon läpi tavoittaakseen vastaanottajan, vaikka tämä ei olisi suoraan yhteydessä sinuun.";
"peers.info.control.title" = "Manuaalinen yhteyshallinta";
"peers.info.control.description" = "Napauta yhdistettyä vertaista katkaistaksesi sen yhteyden tilapäisesti. Ne eivät yhdisty uudelleen ennen kuin napautat niitä uudelleen tai avaat sovelluksen uudelleen. Tämä on hyödyllistä, jos haluat käyttää pilviviestintää meshin sijaan tietyn vertaisen kanssa.";
"peers.info.privacy.title" = "Yksityisyys ja turvallisuus";
"peers.info.privacy.description" = "Kun viesti hyppää iPhone-laitteiden välillä, sitä välittävät laitteet näkevät vain salattua tekstiä eivätkä voi lukea sitä. Silta Android-laitteisiin ja Meshtastic LoRa -radioihin ei lisää omaa salausta.";
"peers.info.range.title" = "Kantama ja yhteydet";
"peers.info.range.description" = "Bluetooth: ~30 jalkaa (10 m)\nWiFi Direct: ~200 jalkaa (60 m)\n\nMitä enemmän laitteita verkossa on, sitä kauemmaksi viestisi voivat ulottua!";
"peers.info.best_practices.title" = "Parhaat käytännöt";
"peers.info.best_practices.description" = "• Pidä sekä 'Tee löydettäväksi' että 'Löydä vertaisia' käytössä\n• Salli Bluetooth- ja paikallisverkon käyttöoikeudet\n• Pysy muiden käyttäjien kantaman sisällä parhaiden tulosten saamiseksi\n• Viestit siirtyvät automaattisesti pilveen, kun mesh ei ole käytettävissä";


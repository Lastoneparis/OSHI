"peers.section.disconnected" = "Manuaalisesti katkaistut";
"peers.disconnected.tap_reconnect" = "Napauta yhdistääksesi uudelleen";
"peers.disconnected.footer" = "Nämä vertaiset on tilapäisesti katkaistu. Napauta yhdistääksesi uudelleen tai avaa sovellus uudelleen yhdistääksesi automaattisesti.";

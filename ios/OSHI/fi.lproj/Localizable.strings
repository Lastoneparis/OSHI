"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Lähetä bitcoinia keskustelussa";
"guide.cashu.s1" = "OSHI:lla ei ole lompakkoa eikä se koskaan säilytä rahojasi. Se kuljettaa Cashu-tokenin — bitcoinilla katetun ecashin — samalla tavalla kuin se kuljettaa valokuvan.";
"guide.cashu.s2" = "Tarvitset ensin Cashu-lompakon. eNuts, Minibits tai cashu.me selaimessa: kaikki ilmaisia ja käyttövalmiita noin minuutissa.";
"guide.cashu.s3" = "Valitse lompakossa mint ja lisää vähän rahaa Lightningin kautta. Pari sataa satia riittää hyvin kokeiluun.";
"guide.cashu.s4" = "Luo token: paina lompakossa Lähetä, anna summa ja kopioi. Saat pitkän tekstirivin, joka alkaa cashuB. Se teksti ON ne rahat.";
"guide.cashu.s6" = "Vastaanottaja painaa Lunasta, ja rahat päätyvät hänen lompakkoonsa. Sinulle lähetetty token näyttää samalta: paina Lunasta. OSHI on vain kirjekuori.";
"guide.cashu.s5" = "Kirjoita keskustelussa / viestikenttään, valitse /pay ja liitä token. OSHI näyttää summan ennen lähetystä, jotta voit tarkistaa sen.";
"guide.cashu.sub" = "Cashu-ecash — OSHI ei koskaan säilytä rahojasi";
"guide.cashu.warning" = "Cashu-token on käteistä. Kuka tahansa tekstin saava voi käyttää sen, ja ensimmäisenä lunastava saa pitää sen — lähetä se siis vain sille henkilölle, jolle tarkoitat. OSHI ei voi kysyä mintiltä, onko token jo käytetty: se on sinun vasta, kun oma lompakkosi lunastaa sen.";

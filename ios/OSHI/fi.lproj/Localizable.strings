"peers.nearby.footer" = "Napauta yhdistääksesi lähellä olevaan vertaiseen";
"peers.section.settings" = "Verkkoasetukset";
"peers.settings.discoverable" = "Tee löydettäväksi";
"peers.settings.discover" = "Löydä vertaisia";
"peers.settings.footer" = "Molemmat asetukset tulisi ottaa käyttöön optimaalista mesh-verkkoa varten";

"about.vision.paragraph1" = "OSHI ei ole vain viestiohjelma — se on **viestintäprotokolla digitaaliselle vapaudelle**. Rakennettu suvereniteetin, yksityisyyden ja kestävyyden periaatteille.";
"about.vision.paragraph2" = "Kun joku on kantaman sisällä, OSHI toimii **täysin ilman internetiä ja ilman mitään palvelinta** ja reitittää viestit **vertaisverkkona toimivassa mesh-verkossa** suorilla Bluetooth/Wi-Fi-yhteyksillä tai monihyppyisten välitysten kautta. Kun kukaan ei ole kantaman sisällä, se turvautuu omaan välityspalvelimeemme, jotta viesti menee silti perille.";
"about.vision.paragraph3" = "Jokainen viesti on suojattu **Double Ratchet** -protokollalla, **X3DH**-avaintenvaihdolla ja **AES-256-GCM**-salauksella — sama rakenne, jota Signal käyttää — ja se pätee myös offline-välitysten ja epäjärjestyksessä saapuvien viestien kohdalla.";
"about.principles.title" = "Perusperiaatteet";
"about.principles.privacy.title" = "Yksityisyys oletuksena";
"about.principles.privacy.desc" = "Ei puhelinnumeroa, ei sähköpostia, ei tiliä, ei seurantaa. Mesh-verkon kautta lähetetyt viestit eivät jätä yhtään mitään millekään palvelimelle.";
"about.principles.decentralization.title" = "Hajautus";
"about.principles.decentralization.desc" = "Ei keskusviranomaista, ei yksittäistä vikaantumiskohtaa. Valta jaettuna koko verkossa.";
"about.principles.sovereignty.title" = "Suvereniteetti";
"about.principles.sovereignty.desc" = "Hallitset identiteettiäsi, tietojasi ja yhteyksiäsi. Ei yrityksiä, ei valvontaa.";
"about.principles.resilience.title" = "Kestävyys";
"about.principles.resilience.desc" = "Toimii internetkatkoksissa, sensuurissa tai katastrofitilanteissa. Viestintää ei voi pysäyttää.";
"about.features.title" = "Tekniset ominaisuudet";
"about.features.doubleRatchet.title" = "Double Ratchet -protokolla";
"about.features.doubleRatchet.desc" = "Päästä päähän -salaus, joka perustuu Double Ratchetiin, X3DH:hon ja AES-256-GCM:ään. Kun molemmat laitteet tukevat sitä, avaintenvaihto ajaa lisäksi hybridin kvanttiturvallisen kerroksen (ML-KEM-768 yhdistettynä X25519:ään), joten tänään talteen otettu liikenne ei ole luettavissa tulevalla kvanttitietokoneella.";
"about.features.mesh.title" = "Monihyppyinen mesh-reititys";
"about.features.mesh.desc" = "Viestit välittyvät luotettujen vertaisten kautta määränpäähänsä, jopa offline-tilassa.";
"about.features.fallback.title" = "Hybridipilvivaratoiminto";
"about.features.fallback.desc" = "Ensin mesh, täysin ilman palvelinta. Jos se ei tavoita yhteyshenkilöäsi, viesti kulkee oman välityspalvelimemme kautta, joka tallentaa sen salattuna eikä voi lukea sitä.";
"about.features.identity.title" = "Kryptografinen identiteetti";
"about.features.identity.desc" = "Henkilöllisyytesi on laitteellasi luotu Curve25519-avainpari. Ei mitään rekisteröitävää, ei mitään takavarikoitavaa.";
"about.features.ordering.title" = "Epäjärjestyksen käsittely";
"about.features.ordering.desc" = "Edistynyt viestien puskurointi käsittelee verkkokaaoksen sujuvasti.";
"about.features.media.title" = "Salattu media";
"about.features.media.desc" = "Lähetä valokuvia ja videoita AES-256-GCM-salauksella, jonka vain vastaanottaja voi purkaa.";
"about.features.qr.title" = "QR-koodiparitus";
"about.features.qr.desc" = "Skannaa varmentaaksesi ja lisätäksesi kontakteja kryptografisilla turvanumeroilla.";
"about.features.serverless.title" = "Palvelimeton arkkitehtuuri";
"about.features.serverless.desc" = "Ei käyttäjätilejä, ei puhelinnumeroa, ei sähköpostia, ei tietojen keräämistä, ei seurantaa.";
"about.howItWorks.title" = "Miten se toimii";
"about.howItWorks.step1.title" = "Luo identiteettisi";
"about.howItWorks.step1.desc" = "Luo kryptografinen identiteetti, josta tulee ainutlaatuinen, varmennettavissa oleva identiteettisi.";
"about.howItWorks.step2.title" = "Yhdistä vertaisiin";
"about.howItWorks.step2.desc" = "Löydä lähellä olevia laitteita Bluetoothin tai WiFi-meshin kautta tai skannaa QR-koodeja lisätäksesi luotettuja kontakteja.";
"about.howItWorks.step3.title" = "Lähetä salattuja viestejä";
"about.howItWorks.step3.desc" = "Viestit salataan Double Ratchetilla ja lähetetään suoraan vertaisille tai välitetään meshin kautta.";
"about.howItWorks.step4.title" = "Varatoiminto pilveen";
"about.howItWorks.step4.desc" = "Jos mesh ei tavoita yhteyshenkilöäsi, salattu viesti odottaa toimitusta omalla välityspalvelimellamme. Välityspalvelin ei voi lukea sitä, eikä sitä julkaista koskaan missään julkisessa verkossa.";
"about.howItWorks.step5.title" = "Avaimet, jotka vaihtuvat jatkuvasti";
"about.howItWorks.step5.desc" = "Jokainen viesti saa oman avaimensa, ja ketju siirtyy eteenpäin jokaisen lähetyksen jälkeen.";
"about.useCases.title" = "Rakennettu kohderyhmälle";
"about.useCases.journalists.title" = "Toimittajat";
"about.useCases.journalists.desc" = "Turvallinen viestintä vihamielisissä ympäristöissä";
"about.useCases.activists.title" = "Aktivistit";
"about.useCases.activists.desc" = "Järjestäydy ilman valvontaa tai sensuuria";
"about.useCases.emergency.title" = "Hätätilannevaste";
"about.useCases.emergency.desc" = "Koordinoi, kun infrastruktuuri pettää";
"about.useCases.travelers.title" = "Matkustajat";
"about.useCases.travelers.desc" = "Pysy yhteydessä ilman verkkovierailua tai internetiä";
"about.useCases.privacy.title" = "Yksityisyyden puolustajat";
"about.useCases.privacy.desc" = "Viesti ilman yritysvälikäsiä";
"about.useCases.crypto.title" = "Kryptokäyttäjät";
"about.useCases.crypto.desc" = "Natiivi identiteetti-integraatio turvalliseen koordinointiin";
"about.openSource.title" = "Avoin lähdekoodi ja läpinäkyvyys";
"about.openSource.paragraph1" = "OSHI on **100 % avointa lähdekoodia**, rakennettu läpinäkyvyys ja auditoitavuus ytimessään. Jokainen koodirivi on julkinen ja varmennettavissa.";
"about.openSource.paragraph2" = "Uskomme, että yksityisyystyökalujen on oltava avoimia, jotta niihin voidaan luottaa. Ei takaovia, ei piilotelemetriaa, ei suljettuja algoritmeja.";
"about.openSource.contribute" = "Yhteisön kontribuutiot ovat tervetulleita!";
"about.openSource.viewCode" = "Näytä lähdekoodi GitHubissa";
"about.philosophy.title" = "Filosofia";
"about.philosophy.quote1" = "Viestintä on perustavanlaatuinen ihmisoikeus, ei tuote rahastettavaksi.";
"about.philosophy.quote2" = "Yksityisyyden tulisi olla oletus, ei premium-ominaisuus.";
"about.philosophy.quote3" = "Kenelläkään ei pitäisi olla valtaa vaientaa ääntäsi tai lukea ajatuksiasi.";
"about.philosophy.quote4" = "Todellinen vapaus vaatii työkaluja, joita ei voi hallita, sensuroida tai valvoa.";

/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI on yhteistoiminnallinen salattu viestisovellus. Ilman internetiä viestit hyppäävät puhelimesta toiseen lähellä olevien kautta, joilla OSHI on auki. Esitellään sinulle ympäristö.";
"guide_messages_tab_desc" = "Yksityiset keskustelusi näkyvät täällä. Soita salattuja äänipuheluita napauttamalla mitä tahansa keskustelua. Viestit ja puhelut saapuvat vain, kun sovellus on ollut auki yli 2 sekuntia - tämä on tarkoituksellista turvallisuuden vuoksi.";
"guide_groups_tab_desc" = "Luo yksityisiä ryhmiä tai liity lähellä oleviin julkisiin ryhmiin. Löydä ryhmiä mesh-kantaman sisältä, noin 100 m, ja kauempaa kun muut välittävät. Pidä sovellus auki havaitaksesi ympärilläsi olevat ryhmät!";
"guide_new_tab_desc" = "Aloita uusi keskustelu täällä. Skannaa yhteystiedon QR-koodi tai liitä hänen julkinen avaimensa. Ei puhelinnumeroita, ei tilejä - vain kryptografisia avaimia.";
"guide_settings_tab_desc" = "Krypto-identiteettisi sijaitsee täällä. Jaa QR-koodisi tai julkinen avaimesi muiden kanssa, jotta he voivat lähettää sinulle viestejä. Voit myös ottaa käyttöön biometrisen lukituksen lisäturvaa varten.";
"guide_collaborative_desc" = "OSHI on yhteistoiminnallinen: kun pidät sovelluksen auki, laitteesi auttaa välittämään viestejä muille lähellä oleville. Kriisitilanteissa (sota, internetin sulkeminen) tämä luo kestävän verkon. Yksi puhelin kantaa noin 100 m, joten mitä useammalla OSHI on auki, sitä kauemmas viestit voivat kulkea.";
"guide_complete_desc" = "Olet valmis! Muista: pidä OSHI auki vastaanottaaksesi viestejä ja auttaaksesi muita viestimään hätätilanteissa. Tervetuloa verkkoon!";


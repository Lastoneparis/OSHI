/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Gửi bitcoin trong cuộc trò chuyện";
"guide.cashu.s1" = "OSHI không có ví và không bao giờ giữ tiền của bạn. Nó chuyển một token Cashu — ecash được bảo đảm bằng bitcoin — giống như nó chuyển một bức ảnh.";
"guide.cashu.s2" = "Trước tiên bạn cần một ví Cashu. eNuts, Minibits hoặc cashu.me trên trình duyệt: đều miễn phí và chỉ mất khoảng một phút để thiết lập.";
"guide.cashu.s3" = "Trong ví, hãy chọn một mint và nạp một ít tiền qua Lightning. Vài trăm sat là đủ để thử.";
"guide.cashu.s4" = "Tạo token: trong ví nhấn Gửi, nhập số tiền rồi sao chép. Bạn nhận được một dòng chữ dài bắt đầu bằng cashuB. Dòng chữ đó CHÍNH LÀ tiền.";
"guide.cashu.s6" = "Người nhận nhấn Nhận tiền và tiền vào ví của họ. Token gửi cho bạn cũng hiện giống vậy: nhấn Nhận tiền. OSHI chỉ là cái phong bì.";
"guide.cashu.s5" = "Trong cuộc trò chuyện, nhập / vào ô tin nhắn, chọn /pay rồi dán token. OSHI hiển thị số tiền trước khi gửi để bạn kiểm tra.";
"guide.cashu.sub" = "Ecash Cashu — OSHI không bao giờ giữ tiền của bạn";
"guide.cashu.warning" = "Token Cashu là tiền mặt. Bất cứ ai có được dòng chữ đó đều có thể tiêu, và ai đổi trước thì giữ được — vì vậy chỉ gửi cho đúng người bạn muốn. OSHI không thể hỏi mint xem token đã được tiêu chưa: nó chỉ thuộc về bạn khi ví của chính bạn đổi nó.";

/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Giới thiệu";
"about.tagline" = "Trình nhắn tin tự chủ";
"about.tag.offline" = "Ngoại tuyến";
"about.tag.secure" = "Bảo mật";
"about.tag.decentralized" = "Phi tập trung";
"about.vision.title" = "Tầm nhìn";
"about.vision.paragraph1" = "OSHI không chỉ là một trình nhắn tin — nó là **một giao thức liên lạc cho tự do số**. Được xây dựng trên các nguyên tắc chủ quyền, riêng tư và bền bỉ.";
"about.vision.paragraph2" = "Khi có ai đó trong tầm phủ sóng, OSHI hoạt động **không cần Internet và không cần bất kỳ máy chủ nào**, định tuyến tin nhắn qua **mạng lưới mesh ngang hàng** bằng kết nối Bluetooth/Wi-Fi trực tiếp hoặc các chặng chuyển tiếp nhiều bước. Khi không có ai trong tầm phủ sóng, ứng dụng chuyển sang máy chủ chuyển tiếp của chúng tôi để tin nhắn vẫn đến nơi.";
"about.vision.paragraph3" = "Mỗi tin nhắn được bảo vệ bằng **Double Ratchet** với trao đổi khóa **X3DH** và **AES-256-GCM** — đúng cấu trúc mà Signal sử dụng — và điều đó vẫn đúng qua các chặng chuyển tiếp ngoại tuyến và khi tin nhắn đến không đúng thứ tự.";
"about.principles.title" = "Nguyên tắc cốt lõi";
"about.principles.privacy.title" = "Riêng tư mặc định";
"about.principles.privacy.desc" = "Không số điện thoại, không email, không tài khoản, không theo dõi. Tin nhắn gửi qua mạng mesh không để lại bất cứ thứ gì trên bất kỳ máy chủ nào.";
"about.principles.decentralization.title" = "Phi tập trung";
"about.principles.decentralization.desc" = "Không có cơ quan trung tâm, không có điểm hỏng duy nhất. Quyền lực được phân tán trên toàn mạng.";
"about.principles.sovereignty.title" = "Chủ quyền";
"about.principles.sovereignty.desc" = "Bạn kiểm soát danh tính, dữ liệu và kết nối của mình. Không tập đoàn, không giám sát.";
"about.principles.resilience.title" = "Bền bỉ";
"about.principles.resilience.desc" = "Hoạt động khi mất internet, bị kiểm duyệt, hoặc trong các tình huống thảm họa. Liên lạc không thể bị chặn.";
"about.features.title" = "Tính năng kỹ thuật";
"about.features.doubleRatchet.title" = "Giao thức Double Ratchet";
"about.features.doubleRatchet.desc" = "Mã hóa đầu cuối dựa trên Double Ratchet với X3DH và AES-256-GCM. Khi cả hai thiết bị đều hỗ trợ, quá trình thỏa thuận khóa còn chạy thêm một lớp lai hậu lượng tử (ML-KEM-768 kết hợp với X25519), nên lưu lượng bị thu thập hôm nay vẫn không đọc được bằng máy tính lượng tử trong tương lai.";
"about.features.mesh.title" = "Định tuyến Mesh đa chặng";
"about.features.mesh.desc" = "Tin nhắn chuyển tiếp qua các thiết bị tin cậy để đến đích, ngay cả khi ngoại tuyến.";
"about.features.fallback.title" = "Dự phòng đám mây lai";
"about.features.fallback.desc" = "Mesh trước, hoàn toàn không qua máy chủ nào. Nếu cách đó không tới được người nhận, tin nhắn đi qua relay của riêng chúng tôi, nơi lưu nó ở dạng mã hóa và không thể đọc được.";
"about.features.identity.title" = "Danh tính mật mã";
"about.features.identity.desc" = "Danh tính của bạn là một cặp khóa Curve25519 được tạo ngay trên thiết bị của bạn. Không có gì để đăng ký, không có gì để tịch thu.";
"about.features.ordering.title" = "Xử lý không theo thứ tự";
"about.features.ordering.desc" = "Bộ đệm tin nhắn tiên tiến xử lý sự hỗn loạn của mạng một cách mượt mà.";
"about.features.media.title" = "Phương tiện được mã hóa";
"about.features.media.desc" = "Gửi ảnh và video với mã hóa AES-256-GCM, chỉ được giải mã bởi người nhận.";
"about.features.qr.title" = "Ghép cặp bằng mã QR";
"about.features.qr.desc" = "Quét để xác minh và thêm liên hệ bằng số an toàn mật mã.";
"about.features.serverless.title" = "Kiến trúc không máy chủ";
"about.features.serverless.desc" = "Không tài khoản người dùng, không số điện thoại, không email, không thu thập dữ liệu, không theo dõi.";
"about.howItWorks.title" = "Cách hoạt động";
"about.howItWorks.step1.title" = "Tạo danh tính của bạn";
"about.howItWorks.step1.desc" = "Tạo một danh tính mật mã trở thành danh tính duy nhất, có thể xác minh của bạn.";
"about.howItWorks.step2.title" = "Kết nối với thiết bị";
"about.howItWorks.step2.desc" = "Khám phá thiết bị gần đó qua mesh Bluetooth hoặc Wi-Fi, hoặc quét mã QR để thêm liên hệ tin cậy.";
"about.howItWorks.step3.title" = "Gửi tin nhắn mã hóa";
"about.howItWorks.step3.desc" = "Tin nhắn được mã hóa bằng Double Ratchet và gửi trực tiếp đến thiết bị hoặc chuyển tiếp qua mesh.";
"about.howItWorks.step4.title" = "Dự phòng lên đám mây";
"about.howItWorks.step4.desc" = "Nếu mesh không tới được người nhận, tin nhắn đã mã hóa được giữ trên máy chủ relay của riêng chúng tôi cho đến khi gửi xong. Relay không thể đọc nó, và nó không bao giờ được công bố lên bất kỳ mạng công cộng nào.";
"about.howItWorks.step5.title" = "Những khóa luôn thay đổi";
"about.howItWorks.step5.desc" = "Mỗi tin nhắn có khóa riêng của nó, và chuỗi khóa tiến lên sau mỗi lần gửi.";
"about.useCases.title" = "Dành cho";

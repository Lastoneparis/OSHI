/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI là một trình nhắn tin mã hóa cộng tác. Khi không có internet, tin nhắn nhảy từ máy này sang máy khác qua những người ở gần đang mở OSHI. Hãy cùng tham quan nhé.";
"guide_messages_tab_desc" = "Các cuộc trò chuyện riêng tư của bạn xuất hiện ở đây. Thực hiện cuộc gọi thoại mã hóa bằng cách nhấn vào bất kỳ cuộc trò chuyện nào. Tin nhắn và cuộc gọi chỉ đến khi ứng dụng mở được 2 giây trở lên - đây là thiết kế vì lý do bảo mật.";
"guide_groups_tab_desc" = "Tạo nhóm riêng tư hoặc tham gia nhóm công khai gần đó. Khám phá nhóm trong phạm vi mesh, khoảng 100 m, và xa hơn khi có người khác chuyển tiếp. Hãy giữ ứng dụng mở để phát hiện các nhóm xung quanh bạn!";
"guide_new_tab_desc" = "Bắt đầu cuộc trò chuyện mới ở đây. Quét mã QR của liên hệ hoặc dán khóa công khai của họ. Không số điện thoại, không tài khoản - chỉ là khóa mật mã.";
"guide_settings_tab_desc" = "Danh tính tiền mã hóa của bạn ở đây. Chia sẻ mã QR hoặc khóa công khai với người khác để họ có thể nhắn tin cho bạn. Bạn cũng có thể bật khóa sinh trắc học để bảo mật hơn.";
"guide_collaborative_desc" = "OSHI mang tính cộng tác: khi bạn giữ ứng dụng mở, thiết bị của bạn giúp chuyển tiếp tin nhắn cho những người khác ở gần. Trong tình huống khủng hoảng (chiến tranh, mất internet), điều này tạo ra một mạng lưới bền bỉ. Mỗi điện thoại phủ khoảng 100 m, nên càng nhiều người mở OSHI thì tin nhắn càng đi xa được.";
"guide_complete_desc" = "Bạn đã sẵn sàng! Hãy nhớ: giữ OSHI mở để nhận tin nhắn và giúp người khác liên lạc trong tình huống khẩn cấp. Chào mừng đến với mạng lưới!";


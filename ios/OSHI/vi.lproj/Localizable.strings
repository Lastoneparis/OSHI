"guide_welcome_title" = "Chào mừng đến với OSHI!";
"guide_messages_tab_title" = "Tin nhắn";
"guide_groups_tab_title" = "Nhóm";
"guide_new_tab_title" = "Cuộc trò chuyện mới";
"guide_settings_tab_title" = "Cài đặt & Danh tính";

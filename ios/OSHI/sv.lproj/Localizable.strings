/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI är en samarbetsbaserad krypterad messenger. Utan internet hoppar meddelanden från telefon till telefon via personer i närheten som har OSHI öppet. Låt oss visa dig runt.";
"guide_messages_tab_desc" = "Dina privata konversationer visas här. Gör krypterade röstsamtal genom att trycka på valfri konversation. Meddelanden och samtal anländer endast när appen varit öppen i 2+ sekunder - detta är avsiktligt av säkerhetsskäl.";
"guide_groups_tab_desc" = "Skapa privata grupper eller gå med i offentliga i närheten. Upptäck grupper inom mesh-räckvidden, cirka 100 m, och längre bort när andra reläar. Håll appen öppen för att upptäcka grupper omkring dig!";
"guide_new_tab_desc" = "Starta en ny konversation här. Skanna en kontakts QR-kod eller klistra in deras publika nyckel. Inga telefonnummer, inga konton - bara kryptografiska nycklar.";
"guide_settings_tab_desc" = "Din kryptoidentitet finns här. Dela din QR-kod eller publika nyckel med andra så att de kan meddela dig. Du kan också aktivera biometriskt lås för extra säkerhet.";
"guide_collaborative_desc" = "OSHI är samarbetsbaserat: när du håller appen öppen hjälper din enhet till att relä meddelanden åt andra i närheten. I krissituationer (krig, internetavstängning) skapar detta ett motståndskraftigt nätverk. Varje telefon når ungefär 100 m, så ju fler som har OSHI öppet, desto längre kan meddelanden färdas.";
"guide_complete_desc" = "Allt är klart! Kom ihåg: håll OSHI öppet för att ta emot meddelanden och hjälpa andra att kommunicera i nödsituationer. Välkommen till nätverket!";


/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Om";
"about.tagline" = "Den suveräna Messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Säker";
"about.tag.decentralized" = "Decentraliserad";
"about.vision.title" = "Visionen";
"about.vision.paragraph1" = "OSHI är inte bara en messenger — det är ett **kommunikationsprotokoll för digital frihet**. Byggt på principerna suveränitet, integritet och motståndskraft.";
"about.vision.paragraph2" = "När någon är inom räckhåll fungerar OSHI **helt utan internet och utan någon server** och skickar meddelanden via ett **peer-to-peer-meshnätverk** över direkta Bluetooth/Wi-Fi-länkar eller reläer med flera hopp. Är ingen inom räckhåll faller den tillbaka på vårt relä så att meddelandet ändå kommer fram.";
"about.vision.paragraph3" = "Varje meddelande skyddas av **Double Ratchet** med **X3DH**-nyckelutbyte och **AES-256-GCM** — samma konstruktion som Signal använder — och det håller även genom offlinereläer och leverans i oordning.";
"about.principles.title" = "Grundprinciper";
"about.principles.privacy.title" = "Integritet som standard";
"about.principles.privacy.desc" = "Inget telefonnummer, ingen e-post, inget konto, ingen spårning. Meddelanden som skickas över meshnätverket lämnar absolut ingenting på någon server.";
"about.principles.decentralization.title" = "Decentralisering";
"about.principles.decentralization.desc" = "Ingen central myndighet, ingen enskild felpunkt. Kraften fördelas över nätverket.";
"about.principles.sovereignty.title" = "Suveränitet";
"about.principles.sovereignty.desc" = "Du kontrollerar din identitet, dina data och dina anslutningar. Inga företag, ingen övervakning.";
"about.principles.resilience.title" = "Motståndskraft";
"about.principles.resilience.desc" = "Fungerar vid internetavbrott, censur eller katastrofscenarier. Kommunikationen kan inte stoppas.";
"about.features.title" = "Tekniska funktioner";
"about.features.doubleRatchet.title" = "Double Ratchet-protokoll";
"about.features.doubleRatchet.desc" = "End-to-end-kryptering byggd på Double Ratchet med X3DH och AES-256-GCM. När båda enheterna stöder det kör nyckelutbytet även ett hybrid-postkvantlager (ML-KEM-768 kombinerat med X25519), så att trafik som fångas upp i dag inte går att läsa med en framtida kvantdator.";
"about.features.mesh.title" = "Mesh-dirigering med flera hopp";
"about.features.mesh.desc" = "Meddelanden reläas genom betrodda noder för att nå sin destination, även offline.";
"about.features.fallback.title" = "Hybrid molnreserv";
"about.features.fallback.desc" = "Mesh först, helt utan server. Om det inte når din kontakt går meddelandet via vårt eget relä, som lagrar det krypterat och inte kan läsa det.";
"about.features.identity.title" = "Kryptografisk identitet";
"about.features.identity.desc" = "Din identitet är ett Curve25519-nyckelpar som genereras på din egen enhet. Inget att registrera, inget att beslagta.";
"about.features.ordering.title" = "Hantering av fel ordning";
"about.features.ordering.desc" = "Avancerad meddelandebuffring hanterar nätverkskaos smidigt.";
"about.features.media.title" = "Krypterad media";
"about.features.media.desc" = "Skicka foton och videor med AES-256-GCM-kryptering, dekrypterade endast av mottagaren.";
"about.features.qr.title" = "QR-kodsparkoppling";
"about.features.qr.desc" = "Skanna för att verifiera och lägga till kontakter med kryptografiska säkerhetsnummer.";
"about.features.serverless.title" = "Serverlös arkitektur";
"about.features.serverless.desc" = "Inga användarkonton, inget telefonnummer, ingen e-post, ingen datainsamling, ingen spårning.";
"about.howItWorks.title" = "Så fungerar det";
"about.howItWorks.step1.title" = "Generera din identitet";
"about.howItWorks.step1.desc" = "Skapa en kryptografisk identitet som blir din unika, verifierbara identitet.";
"about.howItWorks.step2.title" = "Anslut till noder";
"about.howItWorks.step2.desc" = "Upptäck närliggande enheter via Bluetooth eller WiFi-mesh, eller skanna QR-koder för att lägga till betrodda kontakter.";
"about.howItWorks.step3.title" = "Skicka krypterade meddelanden";

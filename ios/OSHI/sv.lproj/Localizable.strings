"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Skicka bitcoin i en chatt";
"guide.cashu.s1" = "OSHI har ingen wallet och håller aldrig dina pengar. Den bär en Cashu-token — ecash med bitcoin som täckning — på samma sätt som den bär ett foto.";
"guide.cashu.s2" = "Du behöver först en Cashu-wallet. eNuts, Minibits eller cashu.me i en webbläsare: alla gratis och klara på ungefär en minut.";
"guide.cashu.s3" = "Välj ett mint i walleten och fyll på lite pengar via Lightning. Några hundra sats räcker gott för att prova.";
"guide.cashu.s4" = "Skapa en token: tryck Skicka i walleten, ange ett belopp och kopiera. Du får en lång textrad som börjar med cashuB. Den texten ÄR pengarna.";
"guide.cashu.s6" = "Mottagaren trycker Lös in och pengarna landar i deras wallet. En token som skickas till dig ser likadan ut: tryck Lös in. OSHI är bara kuvertet.";
"guide.cashu.s5" = "Skriv / i meddelandefältet i chatten, välj /pay och klistra in token. OSHI visar beloppet innan det skickas så att du kan kontrollera det.";
"guide.cashu.sub" = "Cashu-ecash — OSHI håller aldrig dina pengar";
"guide.cashu.warning" = "En Cashu-token är kontanter. Alla som får texten kan spendera den, och den som löser in först behåller den — skicka den därför bara till den person du menar. OSHI kan inte fråga mintet om en token redan är spenderad: den är dina pengar först när din egen wallet löser in den.";

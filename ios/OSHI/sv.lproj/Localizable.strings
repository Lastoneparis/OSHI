// MARK: - Mesh Info
"info.mesh.title" = "Mesh-nätverk";
"info.mesh.section.about" = "OM";
"info.mesh.section.features" = "FUNKTIONER";
"info.mesh.section.tips" = "TIPS";
"info.mesh.what_title" = "Vad är Mesh?";
"info.mesh.what_description" = "Mesh-nätverk skapar direkta anslutningar mellan närliggande enheter med Bluetooth och WiFi, vilket gör att meddelanden kan skickas utan internet.";
"info.mesh.range_title" = "Räckvidd";
"info.mesh.range_description" = "Ansluter till enheter inom cirka 30-100 meter beroende på förhållanden.";
"info.mesh.connection_title" = "Anslutning";
"info.mesh.connection_description" = "Meddelanden hoppar mellan anslutna enheter för att nå sin destination.";
"info.mesh.encryption_title" = "Säkerhet";
"info.mesh.encryption_description" = "Meddelanden som reläas mellan iPhone-enheter över mesh-nätverket förblir totalsträckskrypterade, så enheterna som reläar dem ser bara krypterad text. Bryggan till Android-enheter och till Meshtastic LoRa-radioapparater lägger inte till någon egen kryptering, så betrakta inte de länkarna som privata.";
"info.mesh.tip1" = "Håll dig nära andra OSHI-användare för bästa anslutning";
"info.mesh.tip2" = "Aktivera både Bluetooth och WiFi för optimal räckvidd";
"info.mesh.tip3" = "Reläer mellan iPhone-enheter ser bara krypterad text; Android- och LoRa-bryggorna krypterar inte";
"info.mesh.disclaimer_title" = "Innan du förlitar dig på det";
"info.mesh.disclaimer_description" = "Offline-mesh har kort räckvidd. Båda telefonerna måste ha OSHI öppet för att hitta varandra, ungefär 100 m ifrån varandra i öppen terräng och betydligt mindre genom väggar. Det når längre bara när andra personer i närheten också har OSHI öppet och kan skicka meddelandet vidare. Om ingen är inom räckhåll skickar OSHI i stället över internet.";

"about.tag.secure" = "安全";
"about.tag.decentralized" = "去中心化";
"about.vision.title" = "愿景";
"about.vision.paragraph1" = "OSHI 不仅仅是一个通讯器 - 它是**数字自由的通信协议**。建立在主权、隐私和韧性的原则之上。";
"about.vision.paragraph2" = "当有人在通信范围内时，OSHI **完全不需要互联网、也不需要任何服务器**，通过直接的 Bluetooth/Wi-Fi 连接或多跳中继，在**点对点网状网络**中传递消息。当附近没有人时，它会退回到我们的中继服务器，让消息仍然送达。";
"about.vision.paragraph3" = "每条消息都由 **Double Ratchet** 保护，配合 **X3DH** 密钥协商与 **AES-256-GCM** —— 与 Signal 采用的构造相同 —— 即使经过离线中继或乱序送达也同样适用。";
"about.principles.title" = "核心原则";
"about.principles.privacy.title" = "默认隐私";
"about.principles.privacy.desc" = "无需手机号，无需电子邮件，无需账号，没有追踪。通过网状网络发送的消息不会在任何服务器上留下任何东西。";
"about.principles.decentralization.title" = "去中心化";
"about.principles.decentralization.desc" = "没有中央权威，没有单点故障。权力分布在整个网络中。";
"about.principles.sovereignty.title" = "主权";
"about.principles.sovereignty.desc" = "您控制您的身份、您的数据和您的连接。没有公司，没有监控。";
"about.principles.resilience.title" = "韧性";
"about.principles.resilience.desc" = "在互联网中断、审查或灾难场景中工作。通信不能被阻止。";
"about.features.title" = "技术功能";
"about.features.doubleRatchet.title" = "双棘轮协议";
"about.features.doubleRatchet.desc" = "端到端加密基于 Double Ratchet，配合 X3DH 与 AES-256-GCM。当双方设备都支持时，密钥协商还会额外运行一层混合抗量子算法（ML-KEM-768 与 X25519 结合），因此今天被截获的流量，未来的量子计算机也读不了。";
"about.features.mesh.title" = "多跳网状路由";
"about.features.mesh.desc" = "消息通过受信任的节点中继到达目的地，即使在离线状态下也是如此。";
"about.features.fallback.title" = "混合云备用";

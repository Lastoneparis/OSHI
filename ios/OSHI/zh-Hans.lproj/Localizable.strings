/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI 是一款协作式加密通讯应用。没有互联网时，消息会通过附近打开 OSHI 的人在手机之间接力传递。让我们带您参观一下。";
"guide_messages_tab_desc" = "您的私人对话显示在这里。点击任何对话即可拨打加密语音电话。消息和通话仅在应用打开 2 秒以上时才会到达 - 这是出于安全考虑的设计。";
"guide_groups_tab_desc" = "创建私人群组或加入附近的公开群组。在网状网络范围内（约 100 米）发现群组，有他人中继时可以更远。保持应用打开以检测周围的群组！";
"guide_new_tab_desc" = "在这里开始新对话。扫描联系人的二维码或粘贴他们的公钥。无需电话号码，无需账户 - 只需加密密钥。";
"guide_settings_tab_desc" = "您的加密身份在这里。与他人分享您的二维码或公钥，以便他们可以给您发消息。您还可以启用生物识别锁以增加安全性。";
"guide_collaborative_desc" = "OSHI 是协作式的：当您保持应用打开时，您的设备会帮助为附近的其他人中继消息。在危机情况下（战争、断网），这会形成一个有韧性的网络。每部手机的覆盖范围约 100 米，因此打开 OSHI 的人越多，消息就能传得越远。";
"guide_complete_desc" = "一切就绪！记住：保持 OSHI 打开以接收消息并帮助他人在紧急情况下进行通信。欢迎加入网络！";


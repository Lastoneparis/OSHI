"about.howItWorks.step3.title" = "Trimite mesaje criptate";
"about.howItWorks.step3.desc" = "Mesajele sunt criptate cu Double Ratchet și trimise direct partenerilor sau transmise prin mesh.";
"about.howItWorks.step4.title" = "Rezervă în cloud";
"about.howItWorks.step4.desc" = "Dacă mesh-ul nu ajunge la contactul tău, mesajul criptat rămâne pe propriul nostru server de releu până la livrare. Releul nu îl poate citi și nu este publicat niciodată într-o rețea publică.";
"about.howItWorks.step5.title" = "Chei care se schimbă mereu";

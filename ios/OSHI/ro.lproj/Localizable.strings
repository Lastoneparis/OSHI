/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI este un mesager criptat colaborativ. Fără internet, mesajele sar din telefon în telefon prin persoanele din apropiere care au OSHI deschis. Hai să-ți facem o prezentare.";
"guide_messages_tab_desc" = "Conversațiile tale private apar aici. Efectuează apeluri vocale criptate apăsând pe orice conversație. Mesajele și apelurile sosesc doar când aplicația este deschisă timp de 2+ secunde - acest lucru este intenționat, pentru securitate.";
"guide_groups_tab_desc" = "Creează grupuri private sau alătură-te celor publice din apropiere. Descoperă grupuri în raza mesh, aproximativ 100 m, și mai departe când alții retransmit. Ține aplicația deschisă pentru a detecta grupurile din jurul tău!";
"guide_new_tab_desc" = "Începe o conversație nouă aici. Scanează codul QR al unui contact sau lipește cheia lor publică. Fără numere de telefon, fără conturi - doar chei criptografice.";
"guide_settings_tab_desc" = "Identitatea ta cripto locuiește aici. Distribuie altora codul tău QR sau cheia publică pentru ca aceștia să-ți poată trimite mesaje. De asemenea, poți activa blocarea biometrică pentru securitate suplimentară.";
"guide_collaborative_desc" = "OSHI este colaborativ: când ții aplicația deschisă, dispozitivul tău ajută la retransmiterea mesajelor pentru alte persoane din apropiere. În situații de criză (război, oprirea internetului), aceasta creează o rețea rezilientă. Fiecare telefon ajunge la aproximativ 100 m, așa că, cu cât mai multe persoane au OSHI deschis, cu atât mai departe pot călători mesajele.";
"guide_complete_desc" = "Ești gata! Reține: ține OSHI deschis pentru a primi mesaje și a-i ajuta pe alții să comunice în situații de urgență. Bun venit în rețea!";


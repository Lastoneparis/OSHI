   ============================================ */

"about.navigationTitle" = "Despre";
"about.tagline" = "Mesagerul suveran";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Securizat";
"about.tag.decentralized" = "Descentralizat";
"about.vision.title" = "Viziunea";
"about.vision.paragraph1" = "OSHI nu este doar un mesager — este un **protocol de comunicare pentru libertatea digitală**. Construit pe principii de suveranitate, confidențialitate și reziliență.";
"about.vision.paragraph2" = "Când cineva se află în raza de acoperire, OSHI funcționează **fără internet și fără niciun server**, transmițând mesajele printr-o **rețea mesh peer-to-peer** prin conexiuni Bluetooth/Wi-Fi directe sau relee cu mai multe salturi. Când nu este nimeni în rază, recurge la releul nostru, astfel încât mesajul să ajungă totuși.";
"about.vision.paragraph3" = "Fiecare mesaj este protejat de **Double Ratchet**, cu schimb de chei **X3DH** și **AES-256-GCM** — aceeași construcție folosită de Signal — și rămâne valabil și prin relee offline și livrări în altă ordine.";
"about.principles.title" = "Principii fundamentale";
"about.principles.privacy.title" = "Confidențialitate implicită";
"about.principles.privacy.desc" = "Fără număr de telefon, fără e-mail, fără cont, fără urmărire. Mesajele trimise prin rețeaua mesh nu lasă absolut nimic pe niciun server.";
"about.principles.decentralization.title" = "Descentralizare";
"about.principles.decentralization.desc" = "Nicio autoritate centrală, niciun punct unic de defecțiune. Putere distribuită în întreaga rețea.";
"about.principles.sovereignty.title" = "Suveranitate";
"about.principles.sovereignty.desc" = "Tu îți controlezi identitatea, datele și conexiunile. Fără corporații, fără supraveghere.";
"about.principles.resilience.title" = "Reziliență";
"about.principles.resilience.desc" = "Funcționează în pene de internet, cenzură sau scenarii de dezastru. Comunicarea nu poate fi oprită.";
"about.features.title" = "Caracteristici tehnice";
"about.features.doubleRatchet.title" = "Protocol Double Ratchet";
"about.features.doubleRatchet.desc" = "Criptare end-to-end construită pe Double Ratchet, cu X3DH și AES-256-GCM. Când ambele dispozitive o acceptă, acordul de chei rulează în plus un strat hibrid post-cuantic (ML-KEM-768 combinat cu X25519), astfel încât traficul capturat astăzi să nu poată fi citit de un viitor computer cuantic.";
"about.features.mesh.title" = "Direcționare mesh cu salturi multiple";
"about.features.mesh.desc" = "Mesajele sunt transmise prin parteneri de încredere pentru a ajunge la destinație, chiar și offline.";
"about.features.fallback.title" = "Rezervă hibridă în cloud";
"about.features.fallback.desc" = "Întâi mesh-ul, fără niciun server. Dacă așa nu ajunge la contactul tău, mesajul trece prin releul nostru, care îl păstrează criptat și nu îl poate citi.";
"about.features.identity.title" = "Identitate criptografică";
"about.features.identity.desc" = "Identitatea ta este o pereche de chei Curve25519 generată pe dispozitivul tău. Nimic de înregistrat, nimic de confiscat.";
"about.features.ordering.title" = "Gestionarea ordinii incorecte";

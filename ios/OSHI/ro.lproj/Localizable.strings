"about.features.qr.title" = "Asociere cu cod QR";
"about.features.qr.desc" = "Scanează pentru a verifica și adăuga contacte cu numere de siguranță criptografice.";
"about.features.serverless.title" = "Arhitectură fără server";
"about.features.serverless.desc" = "Fără conturi de utilizator, fără număr de telefon, fără e-mail, fără colectare de date, fără urmărire.";
"about.howItWorks.title" = "Cum funcționează";

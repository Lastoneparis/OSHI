"about.vision.paragraph2" = "當有人在通訊範圍內時，OSHI **完全不需要網際網路、也不需要任何伺服器**，透過直接的 Bluetooth/Wi-Fi 連線或多躍點中繼，在**點對點網狀網路**中傳遞訊息。當附近沒有人時，它會改用我們的中繼伺服器，讓訊息仍然送達。";
"about.vision.paragraph3" = "每則訊息都由 **Double Ratchet** 保護，搭配 **X3DH** 金鑰協商與 **AES-256-GCM** —— 與 Signal 採用的架構相同 —— 即使經過離線中繼或亂序送達也同樣適用。";
"about.principles.title" = "核心原則";
"about.principles.privacy.title" = "預設隱私";
"about.principles.privacy.desc" = "不需要手機號碼、不需要電子郵件、不需要帳號、沒有追蹤。透過網狀網路傳送的訊息不會在任何伺服器上留下任何東西。";
"about.principles.decentralization.title" = "去中心化";
"about.principles.decentralization.desc" = "無中央機構，無單點故障。權力分散於整個網路。";
"about.principles.sovereignty.title" = "主權";
"about.principles.sovereignty.desc" = "您掌控自己的身份、資料與連線。不受企業或監控干預。";
"about.principles.resilience.title" = "韌性";
"about.principles.resilience.desc" = "在網路中斷、審查或災難情境下仍可運作。通訊無法被阻斷。";
"about.features.title" = "技術特性";
"about.features.doubleRatchet.title" = "Double Ratchet 協議";
"about.features.doubleRatchet.desc" = "端對端加密建立在 Double Ratchet 之上，搭配 X3DH 與 AES-256-GCM。當雙方裝置都支援時，金鑰協商還會額外執行一層混合式抗量子演算法（ML-KEM-768 與 X25519 結合），因此今天被攔截的流量，未來的量子電腦也讀不了。";
"about.features.mesh.title" = "多跳網狀路由";
"about.features.mesh.desc" = "訊息透過可信節點中繼，即使離線也能送達目的地。";
"about.features.fallback.title" = "混合雲備援";
"about.features.fallback.desc" = "先走網狀網路，完全不經過伺服器。若這樣聯絡不到對方，訊息會經由我們自己的中繼轉送，中繼只保存密文，無法讀取內容。";
"about.features.identity.title" = "密碼學身份";
"about.features.identity.desc" = "你的身分是在你裝置上產生的一對 Curve25519 金鑰。沒有什麼需要註冊，也沒有什麼可被扣押。";
"about.features.ordering.title" = "亂序處理";
"about.features.ordering.desc" = "進階訊息緩衝機制，優雅地應對網路混亂。";
"about.features.media.title" = "加密媒體";
"about.features.media.desc" = "使用 AES-256-GCM 加密傳送照片和影片，僅收件人可解密。";
"about.features.qr.title" = "QR Code 配對";
"about.features.qr.desc" = "掃描以密碼學安全號碼驗證並新增聯絡人。";
"about.features.serverless.title" = "無伺服器架構";
"about.features.serverless.desc" = "沒有使用者帳號，不需要手機號碼，不需要電子郵件，不蒐集資料，不做追蹤。";
"about.howItWorks.title" = "運作方式";
"about.howItWorks.step1.title" = "產生您的身份";
"about.howItWorks.step1.desc" = "建立一個密碼學身份，成為您獨一無二且可驗證的身份。";
"about.howItWorks.step2.title" = "連線至節點";
"about.howItWorks.step2.desc" = "透過 Bluetooth 或 WiFi 網狀網路探索附近裝置，或掃描 QR Code 新增可信聯絡人。";
"about.howItWorks.step3.title" = "傳送加密訊息";
"about.howItWorks.step3.desc" = "訊息使用 Double Ratchet 加密，直接傳送至節點或透過網狀網路中繼。";
"about.howItWorks.step4.title" = "備援至雲端";
"about.howItWorks.step4.desc" = "若網狀網路聯絡不到對方，加密後的訊息會暫存在我們自己的中繼伺服器上，直到送達為止。中繼無法讀取內容，也絕不會發布到任何公開網路。";
"about.howItWorks.step5.title" = "不斷變換的金鑰";
"about.howItWorks.step5.desc" = "每則訊息都有自己的金鑰，每送出一次，金鑰鏈就往前推進一步。";
"about.useCases.title" = "為誰而建";
"about.useCases.journalists.title" = "新聞工作者";
"about.useCases.journalists.desc" = "在惡意環境中安全通訊";
"about.useCases.activists.title" = "社會運動人士";
"about.useCases.activists.desc" = "在不受監控或審查的情況下組織活動";
"about.useCases.emergency.title" = "緊急應變";
"about.useCases.emergency.desc" = "在基礎設施失效時協調行動";
"about.useCases.travelers.title" = "旅行者";
"about.useCases.travelers.desc" = "不依賴漫遊或網路保持聯繫";
"about.useCases.privacy.title" = "隱私倡導者";
"about.useCases.privacy.desc" = "無需企業中間商即可通訊";
"about.useCases.crypto.title" = "加密貨幣用戶";
"about.useCases.crypto.desc" = "原生身份整合，實現安全協調";
"about.openSource.title" = "開放原始碼與透明度";
"about.openSource.paragraph1" = "OSHI **100% 開放原始碼**，以透明度和可稽核性為核心構建。每一行程式碼均公開且可驗證。";
"about.openSource.paragraph2" = "我們相信隱私工具必須公開才能被信任。沒有後門、沒有隱藏的遙測、沒有專有演算法。";
"about.openSource.contribute" = "歡迎社群貢獻！";
"about.openSource.viewCode" = "在 GitHub 上查看原始碼";
"about.philosophy.title" = "理念";
"about.philosophy.quote1" = "通訊是基本人權，而非可被商品化的產品。";
"about.philosophy.quote2" = "隱私應是預設值，而非付費功能。";
"about.philosophy.quote3" = "沒有人應擁有壓制您聲音或窺探您思想的權力。";
"about.philosophy.quote4" = "真正的自由需要無法被控制、審查或監控的工具。";

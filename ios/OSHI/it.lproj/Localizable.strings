/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Informazioni";
"about.tagline" = "Il Messenger Sovrano";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Sicuro";
"about.tag.decentralized" = "Decentralizzato";
"about.vision.title" = "La Visione";
"about.vision.paragraph1" = "OSHI non è solo un messenger — è un **protocollo di comunicazione per la libertà digitale**. Costruito su principi di sovranità, privacy e resilienza.";
"about.vision.paragraph2" = "Quando qualcuno è nel raggio d'azione, OSHI funziona **senza Internet e senza alcun server**, instradando i messaggi su una **rete mesh peer-to-peer** tramite collegamenti Bluetooth/Wi-Fi diretti o relay multi-hop. Quando non c'è nessuno nel raggio d'azione, ricorre al nostro relay affinché il messaggio arrivi comunque.";
"about.vision.paragraph3" = "Ogni messaggio è protetto dal **Double Ratchet** con accordo di chiavi **X3DH** e **AES-256-GCM** — la stessa costruzione usata da Signal — e regge anche attraverso relay offline e consegne fuori ordine.";
"about.principles.title" = "Principi Fondamentali";
"about.principles.privacy.title" = "Privacy per Impostazione Predefinita";
"about.principles.privacy.desc" = "Nessun numero di telefono, nessuna e-mail, nessun account, nessun tracciamento. I messaggi inviati sulla rete mesh non lasciano assolutamente nulla su nessun server.";
"about.principles.decentralization.title" = "Decentralizzazione";
"about.principles.decentralization.desc" = "Nessuna autorità centrale, nessun singolo punto di fallimento. Potere distribuito attraverso la rete.";
"about.principles.sovereignty.title" = "Sovranità";
"about.principles.sovereignty.desc" = "Tu controlli la tua identità, i tuoi dati e le tue connessioni. Nessuna azienda, nessuna sorveglianza.";
"about.principles.resilience.title" = "Resilienza";
"about.principles.resilience.desc" = "Funziona durante blackout internet, censura o scenari di disastro. La comunicazione non può essere fermata.";
"about.features.title" = "Caratteristiche Tecniche";
"about.features.doubleRatchet.title" = "Protocollo Double Ratchet";
"about.features.doubleRatchet.desc" = "Crittografia end-to-end basata su Double Ratchet con X3DH e AES-256-GCM. Quando entrambi i dispositivi lo supportano, l'accordo sulle chiavi esegue anche un livello ibrido post-quantistico (ML-KEM-768 combinato con X25519), così il traffico intercettato oggi non sarà leggibile da un futuro computer quantistico.";
"about.features.mesh.title" = "Routing Mesh Multi-Hop";
"about.features.mesh.desc" = "I messaggi vengono inoltrati attraverso peer fidati per raggiungere la loro destinazione, anche offline.";
"about.features.fallback.title" = "Fallback Cloud Ibrido";
"about.features.fallback.desc" = "Prima il mesh, senza alcun server. Se così non raggiunge il tuo contatto, il messaggio passa dal nostro relay, che lo conserva cifrato e non può leggerlo.";
"about.features.identity.title" = "Identità Crittografica";
"about.features.identity.desc" = "La tua identità è una coppia di chiavi Curve25519 generata sul tuo dispositivo. Niente da registrare, niente da sequestrare.";
"about.features.ordering.title" = "Gestione Fuori Ordine";
"about.features.ordering.desc" = "Il buffering avanzato dei messaggi gestisce il caos della rete con eleganza.";
"about.features.media.title" = "Media Crittografati";
"about.features.media.desc" = "Invia foto e video con crittografia AES-256-GCM, decrittabili solo dal destinatario.";
"about.features.qr.title" = "Accoppiamento Codice QR";
"about.features.qr.desc" = "Scansiona per verificare e aggiungere contatti con numeri di sicurezza crittografici.";
"about.features.serverless.title" = "Architettura Serverless";
"about.features.serverless.desc" = "Nessun account utente, nessun numero di telefono, nessuna email, nessuna raccolta dati, nessun tracciamento.";
"about.howItWorks.title" = "Come Funziona";
"about.howItWorks.step1.title" = "Genera la Tua Identità";
"about.howItWorks.step1.desc" = "Crea un'identità crittografica che diventa la tua identità unica e verificabile.";
"about.howItWorks.step2.title" = "Connettiti ai Peer";
"about.howItWorks.step2.desc" = "Scopri dispositivi vicini tramite Bluetooth o mesh WiFi, oppure scansiona codici QR per aggiungere contatti fidati.";
"about.howItWorks.step3.title" = "Invia Messaggi Crittografati";
"about.howItWorks.step3.desc" = "I messaggi sono crittografati con Double Ratchet e inviati direttamente ai peer o inoltrati attraverso il mesh.";
"about.howItWorks.step4.title" = "Fallback al Cloud";
"about.howItWorks.step4.desc" = "Se il mesh non raggiunge il tuo contatto, il messaggio cifrato resta sul nostro server relay finché non viene consegnato. Il relay non può leggerlo e non viene mai pubblicato su alcuna rete pubblica.";

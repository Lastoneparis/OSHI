"peers.info.privacy.title" = "Privacy e Sicurezza";
"peers.info.privacy.description" = "Quando un messaggio salta tra iPhone, i dispositivi che lo inoltrano vedono solo testo cifrato e non possono leggerlo. Il ponte verso i dispositivi Android e le radio Meshtastic LoRa non aggiunge alcuna crittografia propria.";
"peers.info.range.title" = "Raggio e Connettività";

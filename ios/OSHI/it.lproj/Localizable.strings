/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Inviare bitcoin in una chat";
"guide.cashu.s1" = "OSHI non ha un portafoglio e non detiene mai il tuo denaro. Trasporta un token Cashu — ecash coperto da bitcoin — come trasporta una foto.";
"guide.cashu.s2" = "Prima ti serve un portafoglio Cashu. eNuts, Minibits o cashu.me nel browser: tutti gratuiti, un minuto per iniziare.";
"guide.cashu.s3" = "Nel portafoglio scegli una mint e aggiungi un po' di denaro tramite Lightning. Poche centinaia di sats bastano per provare.";
"guide.cashu.s4" = "Crea un token: nel portafoglio tocca Invia, inserisci un importo, copia. Ottieni una lunga riga di testo che inizia con cashuB. Quel testo È il denaro.";
"guide.cashu.s6" = "L'altra persona tocca Riscatta e il denaro arriva nel suo portafoglio. Un token inviato a te si presenta allo stesso modo: tocca Riscatta. OSHI è solo la busta.";
"guide.cashu.s5" = "Nella chat digita / nel campo del messaggio, scegli /pay e incolla il token. OSHI mostra l'importo prima di inviarlo, così puoi controllarlo.";
"guide.cashu.sub" = "Ecash Cashu: OSHI non detiene mai il tuo denaro";
"guide.cashu.warning" = "Un token Cashu è denaro contante. Chi ottiene il testo può spenderlo, e chi lo riscatta per primo lo tiene: invialo solo alla persona a cui è destinato. OSHI non può chiedere alla mint se un token è già stato speso: è tuo solo quando il tuo portafoglio lo riscatta.";

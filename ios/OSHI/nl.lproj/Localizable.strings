"info.mesh.section.tips" = "TIPS";
"info.mesh.what_title" = "Wat is mesh?";
"info.mesh.what_description" = "Mesh-netwerken maakt directe verbindingen tussen apparaten in de buurt met Bluetooth en WiFi, waardoor berichten zonder internet kunnen worden verzonden.";
"info.mesh.range_title" = "Bereik";
"info.mesh.range_description" = "Maakt verbinding met apparaten binnen ongeveer 30-100 meter, afhankelijk van de omstandigheden.";
"info.mesh.connection_title" = "Verbinding";
"info.mesh.connection_description" = "Berichten springen tussen verbonden apparaten om hun bestemming te bereiken.";
"info.mesh.encryption_title" = "Beveiliging";
"info.mesh.encryption_description" = "Berichten die tussen iPhones via het mesh-netwerk worden doorgegeven, blijven end-to-end versleuteld, zodat doorgevende apparaten alleen versleutelde tekst zien. De brug naar Android-apparaten en naar Meshtastic LoRa-radio's voegt zelf geen versleuteling toe, dus beschouw die verbindingen niet als privé.";
"info.mesh.tip1" = "Blijf dicht bij andere OSHI-gebruikers voor de beste connectiviteit";
"info.mesh.tip2" = "Schakel zowel Bluetooth als WiFi in voor optimaal bereik";
"info.mesh.tip3" = "iPhone-naar-iPhone-relais zien alleen versleutelde tekst; de Android- en LoRa-bruggen versleutelen niet";
"info.mesh.disclaimer_title" = "Voordat je erop vertrouwt";
"info.mesh.disclaimer_description" = "Offline mesh heeft een klein bereik. Op beide telefoons moet OSHI open staan om elkaar te vinden, op ongeveer 100 m afstand in de open lucht en veel minder door muren heen. Het reikt alleen verder wanneer andere mensen in de buurt OSHI ook open hebben staan om het bericht door te geven. Is er niemand in de buurt, dan verstuurt OSHI het bericht via internet.";

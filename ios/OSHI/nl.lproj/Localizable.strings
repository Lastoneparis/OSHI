/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Over";
"about.tagline" = "De Soevereine Messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Veilig";
"about.tag.decentralized" = "Gedecentraliseerd";
"about.vision.title" = "De visie";
"about.vision.paragraph1" = "OSHI is niet zomaar een messenger — het is een **communicatieprotocol voor digitale vrijheid**. Gebouwd op de principes van soevereiniteit, privacy en veerkracht.";
"about.vision.paragraph2" = "Als er iemand binnen bereik is, werkt OSHI **volledig zonder internet en zonder enige server** en verstuurt het berichten via een **peer-to-peer mesh-netwerk** over directe Bluetooth/Wi-Fi-verbindingen of relais met meerdere hops. Is er niemand binnen bereik, dan valt het terug op ons relais zodat het bericht toch aankomt.";
"about.vision.paragraph3" = "Elk bericht wordt beschermd door de **Double Ratchet** met **X3DH**-sleutelovereenkomst en **AES-256-GCM** — dezelfde constructie die Signal gebruikt — en dat blijft ook gelden bij offline relais en levering in willekeurige volgorde.";
"about.principles.title" = "Kernprincipes";
"about.principles.privacy.title" = "Privacy standaard";
"about.principles.privacy.desc" = "Geen telefoonnummer, geen e-mailadres, geen account, geen tracking. Berichten die via het mesh worden verstuurd laten helemaal niets achter op welke server dan ook.";
"about.principles.decentralization.title" = "Decentralisatie";
"about.principles.decentralization.desc" = "Geen centrale autoriteit, geen enkel storingspunt. Macht verdeeld over het netwerk.";
"about.principles.sovereignty.title" = "Soevereiniteit";
"about.principles.sovereignty.desc" = "Jij hebt controle over je identiteit, je gegevens en je verbindingen. Geen bedrijven, geen surveillance.";
"about.principles.resilience.title" = "Veerkracht";
"about.principles.resilience.desc" = "Werkt bij internetblackouts, censuur of rampscenario's. Communicatie kan niet worden gestopt.";
"about.features.title" = "Technische functies";
"about.features.doubleRatchet.title" = "Double Ratchet-protocol";
"about.features.doubleRatchet.desc" = "End-to-end-versleuteling gebouwd op Double Ratchet met X3DH en AES-256-GCM. Als beide apparaten het ondersteunen, draait de sleuteluitwisseling er ook een hybride post-quantumlaag bij (ML-KEM-768 gecombineerd met X25519), zodat verkeer dat vandaag wordt onderschept niet leesbaar is voor een toekomstige quantumcomputer.";
"about.features.mesh.title" = "Multi-hop mesh-routering";
"about.features.mesh.desc" = "Berichten worden via vertrouwde peers doorgestuurd om hun bestemming te bereiken, zelfs offline.";
"about.features.fallback.title" = "Hybride cloud-fallback";
"about.features.fallback.desc" = "Eerst de mesh, zonder enige server. Bereikt die je contact niet, dan gaat het bericht via onze eigen relay, die het versleuteld opslaat en niet kan lezen.";
"about.features.identity.title" = "Cryptografische identiteit";
"about.features.identity.desc" = "Je identiteit is een Curve25519-sleutelpaar dat op je eigen apparaat wordt gegenereerd. Niets om te registreren, niets om in beslag te nemen.";
"about.features.ordering.title" = "Verwerking in willekeurige volgorde";
"about.features.ordering.desc" = "Geavanceerde berichtbuffering verwerkt netwerkchaos soepel.";
"about.features.media.title" = "Versleutelde media";
"about.features.media.desc" = "Verstuur foto's en video's met AES-256-GCM-versleuteling, alleen ontsleutelbaar door de ontvanger.";
"about.features.qr.title" = "QR-code koppelen";
"about.features.qr.desc" = "Scan om te verifiëren en voeg contacten toe met cryptografische veiligheidsnummers.";
"about.features.serverless.title" = "Serverloze architectuur";

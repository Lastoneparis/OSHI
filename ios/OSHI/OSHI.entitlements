<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.external-accessory.wireless-configuration</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <!-- ⚠️ ORDER IS LOAD-BEARING. The FIRST entry is the default access group
             for every keychain write that does not name one. The app's own group
             stays first so adding this entitlement changes nothing for the ~30
             existing call sites; only KeychainHelper.sharedKeys move, and only
             through migrateSharedItems(), which copies and never deletes. -->
        <string>$(AppIdentifierPrefix)Moriceau-lab.Genesis</string>
        <string>$(AppIdentifierPrefix)Moriceau-lab.Genesis.shared</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.Moriceau-lab.Genesis</string>
    </array>
    <key>aps-environment</key>
    <string>production</string>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:oshi-messenger.com</string>
        <string>applinks:oshi-messenger.org</string>
    </array>
</dict>
</plist>

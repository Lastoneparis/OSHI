"info.mesh.title" = "Mesh-netværk";
"info.mesh.section.about" = "OM";
"info.mesh.section.features" = "FUNKTIONER";
"info.mesh.section.tips" = "TIPS";
"info.mesh.what_title" = "Hvad er Mesh?";
"info.mesh.what_description" = "Mesh-netværk skaber direkte forbindelser mellem nærliggende enheder ved hjælp af Bluetooth og WiFi, og giver mulighed for at sende beskeder uden internet.";
"info.mesh.range_title" = "Rækkevidde";
"info.mesh.range_description" = "Opretter forbindelse til enheder inden for ca. 30-100 meter afhængigt af forholdene.";
"info.mesh.connection_title" = "Forbindelse";
"info.mesh.connection_description" = "Beskeder hopper mellem tilsluttede enheder for at nå deres destination.";
"info.mesh.encryption_title" = "Sikkerhed";
"info.mesh.encryption_description" = "Beskeder, der videresendes mellem iPhones over mesh-netværket, forbliver ende-til-ende-krypterede, så de enheder, der videresender dem, kun ser krypteret tekst. Broen til Android-enheder og til Meshtastic LoRa-radioer tilføjer ingen kryptering i sig selv, så betragt ikke de forbindelser som private.";
"info.mesh.tip1" = "Hold dig tæt på andre OSHI-brugere for bedst mulig forbindelse";
"info.mesh.tip2" = "Aktivér både Bluetooth og WiFi for optimal rækkevidde";
"info.mesh.tip3" = "iPhone-til-iPhone-videresendelser ser kun krypteret tekst; Android- og LoRa-broerne krypterer ikke";
"info.mesh.disclaimer_title" = "Før du stoler på det";
"info.mesh.disclaimer_description" = "Offline-mesh har kort rækkevidde. Begge telefoner skal have OSHI åben for at finde hinanden, omkring 100 m fra hinanden i det fri og betydeligt mindre gennem vægge. Det når kun længere, når andre i nærheden også har OSHI åben og kan sende beskeden videre. Hvis ingen er inden for rækkevidde, sender OSHI i stedet over internettet.";

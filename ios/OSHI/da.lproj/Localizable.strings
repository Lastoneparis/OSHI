/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Send bitcoin i en chat";
"guide.cashu.s1" = "OSHI har ingen wallet og opbevarer aldrig dine penge. Den fragter et Cashu-token — ecash dækket af bitcoin — på samme måde som den fragter et billede.";
"guide.cashu.s2" = "Du skal først have en Cashu-wallet. eNuts, Minibits eller cashu.me i en browser: alle gratis og klar på cirka et minut.";
"guide.cashu.s3" = "Vælg et mint i walletten og læg lidt penge ind via Lightning. Et par hundrede sats er rigeligt til at prøve.";
"guide.cashu.s4" = "Lav et token: tryk Send i walletten, indtast et beløb og kopiér. Du får en lang tekstlinje, der begynder med cashuB. Den tekst ER pengene.";
"guide.cashu.s6" = "Modtageren trykker Indløs, og pengene lander i deres wallet. Et token sendt til dig ser ens ud: tryk Indløs. OSHI er kun kuverten.";
"guide.cashu.s5" = "Skriv / i beskedfeltet i chatten, vælg /pay og indsæt tokenet. OSHI viser beløbet, før det sendes, så du kan kontrollere det.";
"guide.cashu.sub" = "Cashu-ecash — OSHI opbevarer aldrig dine penge";
"guide.cashu.warning" = "Et Cashu-token er kontanter. Alle, der får teksten, kan bruge den, og den, der indløser først, beholder den — send den derfor kun til den person, du mener. OSHI kan ikke spørge mintet, om et token allerede er brugt: det er først dine penge, når din egen wallet indløser det.";

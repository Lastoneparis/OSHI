/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Om";
"about.tagline" = "Den suveræne messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Sikker";
"about.tag.decentralized" = "Decentraliseret";
"about.vision.title" = "Visionen";
"about.vision.paragraph1" = "OSHI er ikke bare en messenger — det er en **kommunikationsprotokol for digital frihed**. Bygget på principper om suverænitet, privatliv og modstandsdygtighed.";
"about.vision.paragraph2" = "Når nogen er inden for rækkevidde, fungerer OSHI **helt uden internet og uden nogen server** og sender beskeder via et **peer-to-peer mesh-netværk** over direkte Bluetooth/Wi-Fi-forbindelser eller relæer med flere hop. Er ingen inden for rækkevidde, falder den tilbage på vores relæ, så beskeden alligevel når frem.";
"about.vision.paragraph3" = "Hver besked er beskyttet af **Double Ratchet** med **X3DH**-nøgleudveksling og **AES-256-GCM** — samme konstruktion som Signal bruger — og det holder også gennem offline-relæer og levering i vilkårlig rækkefølge.";
"about.principles.title" = "Kerneprincipper";
"about.principles.privacy.title" = "Privatliv som standard";
"about.principles.privacy.desc" = "Intet telefonnummer, ingen e-mail, ingen konto, ingen sporing. Beskeder sendt over mesh-netværket efterlader overhovedet intet på nogen server.";
"about.principles.decentralization.title" = "Decentralisering";
"about.principles.decentralization.desc" = "Ingen central myndighed, intet enkelt fejlpunkt. Magt fordelt på tværs af netværket.";
"about.principles.sovereignty.title" = "Suverænitet";
"about.principles.sovereignty.desc" = "Du kontrollerer din identitet, dine data og dine forbindelser. Ingen virksomheder, ingen overvågning.";
"about.principles.resilience.title" = "Modstandsdygtighed";
"about.principles.resilience.desc" = "Fungerer ved internetafbrydelser, censur eller katastrofescenarier. Kommunikation kan ikke stoppes.";
"about.features.title" = "Tekniske funktioner";
"about.features.doubleRatchet.title" = "Double Ratchet-protokol";
"about.features.doubleRatchet.desc" = "Ende-til-ende-kryptering bygget på Double Ratchet med X3DH og AES-256-GCM. Når begge enheder understøtter det, kører nøgleudvekslingen også et hybridt postkvantelag (ML-KEM-768 kombineret med X25519), så trafik, der opsnappes i dag, ikke kan læses af en fremtidig kvantecomputer.";
"about.features.mesh.title" = "Multi-hop mesh-routing";
"about.features.mesh.desc" = "Beskeder relæes via betroede peers for at nå deres destination, selv offline.";
"about.features.fallback.title" = "Hybrid cloud-fallback";
"about.features.fallback.desc" = "Mesh først, helt uden server. Hvis det ikke kan nå din kontakt, går beskeden gennem vores eget relay, som gemmer den krypteret og ikke kan læse den.";
"about.features.identity.title" = "Kryptografisk identitet";
"about.features.identity.desc" = "Din identitet er et Curve25519-nøglepar, der genereres på din egen enhed. Intet at registrere, intet at beslaglægge.";
"about.features.ordering.title" = "Håndtering af levering i forkert rækkefølge";
"about.features.ordering.desc" = "Avanceret beskedbuffering håndterer netværkskompleksitet elegant.";
"about.features.media.title" = "Krypterede medier";
"about.features.media.desc" = "Send fotos og videoer med AES-256-GCM-kryptering, kun dekrypteret af modtageren.";
"about.features.qr.title" = "QR-kode-parring";
"about.features.qr.desc" = "Scan for at verificere og tilføje kontakter med kryptografiske sikkerhedsnumre.";
"about.features.serverless.title" = "Serverløs arkitektur";
"about.features.serverless.desc" = "Ingen brugerkonti, intet telefonnummer, ingen e-mail, ingen dataindsamling, ingen sporing.";
"about.howItWorks.title" = "Sådan fungerer det";
"about.howItWorks.step1.title" = "Generér din identitet";
"about.howItWorks.step1.desc" = "Opret en kryptografisk identitet, der bliver din unikke, verificerbare identitet.";
"about.howItWorks.step2.title" = "Opret forbindelse til peers";

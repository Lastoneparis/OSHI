"peers.info.header" = "Mesh-netværk";
"peers.info.what.title" = "Hvad er mesh-netværk?";
"peers.info.what.description" = "Mesh-netværk giver din enhed mulighed for at kommunikere med nærliggende enheder uden internet. Beskeder kan hoppe gennem flere enheder for at nå deres destination.";
"peers.info.how.title" = "Sådan fungerer det";
"peers.info.how.description" = "Din enhed bruger Bluetooth og WiFi Direct til at oprette forbindelse til nærliggende peers. Når du sender en besked, kan den rejse gennem mesh-netværket for at nå modtageren, selv hvis de ikke er direkte forbundet til dig.";
"peers.info.control.title" = "Manuel forbindelseskontrol";
"peers.info.control.description" = "Tryk på en forbundet peer for midlertidigt at afbryde forbindelsen. De genopretter ikke forbindelsen, før du trykker på dem igen eller genåbner appen. Dette er nyttigt, hvis du vil bruge cloud-beskeder i stedet for mesh til en bestemt peer.";
"peers.info.privacy.title" = "Privatliv og sikkerhed";
"peers.info.privacy.description" = "Når en besked hopper mellem iPhones, ser de enheder, der videresender den, kun krypteret tekst og kan ikke læse den. Broen til Android-enheder og til Meshtastic LoRa-radioer tilføjer ingen kryptering i sig selv.";
"peers.info.range.title" = "Rækkevidde og forbindelse";
"peers.info.range.description" = "Bluetooth: ~9 m (30 fod)\nWiFi Direct: ~60 m (200 fod)\n\nJo flere enheder i netværket, jo længere kan dine beskeder nå!";
"peers.info.best_practices.title" = "Bedste praksis";
"peers.info.best_practices.description" = "• Hold både 'Gør synlig' og 'Find peers' aktiveret\n• Tillad Bluetooth- og lokalt netværk-tilladelser\n• Vær inden for rækkevidde af andre brugere for bedste resultater\n• Beskeder falder automatisk tilbage til cloud, når mesh ikke er tilgængeligt";


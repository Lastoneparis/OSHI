/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI er en samarbejdende krypteret beskedapp. Uden internet hopper beskeder fra telefon til telefon via folk i nærheden, der har OSHI åben. Lad os vise dig rundt.";
"guide_messages_tab_desc" = "Dine private samtaler vises her. Foretag krypterede stemmeopkald ved at trykke på en samtale. Beskeder og opkald ankommer kun, når appen har været åben i 2+ sekunder – dette er designet med henblik på sikkerhed.";
"guide_groups_tab_desc" = "Opret private grupper eller tilmeld dig offentlige i nærheden. Opdag grupper inden for mesh-rækkevidden, cirka 100 m, og længere væk når andre videresender. Hold appen åben for at opdage grupper omkring dig!";
"guide_new_tab_desc" = "Start en ny samtale her. Scan en kontakts QR-kode eller indsæt deres offentlige nøgle. Ingen telefonnumre, ingen konti – bare kryptografiske nøgler.";
"guide_settings_tab_desc" = "Din kryptoidentitet befinder sig her. Del din QR-kode eller offentlige nøgle med andre, så de kan sende dig beskeder. Du kan også aktivere biometrisk lås for ekstra sikkerhed.";
"guide_collaborative_desc" = "OSHI er samarbejdende: når du holder appen åben, hjælper din enhed med at videresende beskeder for andre i nærheden. I krisesituationer (krig, internetafbrydelse) skaber dette et robust netværk. Hver telefon rækker omkring 100 m, så jo flere der har OSHI åben, desto længere kan beskeder rejse.";
"guide_complete_desc" = "Alt er klart! Husk: hold OSHI åben for at modtage beskeder og hjælpe andre med at kommunikere i nødsituationer. Velkommen til netværket!";


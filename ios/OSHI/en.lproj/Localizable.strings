"info.mesh.encryption_title" = "Security";
"info.mesh.encryption_description" = "Messages relayed between iPhones over the mesh stay end-to-end encrypted, so relaying devices only ever see ciphertext. The bridge to Android devices and to Meshtastic LoRa radios adds no encryption of its own, so do not treat those links as private.";
"info.mesh.tip1" = "Stay close to other OSHI users for best connectivity";

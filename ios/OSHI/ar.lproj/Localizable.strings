/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "إرسال بيتكوين في محادثة";
"guide.cashu.s1" = "لا تملك OSHI محفظة ولا تحتفظ بأموالك أبدًا. إنها تحمل رمز Cashu — نقدًا إلكترونيًا مغطى بالبيتكوين — كما تحمل صورة.";
"guide.cashu.s2" = "تحتاج أولًا إلى محفظة Cashu. مثل eNuts أو Minibits أو cashu.me في المتصفح: كلها مجانية وتجهز في دقيقة تقريبًا.";
"guide.cashu.s3" = "في المحفظة اختر mint وأضف مبلغًا صغيرًا عبر Lightning. بضع مئات من الساتوشي تكفي للتجربة.";
"guide.cashu.s4" = "أنشئ رمزًا: في المحفظة اضغط إرسال، أدخل المبلغ، ثم انسخ. ستحصل على سطر نصي طويل يبدأ بـ cashuB. هذا النص هو المال نفسه.";
"guide.cashu.s6" = "يضغط المستلم على استرداد فيصل المال إلى محفظته. والرمز المُرسل إليك يظهر بالشكل نفسه: اضغط استرداد. OSHI ليست إلا المظروف.";
"guide.cashu.s5" = "في المحادثة اكتب / في حقل الرسالة، اختر /pay، ثم الصق الرمز. تعرض OSHI المبلغ قبل الإرسال لتتحقق منه.";
"guide.cashu.sub" = "نقد Cashu الإلكتروني — OSHI لا تحتفظ بأموالك أبدًا";
"guide.cashu.warning" = "رمز Cashu نقد. أي شخص يحصل على النص يمكنه إنفاقه، ومن يستردّه أولًا يحتفظ به — فأرسله إلى الشخص المقصود فقط. لا تستطيع OSHI أن تسأل mint إن كان الرمز قد أُنفق مسبقًا: لا يصبح مالك إلا عندما تستردّه محفظتك أنت.";
"guide.cashu.learn_more" = "ما هو Cashu؟";

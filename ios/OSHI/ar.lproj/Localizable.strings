"about.navigationTitle" = "حول";
"about.tagline" = "تطبيق المراسلة السيادي";
"about.tag.offline" = "بدون اتصال";
"about.tag.secure" = "آمن";
"about.tag.decentralized" = "لامركزي";
"about.vision.title" = "الرؤية";
"about.vision.paragraph1" = "OSHI ليس مجرد تطبيق مراسلة — إنه **بروتوكول اتصال للحرية الرقمية**. مبني على مبادئ السيادة والخصوصية والمرونة.";
"about.vision.paragraph2" = "عندما يكون أحد ضمن النطاق، يعمل OSHI **بلا إنترنت وبلا أي خادم على الإطلاق**، ويوجّه الرسائل عبر **شبكة شبكية بين الأقران** من خلال روابط Bluetooth/Wi-Fi مباشرة أو مرحّلات متعددة القفزات. وعندما لا يكون أحد ضمن النطاق، يلجأ إلى مرحّلنا كي تصل الرسالة رغم ذلك.";
"about.vision.paragraph3" = "كل رسالة محمية بواسطة **Double Ratchet** مع تبادل المفاتيح **X3DH** والتشفير **AES-256-GCM** — البنية نفسها التي يستخدمها Signal — ويظل ذلك قائمًا عبر المرحّلات دون اتصال والتسليم غير المرتّب.";
"about.principles.title" = "المبادئ الأساسية";
"about.principles.privacy.title" = "الخصوصية افتراضياً";
"about.principles.privacy.desc" = "لا رقم هاتف، ولا بريد إلكتروني، ولا حساب، ولا تتبّع. الرسائل المُرسلة عبر الشبكة الشبكية لا تترك أي شيء على أي خادم إطلاقًا.";
"about.principles.decentralization.title" = "اللامركزية";
"about.principles.decentralization.desc" = "لا سلطة مركزية، لا نقطة فشل واحدة. السلطة موزعة عبر الشبكة.";
"about.principles.sovereignty.title" = "السيادة";
"about.principles.sovereignty.desc" = "أنت تتحكم في هويتك وبياناتك واتصالاتك. لا شركات، لا مراقبة.";
"about.principles.resilience.title" = "المرونة";
"about.principles.resilience.desc" = "يعمل في انقطاعات الإنترنت أو الرقابة أو سيناريوهات الكوارث. لا يمكن إيقاف الاتصال.";
"about.features.title" = "الميزات التقنية";
"about.features.doubleRatchet.title" = "بروتوكول Double Ratchet";
"about.features.doubleRatchet.desc" = "تشفير من طرف إلى طرف مبني على Double Ratchet مع X3DH وAES-256-GCM. وعندما يدعم الجهازان كلاهما ذلك، يشغّل اتفاق المفاتيح أيضاً طبقة هجينة مقاومة للحوسبة الكمومية (ML-KEM-768 مدمجاً مع X25519)، فلا يستطيع حاسوب كمومي مستقبلي قراءة حركة البيانات المُلتقطة اليوم.";
"about.features.mesh.title" = "توجيه شبكي متعدد القفزات";
"about.features.mesh.desc" = "تنتقل الرسائل عبر أقران موثوقين للوصول إلى وجهتها، حتى بدون اتصال.";
"about.features.fallback.title" = "احتياطي سحابي هجين";
"about.features.fallback.desc" = "الشبكة الشبكية أولاً، بدون أي خادم. وإذا تعذّر الوصول إلى جهة اتصالك عبرها، تمرّ الرسالة عبر مُرحِّلنا الخاص الذي يخزّنها مشفّرة ولا يستطيع قراءتها.";
"about.features.identity.title" = "الهوية التشفيرية";
"about.features.identity.desc" = "هويتك هي زوج مفاتيح Curve25519 يُولَّد على جهازك. لا شيء لتسجيله، ولا شيء لمصادرته.";
"about.features.ordering.title" = "معالجة غير مرتبة";
"about.features.ordering.desc" = "تخزين مؤقت متقدم للرسائل يتعامل مع فوضى الشبكة بأناقة.";
"about.features.media.title" = "وسائط مشفّرة";
"about.features.media.desc" = "أرسل الصور والفيديوهات بتشفير AES-256-GCM، تُفك التشفير فقط من قبل المستلم.";
"about.features.qr.title" = "إقران رمز QR";
"about.features.qr.desc" = "امسح للتحقق وإضافة جهات اتصال مع أرقام أمان تشفيرية.";
"about.features.serverless.title" = "بنية بدون خوادم";
"about.howItWorks.title" = "كيف يعمل";
"about.howItWorks.step1.title" = "إنشاء هويتك";
"about.howItWorks.step1.desc" = "أنشئ هوية تشفيرية تصبح هويتك الفريدة والقابلة للتحقق.";
"about.howItWorks.step2.title" = "الاتصال بالأقران";
"about.howItWorks.step2.desc" = "اكتشف الأجهزة القريبة عبر البلوتوث أو شبكة WiFi الشبكية، أو امسح رموز QR لإضافة جهات اتصال موثوقة.";
"about.howItWorks.step3.title" = "إرسال رسائل مشفّرة";
"about.howItWorks.step3.desc" = "يتم تشفير الرسائل بـ Double Ratchet وإرسالها مباشرة إلى الأقران أو ترحيلها عبر الشبكة الشبكية.";
"about.howItWorks.step4.title" = "الاحتياطي إلى السحابة";
"about.howItWorks.step4.desc" = "إذا تعذّر على الشبكة الشبكية الوصول إلى جهة اتصالك، تُحفظ الرسالة المشفّرة على خادم الترحيل الخاص بنا حتى يتم تسليمها. المُرحِّل لا يستطيع قراءتها، ولا تُنشر أبداً على أي شبكة عامة.";
"about.howItWorks.step5.title" = "مفاتيح تتغيّر باستمرار";
"about.howItWorks.step5.desc" = "كل رسالة تحصل على مفتاحها الخاص، والسلسلة تتقدّم إلى الأمام بعد كل إرسال.";
"about.useCases.title" = "مصمم لـ";
"about.useCases.journalists.title" = "الصحفيون";
"about.useCases.journalists.desc" = "تواصل آمن في بيئات معادية";
"about.useCases.activists.title" = "الناشطون";
"about.useCases.activists.desc" = "التنظيم بدون مراقبة أو رقابة";
"about.useCases.emergency.title" = "الاستجابة للطوارئ";
"about.useCases.emergency.desc" = "التنسيق عند فشل البنية التحتية";
"about.useCases.travelers.title" = "المسافرون";
"about.useCases.travelers.desc" = "البقاء على اتصال بدون تجوال أو إنترنت";
"about.useCases.privacy.title" = "دعاة الخصوصية";
"about.useCases.privacy.desc" = "التواصل بدون وسطاء من الشركات";
"about.useCases.crypto.title" = "مستخدمو العملات المشفرة";
"about.useCases.crypto.desc" = "تكامل هوية أصلي للتنسيق الآمن";
"about.openSource.title" = "مفتوح المصدر والشفافية";
"about.openSource.paragraph1" = "OSHI **مفتوح المصدر بنسبة 100٪**، مبني مع الشفافية وقابلية التدقيق في جوهره. كل سطر من الكود عام وقابل للتحقق.";
"about.openSource.paragraph2" = "نؤمن أن أدوات الخصوصية يجب أن تكون مفتوحة لتكون موثوقة. لا أبواب خلفية، لا قياس عن بُعد مخفي، لا خوارزميات مملوكة.";
"about.openSource.contribute" = "مساهمات المجتمع مرحب بها!";
"about.openSource.viewCode" = "عرض الكود المصدري على GitHub";
"about.philosophy.title" = "الفلسفة";

   ============================================ */

"about.navigationTitle" = "Quant a";
"about.tagline" = "El missatger sobirà";
"about.tag.offline" = "Fora de línia";
"about.tag.secure" = "Segur";
"about.tag.decentralized" = "Descentralitzat";
"about.vision.title" = "La visió";
"about.vision.paragraph1" = "OSHI no és només un missatger: és un **protocol de comunicació per a la llibertat digital**. Construït sobre els principis de sobirania, privadesa i resiliència.";
"about.vision.paragraph2" = "Quan algú és a l'abast, OSHI funciona **sense Internet i sense cap servidor**, encaminant els missatges per una **xarxa mallada entre iguals** mitjançant enllaços Bluetooth/Wi-Fi directes o relés de múltiples salts. Quan no hi ha ningú a l'abast, recorre al nostre relé perquè el missatge arribi igualment.";
"about.vision.paragraph3" = "Cada missatge està protegit pel **Double Ratchet** amb acord de claus **X3DH** i **AES-256-GCM** — la mateixa construcció que utilitza Signal — i es manté a través de relés fora de línia i lliuraments desordenats.";
"about.principles.title" = "Principis bàsics";
"about.principles.privacy.title" = "Privadesa per defecte";
"about.principles.privacy.desc" = "Sense número de telèfon, sense correu electrònic, sense compte, sense seguiment. Els missatges enviats per la xarxa mallada no deixen absolutament res a cap servidor.";
"about.principles.decentralization.title" = "Descentralització";
"about.principles.decentralization.desc" = "Sense autoritat central, sense cap punt únic de fallada. Poder distribuït per tota la xarxa.";
"about.principles.sovereignty.title" = "Sobirania";
"about.principles.sovereignty.desc" = "Tu controles la teva identitat, les teves dades i les teves connexions. Sense corporacions, sense vigilància.";
"about.principles.resilience.title" = "Resiliència";
"about.principles.resilience.desc" = "Funciona en talls d'internet, censura o escenaris de desastre. La comunicació no es pot aturar.";
"about.features.title" = "Característiques tècniques";
"about.features.doubleRatchet.title" = "Protocol Double Ratchet";
"about.features.doubleRatchet.desc" = "Xifratge d'extrem a extrem basat en Double Ratchet amb X3DH i AES-256-GCM. Quan tots dos dispositius ho admeten, l'acord de claus també executa una capa híbrida postquàntica (ML-KEM-768 combinat amb X25519), de manera que el trànsit capturat avui no serà llegible per un futur ordinador quàntic.";
"about.features.mesh.title" = "Encaminament de malla de salts múltiples";
"about.features.mesh.desc" = "Els missatges es transmeten a través d'iguals de confiança per arribar a la seva destinació, fins i tot fora de línia.";
"about.features.fallback.title" = "Reserva híbrida al núvol";
"about.features.fallback.desc" = "Primer la malla, sense cap servidor. Si així no s'arriba al teu contacte, el missatge passa pel nostre propi relé, que el desa xifrat i no el pot llegir.";
"about.features.identity.title" = "Identitat criptogràfica";
"about.features.identity.desc" = "La teva identitat és un parell de claus Curve25519 generat al teu dispositiu. Res per registrar, res per confiscar.";
"about.features.ordering.title" = "Gestió de desordenat";
"about.features.ordering.desc" = "L'emmagatzematge en memòria intermèdia avançada de missatges gestiona el caos de la xarxa amb elegància.";
"about.features.media.title" = "Contingut xifrat";
"about.features.media.desc" = "Envia fotos i vídeos amb xifratge AES-256-GCM, desxifrats només pel destinatari.";
"about.features.qr.title" = "Aparellament amb codi QR";
"about.features.qr.desc" = "Escaneja per verificar i afegir contactes amb números de seguretat criptogràfics.";
"about.features.serverless.title" = "Arquitectura sense servidor";
"about.features.serverless.desc" = "Sense comptes d'usuari, sense número de telèfon, sense correu electrònic, sense recopilació de dades, sense seguiment.";
"about.howItWorks.title" = "Com funciona";
"about.howItWorks.step1.title" = "Genera la teva identitat";
"about.howItWorks.step1.desc" = "Crea una identitat criptogràfica que esdevé la teva identitat única i verificable.";
"about.howItWorks.step2.title" = "Connecta't amb iguals";
"about.howItWorks.step2.desc" = "Descobreix dispositius propers mitjançant Bluetooth o malla Wi-Fi, o escaneja codis QR per afegir contactes de confiança.";
"about.howItWorks.step3.title" = "Envia missatges xifrats";
"about.howItWorks.step3.desc" = "Els missatges es xifren amb Double Ratchet i s'envien directament als iguals o es transmeten a través de la malla.";
"about.howItWorks.step4.title" = "Reserva al núvol";
"about.howItWorks.step4.desc" = "Si la malla no arriba al teu contacte, el missatge xifrat es guarda al nostre propi servidor de relé fins que s'entrega. El relé no el pot llegir i mai no es publica en cap xarxa pública.";
"about.howItWorks.step5.title" = "Claus que no paren de canviar";
"about.howItWorks.step5.desc" = "Cada missatge rep la seva pròpia clau, i la cadena avança després de cada enviament.";
"about.useCases.title" = "Creat per a";

/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI és un missatger xifrat col·laboratiu. Sense internet, els missatges salten de telèfon a telèfon a través de persones properes que tenen OSHI obert. Et fem una visita guiada.";
"guide_messages_tab_desc" = "Les teves converses privades apareixen aquí. Fes trucades de veu xifrades tocant qualsevol conversa. Els missatges i les trucades només arriben quan l'app està oberta 2+ segons; això és intencionat per seguretat.";
"guide_groups_tab_desc" = "Crea grups privats o uneix-te a grups públics propers. Descobreix grups dins l'abast de la malla, uns 100 m, i més lluny quan altres retransmeten. Mantingues l'app oberta per detectar grups al teu voltant!";
"guide_new_tab_desc" = "Inicia una conversa nova aquí. Escaneja el codi QR d'un contacte o enganxa la seva clau pública. Sense números de telèfon, sense comptes; només claus criptogràfiques.";
"guide_settings_tab_desc" = "La teva identitat criptogràfica viu aquí. Comparteix el teu codi QR o clau pública amb altres perquè et puguin enviar missatges. També pots activar el bloqueig biomètric per a més seguretat.";
"guide_collaborative_desc" = "OSHI és col·laboratiu: quan mantens l'app oberta, el teu dispositiu ajuda a retransmetre missatges per a altres persones properes. En situacions de crisi (guerra, tall d'internet), això crea una xarxa resilient. Cada telèfon arriba a uns 100 m, així que com més gent tingui OSHI obert, més lluny poden viatjar els missatges.";
"guide_complete_desc" = "Tot a punt! Recorda: mantingues OSHI obert per rebre missatges i ajudar altres persones a comunicar-se en emergències. Benvingut a la xarxa!";


"peers.info.what.title" = "Hva er mesh-nettverk?";
"peers.info.what.description" = "Mesh-nettverk lar enheten din kommunisere med enheter i nærheten uten internett. Meldinger kan hoppe gjennom flere enheter for å nå målet sitt.";
"peers.info.how.title" = "Slik fungerer det";
"peers.info.how.description" = "Enheten din bruker Bluetooth og Wi-Fi Direct for å koble til noder i nærheten. Når du sender en melding, kan den reise gjennom mesh-nettverket for å nå mottakeren, selv om de ikke er direkte koblet til deg.";

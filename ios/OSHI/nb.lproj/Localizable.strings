"info.mesh.what_title" = "Hva er mesh?";
"info.mesh.what_description" = "Mesh-nettverk oppretter direkte tilkoblinger mellom enheter i nærheten ved hjelp av Bluetooth og Wi-Fi, slik at meldinger kan sendes uten internett.";
"info.mesh.range_title" = "Rekkevidde";
"info.mesh.range_description" = "Kobler til enheter innenfor omtrent 30–100 meter avhengig av forholdene.";
"info.mesh.connection_title" = "Tilkobling";
"info.mesh.connection_description" = "Meldinger hopper mellom tilkoblede enheter for å nå målet sitt.";
"info.mesh.encryption_title" = "Sikkerhet";
"info.mesh.encryption_description" = "Meldinger som reléeres mellom iPhone-enheter over mesh-nettverket, forblir ende-til-ende-krypterte, så enhetene som reléerer dem ser bare kryptert tekst. Broen til Android-enheter og til Meshtastic LoRa-radioer legger ikke til egen kryptering, så ikke betrakt disse forbindelsene som private.";
"info.mesh.tip1" = "Hold deg nær andre OSHI-brukere for best tilkobling";
"info.mesh.tip2" = "Aktiver både Bluetooth og Wi-Fi for optimal rekkevidde";
"info.mesh.tip3" = "iPhone-til-iPhone-reléer ser bare kryptert tekst; Android- og LoRa-broene krypterer ikke";
"info.mesh.disclaimer_title" = "Før du stoler på det";
"info.mesh.disclaimer_description" = "Offline-mesh har kort rekkevidde. Begge telefonene må ha OSHI åpen for å finne hverandre, omtrent 100 m fra hverandre i åpent terreng og betydelig mindre gjennom vegger. Det når lenger bare når andre i nærheten også har OSHI åpen og kan sende meldingen videre. Hvis ingen er innenfor rekkevidde, sender OSHI over internett i stedet.";

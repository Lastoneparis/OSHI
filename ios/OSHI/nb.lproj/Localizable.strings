"peers.info.control.description" = "Trykk på en tilkoblet node for å koble fra midlertidig. De kobler ikke til igjen før du trykker på dem på nytt eller åpner appen igjen. Dette er nyttig hvis du vil bruke skymeldinger i stedet for mesh for en bestemt node.";
"peers.info.privacy.title" = "Personvern og sikkerhet";
"peers.info.privacy.description" = "Når en melding hopper mellom iPhone-enheter, ser enhetene som reléerer den bare kryptert tekst og kan ikke lese den. Broen til Android-enheter og til Meshtastic LoRa-radioer legger ikke til egen kryptering.";
"peers.info.range.title" = "Rekkevidde og tilkobling";
"peers.info.range.description" = "Bluetooth: ~30 fot (10 m)\nWi-Fi Direct: ~200 fot (60 m)\n\nJo flere enheter i nettverket, desto lenger kan meldingene dine nå!";
"peers.info.best_practices.title" = "Anbefalte fremgangsmåter";
"peers.info.best_practices.description" = "• Hold både «Gjør synlig» og «Oppdag noder» aktivert\n• Tillat Bluetooth- og Lokalt nettverk-tillatelser\n• Hold deg innenfor rekkevidde av andre brukere for best resultat\n• Meldinger faller automatisk tilbake til skyen når mesh er utilgjengelig";


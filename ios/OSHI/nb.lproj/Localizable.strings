/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "Om";
"about.tagline" = "Den suverene Messenger";
"about.tag.offline" = "Frakoblet";
"about.tag.secure" = "Sikker";
"about.tag.decentralized" = "Desentralisert";
"about.vision.title" = "Visjonen";
"about.vision.paragraph1" = "OSHI er ikke bare en messenger – det er en **kommunikasjonsprotokoll for digital frihet**. Bygd på prinsipper om suverenitet, personvern og motstandsdyktighet.";
"about.vision.paragraph2" = "Når noen er innen rekkevidde, fungerer OSHI **helt uten internett og uten noen server** og sender meldinger via et **node-til-node mesh-nettverk** over direkte Bluetooth/Wi-Fi-forbindelser eller reléer med flere hopp. Er ingen innen rekkevidde, faller den tilbake på reléet vårt slik at meldingen likevel kommer frem.";
"about.vision.paragraph3" = "Hver melding er beskyttet av **Double Ratchet** med **X3DH**-nøkkelutveksling og **AES-256-GCM** — samme konstruksjon som Signal bruker — og det holder også gjennom frakoblede reléer og levering i vilkårlig rekkefølge.";
"about.principles.title" = "Kjerneprinsipper";
"about.principles.privacy.title" = "Personvern som standard";
"about.principles.privacy.desc" = "Ingen telefonnummer, ingen e-post, ingen konto, ingen sporing. Meldinger sendt over mesh-nettverket etterlater ingenting som helst på noen server.";
"about.principles.decentralization.title" = "Desentralisering";
"about.principles.decentralization.desc" = "Ingen sentral myndighet, ingen enkelt feilpunkt. Makten fordelt over hele nettverket.";
"about.principles.sovereignty.title" = "Suverenitet";
"about.principles.sovereignty.desc" = "Du kontrollerer identiteten din, dataene dine og forbindelsene dine. Ingen selskaper, ingen overvåking.";
"about.principles.resilience.title" = "Motstandsdyktighet";
"about.principles.resilience.desc" = "Fungerer ved internettbrudd, sensur eller katastrofescenarioer. Kommunikasjon kan ikke stoppes.";
"about.features.title" = "Tekniske funksjoner";
"about.features.doubleRatchet.title" = "Double Ratchet-protokoll";
"about.features.doubleRatchet.desc" = "Ende-til-ende-kryptering bygget på Double Ratchet med X3DH og AES-256-GCM. Når begge enhetene støtter det, kjører nøkkelutvekslingen også et hybrid postkvantelag (ML-KEM-768 kombinert med X25519), slik at trafikk som fanges opp i dag, ikke kan leses av en framtidig kvantedatamaskin.";
"about.features.mesh.title" = "Flerhopps mesh-ruting";
"about.features.mesh.desc" = "Meldinger reléeres gjennom betrodde noder for å nå målet, selv frakoblet.";
"about.features.fallback.title" = "Hybrid sky-reserve";
"about.features.fallback.desc" = "Mesh først, helt uten server. Hvis det ikke når fram til kontakten din, går meldingen gjennom vårt eget relé, som lagrer den kryptert og ikke kan lese den.";
"about.features.identity.title" = "Kryptografisk identitet";
"about.features.identity.desc" = "Identiteten din er et Curve25519-nøkkelpar som genereres på din egen enhet. Ingenting å registrere, ingenting å beslaglegge.";
"about.features.ordering.title" = "Håndtering av feil rekkefølge";
"about.features.ordering.desc" = "Avansert meldingsbufring håndterer nettverkskaos på en elegant måte.";
"about.features.media.title" = "Kryptert medie";
"about.features.media.desc" = "Send bilder og videoer med AES-256-GCM-kryptering, dekryptert kun av mottakeren.";
"about.features.qr.title" = "QR-kodesammenkobling";
"about.features.qr.desc" = "Skann for å verifisere og legge til kontakter med kryptografiske sikkerhetsnumre.";
"about.features.serverless.title" = "Serverløs arkitektur";
"about.features.serverless.desc" = "Ingen brukerkontoer, ingen telefonnummer, ingen e-post, ingen datainnsamling, ingen sporing.";
"about.howItWorks.title" = "Slik fungerer det";
"about.howItWorks.step1.title" = "Generer identiteten din";

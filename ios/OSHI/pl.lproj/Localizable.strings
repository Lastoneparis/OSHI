/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "O aplikacji";
"about.tagline" = "Suwerenny komunikator";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Bezpieczny";
"about.tag.decentralized" = "Zdecentralizowany";
"about.vision.title" = "Wizja";
"about.vision.paragraph1" = "OSHI to nie tylko komunikator — to **protokół komunikacyjny dla cyfrowej wolności**. Zbudowany na zasadach suwerenności, prywatności i odporności.";
"about.vision.paragraph2" = "Gdy ktoś jest w zasięgu, OSHI działa **całkowicie bez internetu i bez żadnego serwera**, przesyłając wiadomości przez **sieć kratową peer-to-peer** za pomocą bezpośrednich połączeń Bluetooth/Wi-Fi lub przekaźników wieloskokowych. Gdy nikogo nie ma w zasięgu, korzysta z naszego przekaźnika, aby wiadomość mimo wszystko dotarła.";
"about.vision.paragraph3" = "Każda wiadomość jest chroniona przez **Double Ratchet** z uzgadnianiem kluczy **X3DH** i szyfrowaniem **AES-256-GCM** — tą samą konstrukcją, której używa Signal — i działa to również przez przekaźniki offline oraz przy dostarczaniu poza kolejnością.";
"about.principles.title" = "Główne zasady";
"about.principles.privacy.title" = "Prywatność domyślna";
"about.principles.privacy.desc" = "Bez numeru telefonu, bez adresu e-mail, bez konta, bez śledzenia. Wiadomości wysłane przez sieć kratową nie pozostawiają absolutnie niczego na żadnym serwerze.";
"about.principles.decentralization.title" = "Decentralizacja";
"about.principles.decentralization.desc" = "Brak centralnej władzy, brak pojedynczego punktu awarii. Moc rozłożona w sieci.";
"about.principles.sovereignty.title" = "Suwerenność";
"about.principles.sovereignty.desc" = "Kontrolujesz swoją tożsamość, dane i połączenia. Bez korporacji, bez inwigilacji.";
"about.principles.resilience.title" = "Odporność";
"about.principles.resilience.desc" = "Działa podczas awarii internetu, cenzury lub scenariuszy katastrof. Komunikacja nie może być zatrzymana.";
"about.features.title" = "Funkcje techniczne";
"about.features.doubleRatchet.title" = "Protokół Double Ratchet";
"about.features.doubleRatchet.desc" = "Szyfrowanie end-to-end oparte na Double Ratchet z X3DH i AES-256-GCM. Gdy oba urządzenia to obsługują, uzgadnianie kluczy uruchamia dodatkowo hybrydową warstwę postkwantową (ML-KEM-768 połączone z X25519), więc ruch przechwycony dzisiaj nie będzie czytelny dla przyszłego komputera kwantowego.";
"about.features.mesh.title" = "Wieloskokowe routing mesh";
"about.features.mesh.desc" = "Wiadomości przekazywane przez zaufanych peerów, aby dotrzeć do celu, nawet offline.";
"about.features.fallback.title" = "Hybrydowy fallback chmurowy";
"about.features.fallback.desc" = "Najpierw mesh, całkiem bez serwera. Jeśli tak nie da się dotrzeć do kontaktu, wiadomość przechodzi przez nasz własny relay, który przechowuje ją zaszyfrowaną i nie potrafi jej odczytać.";
"about.features.identity.title" = "Tożsamość kryptograficzna";
"about.features.identity.desc" = "Twoja tożsamość to para kluczy Curve25519 wygenerowana na Twoim urządzeniu. Nic do rejestrowania, nic do zajęcia.";
"about.features.ordering.title" = "Obsługa pozakolejowa";
"about.features.ordering.desc" = "Zaawansowane buforowanie wiadomości radzi sobie z chaosem sieciowym.";
"about.features.media.title" = "Zaszyfrowane media";
"about.features.media.desc" = "Wysyłaj zdjęcia i filmy z szyfrowaniem AES-256-GCM, odszyfrowane tylko przez odbiorcę.";
"about.features.qr.title" = "Parowanie przez kod QR";
"about.features.qr.desc" = "Skanuj, aby zweryfikować i dodać kontakty z kryptograficznymi numerami bezpieczeństwa.";
"about.features.serverless.title" = "Architektura bezserwerowa";
"about.howItWorks.title" = "Jak to działa";
"about.howItWorks.step1.title" = "Wygeneruj swoją tożsamość";
"about.howItWorks.step1.desc" = "Utwórz tożsamość kryptograficzną, która stanie się Twoją unikalną, weryfikowalną tożsamością.";
"about.howItWorks.step2.title" = "Połącz z peerami";
"about.howItWorks.step2.desc" = "Odkryj pobliskie urządzenia przez Bluetooth lub mesh WiFi, lub zeskanuj kody QR, aby dodać zaufane kontakty.";
"about.howItWorks.step3.title" = "Wysyłaj zaszyfrowane wiadomości";
"about.howItWorks.step3.desc" = "Wiadomości są szyfrowane Double Ratchet i wysyłane bezpośrednio do peerów lub przekazywane przez mesh.";
"about.howItWorks.step4.title" = "Fallback do chmury";
"about.howItWorks.step4.desc" = "Jeśli mesh nie dotrze do kontaktu, zaszyfrowana wiadomość czeka na dostarczenie na naszym własnym serwerze relay. Relay nie potrafi jej odczytać i nigdy nie trafia ona do żadnej publicznej sieci.";
"about.howItWorks.step5.title" = "Klucze, które wciąż się zmieniają";
"about.howItWorks.step5.desc" = "Każda wiadomość dostaje własny klucz, a łańcuch przesuwa się naprzód po każdym wysłaniu.";
"about.useCases.title" = "Dla kogo";
"about.useCases.journalists.title" = "Dziennikarze";
"about.useCases.journalists.desc" = "Bezpieczna komunikacja we wrogich środowiskach";
"about.useCases.activists.title" = "Aktywiści";
"about.useCases.activists.desc" = "Organizuj się bez inwigilacji i cenzury";
"about.useCases.emergency.title" = "Reagowanie kryzysowe";
"about.useCases.emergency.desc" = "Koordynuj gdy infrastruktura zawodzi";
"about.useCases.travelers.title" = "Podróżnicy";
"about.useCases.travelers.desc" = "Pozostań w kontakcie bez roamingu i internetu";
"about.useCases.privacy.title" = "Orędownicy prywatności";
"about.useCases.privacy.desc" = "Komunikuj się bez korporacyjnych pośredników";
"about.useCases.crypto.title" = "Użytkownicy crypto";
"about.useCases.crypto.desc" = "Natywna integracja tożsamości dla bezpiecznej koordynacji";
"about.openSource.title" = "Open source i przejrzystość";
"about.openSource.paragraph1" = "OSHI jest **w 100% open source**, zbudowany z przejrzystością i audytowalnością jako rdzeniem. Każda linia kodu jest publiczna i weryfikowalna.";
"about.openSource.paragraph2" = "Wierzymy, że narzędzia prywatności muszą być otwarte, aby można im było zaufać. Bez tylnych drzwi, bez ukrytej telemetrii, bez zastrzeżonych algorytmów.";
"about.openSource.contribute" = "Mile widziane wkłady społeczności!";
"about.openSource.viewCode" = "Zobacz kod źródłowy na GitHub";
"about.philosophy.title" = "Filozofia";
"about.philosophy.quote1" = "Komunikacja jest podstawowym prawem człowieka, a nie produktem do monetyzacji.";
"about.philosophy.quote2" = "Prywatność powinna być domyślna, a nie funkcja premium.";
"about.philosophy.quote3" = "Nikt nie powinien mieć władzy, by uciszyć Twój głos lub czytać Twoje myśli.";
"about.philosophy.quote4" = "Prawdziwa wolność wymaga narzędzi, których nie można kontrolować, cenzurować ani inwigilować.";

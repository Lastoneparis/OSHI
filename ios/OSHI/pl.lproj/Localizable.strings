/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI to współpracujący szyfrowany komunikator. Bez internetu wiadomości przeskakują z telefonu na telefon przez osoby w pobliżu, które mają otwarte OSHI. Pozwól, że ci pokażemy.";
"guide_messages_tab_desc" = "Twoje prywatne rozmowy pojawiają się tutaj. Wykonuj szyfrowane połączenia głosowe dotykając rozmowy. Wiadomości i połączenia przychodzą tylko gdy aplikacja jest otwarta przez 2+ sekundy - to celowe dla bezpieczeństwa.";
"guide_groups_tab_desc" = "Twórz prywatne grupy lub dołączaj do publicznych w pobliżu. Odkrywaj grupy w zasięgu mesh, około 100 m, i dalej, gdy inni przekazują dalej. Trzymaj aplikację otwartą, aby wykrywać grupy wokół siebie!";
"guide_new_tab_desc" = "Rozpocznij nową rozmowę tutaj. Zeskanuj kod QR kontaktu lub wklej jego klucz publiczny. Bez numerów telefonów, bez kont - tylko klucze kryptograficzne.";
"guide_settings_tab_desc" = "Twoja tożsamość krypto jest tutaj. Udostępnij swój kod QR lub klucz publiczny, aby inni mogli ci pisać. Możesz także włączyć blokadę biometryczną.";
"guide_collaborative_desc" = "OSHI jest współpracujący: gdy trzymasz aplikację otwartą, twoje urządzenie pomaga przekazywać wiadomości innych osób w pobliżu. W sytuacjach kryzysowych (wojna, brak internetu) tworzy to odporną sieć. Każdy telefon sięga około 100 m, więc im więcej osób ma otwarte OSHI, tym dalej mogą podróżować wiadomości.";
"guide_complete_desc" = "Wszystko gotowe! Pamiętaj: trzymaj OSHI otwarte, aby odbierać wiadomości i pomagać innym komunikować się w nagłych wypadkach. Witamy w sieci!";


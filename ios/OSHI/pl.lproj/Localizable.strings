/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Wyślij bitcoina w czacie";
"guide.cashu.s1" = "OSHI nie ma portfela i nigdy nie przechowuje twoich pieniędzy. Przenosi token Cashu — ecash zabezpieczony bitcoinem — tak samo jak przenosi zdjęcie.";
"guide.cashu.s2" = "Najpierw potrzebujesz portfela Cashu. eNuts, Minibits albo cashu.me w przeglądarce: wszystkie darmowe, konfiguracja zajmuje minutę.";
"guide.cashu.s3" = "W portfelu wybierz mennicę (mint) i wpłać trochę pieniędzy przez Lightning. Kilkaset satoshi w pełni wystarczy na próbę.";
"guide.cashu.s4" = "Utwórz token: w portfelu dotknij Wyślij, podaj kwotę i skopiuj. Otrzymasz długi wiersz tekstu zaczynający się od cashuB. Ten tekst JEST pieniędzmi.";
"guide.cashu.s6" = "Druga osoba dotyka Odbierz i pieniądze trafiają do jej portfela. Token przysłany tobie wygląda tak samo: dotknij Odbierz. OSHI jest tylko kopertą.";
"guide.cashu.s5" = "W czacie wpisz / w polu wiadomości, wybierz /pay i wklej token. OSHI pokaże kwotę przed wysłaniem, żebyś mógł ją sprawdzić.";
"guide.cashu.sub" = "Ecash Cashu — OSHI nigdy nie przechowuje twoich pieniędzy";
"guide.cashu.warning" = "Token Cashu to gotówka. Każdy, kto zdobędzie ten tekst, może go wydać, a kto pierwszy go odbierze, ten go zatrzyma — wysyłaj go więc tylko do właściwej osoby. OSHI nie może zapytać mennicy, czy token został już wydany: jest twój dopiero wtedy, gdy odbierze go twój własny portfel.";

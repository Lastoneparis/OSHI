/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "정보";
"about.tagline" = "주권적 메신저";
"about.tag.offline" = "오프라인";
"about.tag.secure" = "안전";
"about.tag.decentralized" = "탈중앙화";
"about.vision.title" = "비전";
"about.vision.paragraph1" = "OSHI는 단순한 메신저가 아닙니다 — **디지털 자유를 위한 통신 프로토콜**입니다. 주권, 프라이버시, 회복력의 원칙 위에 구축되었습니다.";
"about.vision.paragraph2" = "상대가 통신 범위 안에 있으면 OSHI는 **인터넷도 서버도 전혀 없이** 작동하며, 직접 연결된 Bluetooth/Wi-Fi 또는 다중 홉 중계를 통해 **P2P 메시 네트워크**로 메시지를 전달합니다. 범위 안에 아무도 없으면 저희 릴레이로 전환해 메시지가 그래도 도착하도록 합니다.";
"about.vision.paragraph3" = "모든 메시지는 **X3DH** 키 합의와 **AES-256-GCM**을 사용하는 **Double Ratchet**으로 보호되며, 이는 Signal이 사용하는 것과 동일한 구성입니다. 오프라인 중계나 순서가 뒤바뀐 전달에서도 그대로 유지됩니다.";
"about.principles.title" = "핵심 원칙";
"about.principles.privacy.title" = "기본적 프라이버시";
"about.principles.privacy.desc" = "전화번호도, 이메일도, 계정도, 추적도 없습니다. 메시 네트워크로 보낸 메시지는 어떤 서버에도 아무것도 남기지 않습니다.";
"about.principles.decentralization.title" = "탈중앙화";
"about.principles.decentralization.desc" = "중앙 권한 없음, 단일 장애 지점 없음. 네트워크 전반에 걸쳐 분산된 권력.";
"about.principles.sovereignty.title" = "주권";
"about.principles.sovereignty.desc" = "당신이 자신의 ID, 데이터, 연결을 제어합니다. 기업도 없고 감시도 없습니다.";
"about.principles.resilience.title" = "회복력";
"about.principles.resilience.desc" = "인터넷 차단, 검열, 재난 상황에서도 작동합니다. 통신을 막을 수 없습니다.";
"about.features.title" = "기술적 특징";
"about.features.doubleRatchet.title" = "Double Ratchet 프로토콜";
"about.features.doubleRatchet.desc" = "X3DH와 AES-256-GCM을 사용하는 Double Ratchet 기반의 종단 간 암호화입니다. 두 기기가 모두 지원하는 경우 키 합의 과정에서 하이브리드 양자 내성 계층(ML-KEM-768과 X25519 결합)도 함께 실행되어, 오늘 가로챈 트래픽을 미래의 양자 컴퓨터도 읽을 수 없습니다.";
"about.features.mesh.title" = "다중 홉 메시 라우팅";
"about.features.mesh.desc" = "오프라인 상태에서도 신뢰할 수 있는 피어를 통해 메시지가 목적지에 도달합니다.";
"about.features.fallback.title" = "하이브리드 클라우드 대체";
"about.features.fallback.desc" = "먼저 메시로, 서버는 전혀 거치지 않습니다. 그렇게 상대에게 닿지 않으면 메시지는 저희 자체 릴레이를 거치며, 릴레이는 암호화된 상태로 보관할 뿐 내용을 읽을 수 없습니다.";
"about.features.identity.title" = "암호화 ID";
"about.features.identity.desc" = "당신의 신원은 기기에서 생성된 Curve25519 키 쌍입니다. 등록할 것도, 압수당할 것도 없습니다.";
"about.features.ordering.title" = "순서 없는 메시지 처리";
"about.features.ordering.desc" = "고급 메시지 버퍼링으로 네트워크 혼잡을 원활하게 처리합니다.";
"about.features.media.title" = "암호화된 미디어";
"about.features.media.desc" = "AES-256-GCM 암호화로 사진과 동영상을 전송하며, 수신자만 복호화할 수 있습니다.";
"about.features.qr.title" = "QR 코드 페어링";
"about.features.qr.desc" = "암호화된 안전 번호로 연락처를 확인하고 추가하려면 스캔하세요.";
"about.features.serverless.title" = "서버리스 아키텍처";
"about.features.serverless.desc" = "사용자 계정 없음, 전화번호 없음, 이메일 없음, 데이터 수집 없음, 추적 없음.";
"about.howItWorks.title" = "작동 방식";
"about.howItWorks.step1.title" = "ID 생성";
"about.howItWorks.step1.desc" = "고유하고 검증 가능한 ID가 되는 암호화 ID를 생성합니다.";
"about.howItWorks.step2.title" = "피어에 연결";
"about.howItWorks.step2.desc" = "블루투스 또는 WiFi 메시를 통해 근처 기기를 발견하거나, QR 코드를 스캔하여 신뢰할 수 있는 연락처를 추가합니다.";
"about.howItWorks.step3.title" = "암호화된 메시지 전송";
"about.howItWorks.step3.desc" = "메시지는 Double Ratchet으로 암호화되어 피어에게 직접 전송되거나 메시를 통해 중계됩니다.";
"about.howItWorks.step4.title" = "클라우드로 대체";
"about.howItWorks.step4.desc" = "메시로 상대에게 닿지 않으면, 암호화된 메시지는 전달될 때까지 저희 자체 릴레이 서버에 보관됩니다. 릴레이는 내용을 읽을 수 없으며, 어떤 공개 네트워크에도 게시되지 않습니다.";
"about.howItWorks.step5.title" = "계속 바뀌는 키";
"about.howItWorks.step5.desc" = "메시지마다 고유한 키를 사용하고, 전송할 때마다 키 사슬이 앞으로 나아갑니다.";

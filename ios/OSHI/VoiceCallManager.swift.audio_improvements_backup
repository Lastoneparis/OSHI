                self.currentCallPeer = callerKey
                self.currentCallPeerName = callerName
                self.isOutgoingCall = false
            }
        }
    }

    /// Handle CallKit audio session activation
    /// 🔧 CRITICAL FIX: When CallKit activates the audio session, start the engine
    /// if it's not running. This catches the common case where engine.start() fails
    /// because CallKit hadn't activated the session yet during acceptCall().
    @objc private func handleCallKitAudioActivated() {
        print("📞 VoiceCall: CallKit audio session activated")
        fileLog.log("📞 CallKit AUDIO SESSION ACTIVATED — engineRunning: \(audioEngine?.isRunning ?? false), state: \(callState)")

        #if os(iOS)
        // Set audio route
        if callState == .inCall {
            do {
                let session = AVAudioSession.sharedInstance()
                if isSpeakerOn {
                    try session.overrideOutputAudioPort(.speaker)
                } else {
                    try session.overrideOutputAudioPort(.none)
                }
            } catch {
                print("⚠️ VoiceCall: Failed to set audio route: \(error)")
            }
        }

        // 🔧 FIX: If audio engine isn't running, start it now.
        // CallKit has just activated the audio session — this is the safe time to start.
        if callState == .inCall, audioEngine?.isRunning != true {
            fileLog.log("🔧 CallKit audio activated — audio engine NOT running, starting now...")
            Task { @MainActor [weak self] in
                guard let self = self, self.callState == .inCall else { return }
                // Brief settle time for CallKit audio session activation
                try? await Task.sleep(nanoseconds: 100_000_000) // 100ms
                self.stopAudioEngine()
                do {
                    try self.startAudioEngine()
                    fileLog.log("✅ Audio engine started via CallKit activation")
                } catch {
                    fileLog.log("❌ Audio engine STILL failed after CallKit activation: \(error)")
                    // Final retry after longer delay
                    try? await Task.sleep(nanoseconds: 1_000_000_000) // 1s
                    if self.callState == .inCall {
                        self.stopAudioEngine()
                        do {
                            try self.startAudioEngine()
                            fileLog.log("✅ Audio engine started on 1s retry after CallKit")
                        } catch {
                            fileLog.log("❌ Audio engine FINAL FAILURE: \(error)")
                        }
                    }
                }
            }
        }
        #endif
    }
    

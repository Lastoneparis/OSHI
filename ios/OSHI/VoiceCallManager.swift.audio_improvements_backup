    // MARK: - Base64URL Encoding/Decoding Helpers
    // 🔧 CRITICAL: Use base64url encoding for public keys in URLs
    // Standard base64 uses +/= which break URL paths even when percent-encoded
    // Base64url uses -_ instead and is URL-safe
    private func base64urlEncode(_ string: String) -> String {
        return string
            .replacingOccurrences(of: "+", with: "-")
            .replacingOccurrences(of: "/", with: "_")
            .replacingOccurrences(of: "=", with: "")
    }

    // 🔧 CRITICAL FIX: Decode base64url back to standard base64
    // VPS returns keys in base64url format, but Data(base64Encoded:) expects standard base64
    private func base64urlDecode(_ base64urlString: String) -> String {
        var result = base64urlString
            .replacingOccurrences(of: "-", with: "+")
            .replacingOccurrences(of: "_", with: "/")
        // Add padding if needed
        while result.count % 4 != 0 {
            result.append("=")
        }
        return result
    }
    
    /// Add Ed25519 signature headers to an HTTP request for server-side verification
    private func signRequest(_ request: inout URLRequest) {
        guard let identityManager = getIdentityManager(),
              let url = request.url,
              let method = request.httpMethod else { return }

        let path = url.path
        if let sigData = identityManager.signHTTPRequest(
            method: method,
            path: path,
            bodyData: request.httpBody
        ) {
            request.setValue(sigData.signature, forHTTPHeaderField: "X-OSHI-Signature")
            request.setValue(sigData.timestamp, forHTTPHeaderField: "X-OSHI-Timestamp")
            request.setValue(sigData.signingPublicKey, forHTTPHeaderField: "X-OSHI-Signing-PubKey")
        }
    }

    /// Add signature fields to a WebSocket JSON message (mutates the dictionary)
    private func signWebSocketMessage(_ message: inout [String: Any], type: String) {
        guard let identityManager = getIdentityManager() else { return }

        let payloadObj: [String: Any] = {
            var obj = [String: Any]()
            if let audio = message["audio"] { obj["audio"] = audio }
            if let signal = message["signal"] { obj["signal"] = signal }
            if let recipient = message["recipient"] { obj["recipient"] = recipient }
            if let callId = message["callId"] { obj["callId"] = callId }
            return obj
        }()

        guard let payloadData = try? JSONSerialization.data(withJSONObject: payloadObj, options: .sortedKeys) else { return }
        let hashStr = SHA256.hash(data: payloadData).compactMap { String(format: "%02x", $0) }.joined()

        if let sig = identityManager.signWebSocketMessage(type: type, payloadHash: hashStr) {
            message["signature"] = sig.signature
            message["wsTimestamp"] = sig.timestamp
            message["signingPubKey"] = sig.signingPublicKey
        }
    }


protocol AudioCodec {
    func encode(_ pcmData: Data) -> Data
    func decode(_ encodedData: Data) -> Data
    var compressionRatio: Double { get }
    var name: String { get }
    func setBitrate(_ bitrate: Int32)
    func setExpectedPacketLoss(_ percent: Int32)
    func reset()
}

/// PCM "codec" - no compression (fallback)
class PCMCodec: AudioCodec {
    func encode(_ pcmData: Data) -> Data { pcmData }
    func decode(_ encodedData: Data) -> Data { encodedData }
    var compressionRatio: Double { 1.0 }
    func setBitrate(_ bitrate: Int32) {}
    func setExpectedPacketLoss(_ percent: Int32) {}
    func reset() {}
    var name: String { "PCM (Uncompressed)" }
}

// MARK: - AAC-ELD Codec (Crystal Clear VoIP Audio)
// Apple's built-in AudioToolbox — same codec as FaceTime
// 48kHz mono, 24-80kbps adaptive, ~15ms codec delay
// Comparable to Opus (used by WhatsApp/Telegram) on iOS

/// Encode callback context — stores pointer to PCM input for AudioConverter
private struct AACEncodeContext {
    var inputData: UnsafeRawPointer
    var inputByteSize: UInt32
    var frameCount: UInt32
    var consumed: Bool
}

/// Decode callback context — stores pointer to AAC input + packet description
private struct AACDecodeContext {
    var inputData: UnsafeRawPointer
    var inputByteSize: UInt32
    var packetDescPtr: UnsafeMutablePointer<AudioStreamPacketDescription>
    var consumed: Bool
}

/// AAC-ELD Encode input callback (C-compatible)
private let aacEncodeInputCallback: AudioConverterComplexInputDataProc = {
    (_, ioNumberDataPackets, ioData, _, inUserData) -> OSStatus in
    guard let ctx = inUserData?.assumingMemoryBound(to: AACEncodeContext.self) else {
        ioNumberDataPackets.pointee = 0; return -50 // paramErr
    }
    if ctx.pointee.consumed {
        ioNumberDataPackets.pointee = 0; return -1 // no more data
    }
    ioNumberDataPackets.pointee = ctx.pointee.frameCount
    ioData.pointee.mNumberBuffers = 1
    ioData.pointee.mBuffers.mNumberChannels = 1
    ioData.pointee.mBuffers.mDataByteSize = ctx.pointee.inputByteSize
    ioData.pointee.mBuffers.mData = UnsafeMutableRawPointer(mutating: ctx.pointee.inputData)
    ctx.pointee.consumed = true
    return noErr
}

/// AAC-ELD Decode input callback (C-compatible)
private let aacDecodeInputCallback: AudioConverterComplexInputDataProc = {
    (_, ioNumberDataPackets, ioData, outDataPacketDescription, inUserData) -> OSStatus in
    guard let ctx = inUserData?.assumingMemoryBound(to: AACDecodeContext.self) else {
        ioNumberDataPackets.pointee = 0; return -50 // paramErr
    }
    if ctx.pointee.consumed {
        ioNumberDataPackets.pointee = 0; return -1 // no more data
    }
    ioNumberDataPackets.pointee = 1 // 1 AAC packet
    ioData.pointee.mNumberBuffers = 1
    ioData.pointee.mBuffers.mNumberChannels = 1
    ioData.pointee.mBuffers.mDataByteSize = ctx.pointee.inputByteSize
    ioData.pointee.mBuffers.mData = UnsafeMutableRawPointer(mutating: ctx.pointee.inputData)
    // Provide packet description — tells AudioConverter where the AAC packet is
    if let outDesc = outDataPacketDescription {
        outDesc.pointee = ctx.pointee.packetDescPtr
    }
    ctx.pointee.consumed = true
    return noErr
}

class AACELDCodec: AudioCodec {
    private var encoder: AudioConverterRef?
    private var decoder: AudioConverterRef?
    private var isValid = false
    private var framesPerPacket: UInt32 = 480  // Actual frames per AAC-ELD packet (queried from converter)
    private var consecutiveSilentFrames: Int = 0
    private let silenceThreshold: Int16 = 30   // Very low — iPad mic peaks at ~235 for voice, ~15 ambient
    private let maxSilentFrames: Int = 100     // ~2s of true silence before DTX — never cut voice
    private var encodeOutputBuffer = [UInt8](repeating: 0, count: 4096) // Pre-allocated, no COW
    private var encodeFailCount: Int = 0
    private var decodeFailCount: Int = 0
    private var encodeCallCount: Int = 0
    private let encodeLock = NSLock() // Protects encoder only (real-time audio thread)
    private let decodeLock = NSLock() // Protects decoder only (WS processing thread)

    init() {
        setupEncoder()
        setupDecoder()
        if encoder != nil && decoder != nil {
            isValid = true
            fileLog.log("🎵 AACELDCodec: Initialized — 48kHz mono, \(framesPerPacket) frames/pkt")
        } else {
            fileLog.log("⚠️ AACELDCodec: Init FAILED — using ADPCM fallback")
        }
    }

    private func setupEncoder() {
        var inASBD = AudioStreamBasicDescription(
            mSampleRate: 48000, mFormatID: kAudioFormatLinearPCM,
            mFormatFlags: kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked,
            mBytesPerPacket: 2, mFramesPerPacket: 1, mBytesPerFrame: 2,
            mChannelsPerFrame: 1, mBitsPerChannel: 16, mReserved: 0)
        var outASBD = AudioStreamBasicDescription(
            mSampleRate: 48000, mFormatID: kAudioFormatMPEG4AAC_ELD,
            mFormatFlags: 0, mBytesPerPacket: 0, mFramesPerPacket: 0, // Let system fill in
            mBytesPerFrame: 0, mChannelsPerFrame: 1, mBitsPerChannel: 0, mReserved: 0)
        var enc: AudioConverterRef?
        let status = AudioConverterNew(&inASBD, &outASBD, &enc)
        guard status == noErr, let c = enc else {
            fileLog.log("❌ AACELDCodec encoder create failed: OSStatus \(status)"); return
        }
        // Set bitrate
        var br: UInt32 = 64000
        AudioConverterSetProperty(c, kAudioConverterEncodeBitRate,
                                  UInt32(MemoryLayout<UInt32>.size), &br)
        // Query actual output ASBD to get real framesPerPacket
        var actualASBD = AudioStreamBasicDescription()
        var asbdSize = UInt32(MemoryLayout<AudioStreamBasicDescription>.size)
        let queryStatus = AudioConverterGetProperty(c, kAudioConverterCurrentOutputStreamDescription,
                                                     &asbdSize, &actualASBD)
        if queryStatus == noErr && actualASBD.mFramesPerPacket > 0 {
            framesPerPacket = actualASBD.mFramesPerPacket
            fileLog.log("🎵 AACELDCodec: Actual framesPerPacket=\(framesPerPacket)")
        } else {
            framesPerPacket = 480 // Safe default for AAC-ELD at 48kHz
        }
        encoder = c
    }

    private func setupDecoder() {
        var inASBD = AudioStreamBasicDescription(
            mSampleRate: 48000, mFormatID: kAudioFormatMPEG4AAC_ELD,
            mFormatFlags: 0, mBytesPerPacket: 0, mFramesPerPacket: framesPerPacket,
            mBytesPerFrame: 0, mChannelsPerFrame: 1, mBitsPerChannel: 0, mReserved: 0)
        var outASBD = AudioStreamBasicDescription(
            mSampleRate: 48000, mFormatID: kAudioFormatLinearPCM,
            mFormatFlags: kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked,
            mBytesPerPacket: 2, mFramesPerPacket: 1, mBytesPerFrame: 2,
            mChannelsPerFrame: 1, mBitsPerChannel: 16, mReserved: 0)
        var dec: AudioConverterRef?
        let status = AudioConverterNew(&inASBD, &outASBD, &dec)
        guard status == noErr, let c = dec else {
            fileLog.log("❌ AACELDCodec decoder create failed: OSStatus \(status)"); return
        }
        decoder = c
    }

    func encode(_ pcmData: Data) -> Data {
        guard isValid, let enc = encoder else { return adpcmFallbackEncode(pcmData) }
        let sampleCount = pcmData.count / 2
        guard sampleCount > 0 else { return Data([0xFF]) }

        // DTX: silence detection — save bandwidth by sending marker byte
        var maxAmp: Int16 = 0
        pcmData.withUnsafeBytes { raw in
            let s = raw.bindMemory(to: Int16.self)
            for i in 0..<min(sampleCount, s.count) {
                let a = abs(s[i]); if a > maxAmp { maxAmp = a }
            }
        }
        // Log audio levels for first 20 buffers + every 100th to diagnose mic issues
        encodeCallCount += 1
        if encodeCallCount <= 20 || encodeCallCount % 100 == 0 {
            fileLog.log("🎙️ ENC #\(encodeCallCount) samples:\(sampleCount) maxAmp:\(maxAmp) silent:\(consecutiveSilentFrames)")
        }
        if maxAmp < silenceThreshold {
            consecutiveSilentFrames += 1
            if consecutiveSilentFrames > maxSilentFrames { return Data([0xFF]) }
        } else { consecutiveSilentFrames = 0 }

        encodeLock.lock()
        defer { encodeLock.unlock() }

        var result = Data()
        let fpp = framesPerPacket
        let totalFrames = UInt32(sampleCount)
        var done: UInt32 = 0

        pcmData.withUnsafeBytes { rawIn in
            guard let base = rawIn.baseAddress else { return }
            while done < totalFrames {
                let todo = min(fpp, totalFrames - done)
                if todo < fpp { break } // Don't encode partial frames

                var ctx = AACEncodeContext(
                    inputData: base.advanced(by: Int(done) * 2),
                    inputByteSize: todo * 2,
                    frameCount: todo,
                    consumed: false)
                var outPktCount: UInt32 = 1
                var outBufList = AudioBufferList(
                    mNumberBuffers: 1,
                    mBuffers: AudioBuffer(
                        mNumberChannels: 1,
                        mDataByteSize: UInt32(encodeOutputBuffer.count),
                        mData: nil))

                encodeOutputBuffer.withUnsafeMutableBufferPointer { outBuf in
                    outBufList.mBuffers.mData = UnsafeMutableRawPointer(outBuf.baseAddress!)
                    outBufList.mBuffers.mDataByteSize = UInt32(outBuf.count)
                    var pd = AudioStreamPacketDescription()

                    let st = withUnsafeMutablePointer(to: &ctx) { ctxPtr in
                        AudioConverterFillComplexBuffer(
                            enc, aacEncodeInputCallback, ctxPtr,
                            &outPktCount, &outBufList, &pd)
                    }
                    // Status -1 is normal: callback returns -1 when input is consumed
                    if (st == noErr || st == -1) && outPktCount > 0 {
                        let n = Int(outBufList.mBuffers.mDataByteSize)
                        if n > 0 && n < outBuf.count {
                            var len = UInt16(n).littleEndian
                            result.append(Data(bytes: &len, count: 2))
                            result.append(Data(bytesNoCopy: outBuf.baseAddress!,
                                               count: n, deallocator: .none))
                        }
                    } else if st != noErr && st != -1 {
                        encodeFailCount += 1
                        if encodeFailCount <= 5 {
                            fileLog.log("❌ AACELDCodec encode err: \(st) (fail #\(encodeFailCount))")
                        }
                    }
                }
                done += todo
            }
        }
        return result.isEmpty ? Data([0xFF]) : result
    }

    func decode(_ encodedData: Data) -> Data {
        if encodedData.count == 1 && encodedData[0] == 0xFF {
            return comfortNoise(Int(framesPerPacket) * 2) // 2 packets worth for 20ms
        }
        guard isValid, let dec = decoder else { return adpcmFallbackDecode(encodedData) }

        decodeLock.lock()
        defer { decodeLock.unlock() }

        var result = Data()
        var off = 0
        let outFrames = framesPerPacket
        let outByteSize = outFrames * 2 // Int16 samples

        while off + 2 <= encodedData.count {
            // Read 2-byte little-endian packet length
            let pLen: Int
            if off + 1 < encodedData.count {
                pLen = Int(encodedData[off]) | (Int(encodedData[off + 1]) << 8)
            } else { break }
            off += 2
            guard pLen > 0 && pLen < 4096 && off + pLen <= encodedData.count else { break }

            // Copy AAC packet to contiguous buffer for safe pointer access
            let aacPacket = [UInt8](encodedData[off..<(off + pLen)])
            off += pLen

            // Allocate output buffer for decoded PCM
            var outSamples = [UInt8](repeating: 0, count: Int(outByteSize))

            // Packet description — lives on stack, pointer is valid for duration of scope
            var packetDesc = AudioStreamPacketDescription(
                mStartOffset: 0,
                mVariableFramesInPacket: 0,
                mDataByteSize: UInt32(pLen))

            aacPacket.withUnsafeBufferPointer { aacBuf in
                guard let aacPtr = aacBuf.baseAddress else { return }

                withUnsafeMutablePointer(to: &packetDesc) { pdPtr in
                    var ctx = AACDecodeContext(
                        inputData: UnsafeRawPointer(aacPtr),
                        inputByteSize: UInt32(pLen),
                        packetDescPtr: pdPtr,
                        consumed: false)

                    var outBufList = AudioBufferList(
                        mNumberBuffers: 1,
                        mBuffers: AudioBuffer(
                            mNumberChannels: 1,
                            mDataByteSize: outByteSize,
                            mData: nil))
                    var outPktCount = outFrames

                    outSamples.withUnsafeMutableBufferPointer { outBuf in
                        outBufList.mBuffers.mData = UnsafeMutableRawPointer(outBuf.baseAddress!)
                        outBufList.mBuffers.mDataByteSize = outByteSize

                        let st = withUnsafeMutablePointer(to: &ctx) { ctxPtr in
                            AudioConverterFillComplexBuffer(
                                dec, aacDecodeInputCallback, ctxPtr,
                                &outPktCount, &outBufList, nil)
                        }
                        // Status -1 is normal: callback returns -1 when input consumed
                        if (st == noErr || st == -1) && outBufList.mBuffers.mDataByteSize > 0 {
                            let decoded = Int(outBufList.mBuffers.mDataByteSize)
                            result.append(Data(bytesNoCopy: outBuf.baseAddress!,
                                               count: decoded, deallocator: .none))
                        } else if st != noErr && st != -1 {
                            decodeFailCount += 1
                            if decodeFailCount <= 5 {
                                fileLog.log("❌ AACELDCodec decode err: \(st) pLen:\(pLen) (fail #\(decodeFailCount))")
                            }
                        }
                    }
                }
            }
        }
        return result.isEmpty ? comfortNoise(Int(framesPerPacket) * 2) : result
    }

    private func comfortNoise(_ samples: Int) -> Data {
        // True silence — zeros produce no audible noise/crackling
        return Data(count: samples * 2)
    }

    // MARK: - ADPCM Fallback (if AAC-ELD unavailable on device)
    private var fbEnc = G726FallbackState(); private var fbDec = G726FallbackState()
    private var fbPre: Int32 = 0; private var fbDe: Int32 = 0; private let fbC: Int32 = 27853

    private func adpcmFallbackEncode(_ pcmData: Data) -> Data {
        var s = [Int16](); s.reserveCapacity(pcmData.count / 2)
        for i in stride(from: 0, to: pcmData.count - 1, by: 2) {
            s.append(Int16(pcmData[i]) | (Int16(pcmData[i+1]) << 8))
        }
        var e = [Int16](); e.reserveCapacity(s.count)
        for v in s { let x = Int32(v) - ((fbC * fbPre) >> 15); fbPre = Int32(v); e.append(Int16(clamping: x)) }
        var r = Data(); var buf: UInt8 = 0; var cnt = 0
        for v in e {
            let n = fbEnc.encode(sample: v)
            if cnt == 0 { buf = n & 0x0F; cnt = 1 } else { buf |= (n & 0x0F) << 4; r.append(buf); cnt = 0 }
        }
        if cnt == 1 { r.append(buf) }; return r
    }

    private func adpcmFallbackDecode(_ data: Data) -> Data {
        if data.count == 1 && data[0] == 0xFF { return comfortNoise(Int(framesPerPacket) * 2) }
        var s = [Int16](); s.reserveCapacity(data.count * 2)
        for b in data { s.append(fbDec.decode(adpcm: b & 0x0F)); s.append(fbDec.decode(adpcm: (b >> 4) & 0x0F)) }
        for i in 0..<s.count {
            let d = Int32(s[i]) + ((fbC * fbDe) >> 15); let c = max(-32768, min(32767, d)); fbDe = c; s[i] = Int16(c)
        }
        var r = Data(capacity: s.count * 2)
        for v in s { var x = v; r.append(Data(bytes: &x, count: 2)) }; return r
    }

    var compressionRatio: Double { 12.0 }
    var name: String { isValid ? "AAC-ELD (\(framesPerPacket)fpp @ 48kHz)" : "G.726 ADPCM fallback" }

    func setBitrate(_ bitrate: Int32) {
        guard let enc = encoder else { return }
        encodeLock.lock()
        var br = UInt32(bitrate)
        AudioConverterSetProperty(enc, kAudioConverterEncodeBitRate,
                                  UInt32(MemoryLayout<UInt32>.size), &br)
        encodeLock.unlock()
        fileLog.log("🎵 AACELDCodec: setBitrate \(bitrate/1000)kbps")
    }

    func setExpectedPacketLoss(_ percent: Int32) {}

    func reset() {
        encodeLock.lock()
        if let e = encoder { AudioConverterReset(e) }
        consecutiveSilentFrames = 0; encodeFailCount = 0; encodeCallCount = 0
        encodeLock.unlock()
        decodeLock.lock()
        if let d = decoder { AudioConverterReset(d) }
        decodeFailCount = 0
        decodeLock.unlock()
        fbPre = 0; fbDe = 0; fbEnc.reset(); fbDec.reset()
    }

    deinit {
        if let e = encoder { AudioConverterDispose(e) }
        if let d = decoder { AudioConverterDispose(d) }
    }
}

/// G.726 ADPCM state for fallback (if AAC-ELD unavailable)
private class G726FallbackState {
    private var stepIndex: Int = 0; private var predicted: Int32 = 0
    private let steps: [Int32] = [
        16,17,19,21,23,25,28,31,34,37,41,45,50,55,60,66,73,80,88,97,107,118,130,143,157,173,190,209,
        230,253,279,307,337,371,408,449,494,544,598,658,724,796,876,963,1060,1166,1282,1411,1552,1707,
        1878,2066,2272,2499,2749,3024,3327,3660,4026,4428,4871,5358,5894,6484,7132,7845,8630,9493,
        10442,11487,12635,13899,15289,16818,18500,20350,22385,24623,27086,29794,32767]
    private let idx: [Int] = [-1,-1,-1,-1,2,4,6,8,-1,-1,-1,-1,2,4,6,8]
    func encode(sample: Int16) -> UInt8 {
        let s = steps[stepIndex]; var d = Int32(sample) - predicted; var c: UInt8 = 0
        if d < 0 { c = 8; d = -d }
        var m: UInt8 = 4; var t = s
        for _ in stride(from: 2, through: 0, by: -1) { if d >= t { c |= m; d -= t }; t >>= 1; m >>= 1 }
        upd(c, s); stepIndex = max(0, min(stepIndex + idx[Int(c)], steps.count - 1)); return c
    }
    func decode(adpcm: UInt8) -> Int16 {
        let s = steps[stepIndex]; upd(adpcm, s)
        stepIndex = max(0, min(stepIndex + idx[Int(adpcm & 0x0F)], steps.count - 1))
        return Int16(clamping: max(-32768, min(32767, predicted)))
    }
    private func upd(_ c: UInt8, _ s: Int32) {
        var d: Int32 = s >> 3
        if c & 4 != 0 { d += s }; if c & 2 != 0 { d += s >> 1 }; if c & 1 != 0 { d += s >> 2 }
        predicted += (c & 8 != 0) ? -d : d; predicted = max(-32768, min(32767, predicted))
    }
    func reset() { stepIndex = 0; predicted = 0 }
}


// MARK: - Call State
enum CallState: Equatable {
    case idle
    case connecting
    case ringing
    case inCall
    case ended(reason: CallEndReason)
    
    static func == (lhs: CallState, rhs: CallState) -> Bool {
        switch (lhs, rhs) {
        case (.idle, .idle), (.connecting, .connecting), (.ringing, .ringing), (.inCall, .inCall):
            return true
        case (.ended(let r1), .ended(let r2)):
            return r1 == r2
        default:
            return false
        }
    }
}

enum CallEndReason: String {
    case hungUp = "hung_up"
    case declined = "declined"
    case noAnswer = "no_answer"
    case networkError = "network_error"
    case peerDisconnected = "peer_disconnected"
    case connectionLost = "connection_lost"  // 📶 NEW: Auto-ended due to 30s silence
    case answeredElsewhere = "answered_elsewhere"  // 📱 Multi-device: Call answered on another device

    /// User-friendly display text for call end reason
    var displayText: String {
        switch self {
        case .hungUp: return "Call ended"
        case .declined: return "Call declined"
        case .noAnswer: return "No answer"
        case .networkError: return "Network error"
        case .peerDisconnected: return "Connection lost"
        case .connectionLost: return "Connection lost"
        case .answeredElsewhere: return "Answered on another device"
        }
    }
}


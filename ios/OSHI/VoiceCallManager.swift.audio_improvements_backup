    /// Adapt jitter buffer depth based on network quality
    /// Called from AdaptiveBitrateController's adjustLevel
    private func updateJitterBufferTarget() {
        let loss = adaptiveBitrate.packetLossPercent
        let latency = adaptiveBitrate.averageLatency

        let newTarget: Int
        if loss > 10 || latency > 300 {
            newTarget = 4  // ~80ms — poor network, absorb jitter
        } else if loss > 5 || latency > 150 {
            newTarget = 3  // ~60ms — moderate network
        } else if loss < 2 && latency < 80 {
            newTarget = 1  // ~20ms — excellent network, minimize delay
        } else {
            newTarget = 2  // ~40ms — normal conditions
        }

        if newTarget != jitterBufferTarget {
            jitterBufferTarget = newTarget
            print("🎚️ Jitter buffer target: \(newTarget) packets (~\(newTarget * 20)ms)")
        }
    }
    

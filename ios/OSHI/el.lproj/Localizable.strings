/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "Στείλε bitcoin σε μια συνομιλία";
"guide.cashu.s1" = "Το OSHI δεν έχει πορτοφόλι και δεν κρατά ποτέ τα χρήματά σου. Μεταφέρει ένα token Cashu — ecash με αντίκρισμα σε bitcoin — όπως μεταφέρει μια φωτογραφία.";
"guide.cashu.s2" = "Πρώτα χρειάζεσαι ένα πορτοφόλι Cashu. eNuts, Minibits ή cashu.me στο πρόγραμμα περιήγησης: όλα δωρεάν και έτοιμα σε περίπου ένα λεπτό.";
"guide.cashu.s3" = "Στο πορτοφόλι, διάλεξε ένα mint και πρόσθεσε λίγα χρήματα μέσω Lightning. Λίγες εκατοντάδες sats αρκούν για να το δοκιμάσεις.";
"guide.cashu.s4" = "Δημιούργησε ένα token: στο πορτοφόλι πάτα Αποστολή, βάλε ένα ποσό και αντίγραψε. Παίρνεις μια μεγάλη γραμμή κειμένου που ξεκινά με cashuB. Αυτό το κείμενο ΕΙΝΑΙ τα χρήματα.";
"guide.cashu.s6" = "Ο άλλος πατά Εξαργύρωση και τα χρήματα φτάνουν στο πορτοφόλι του. Ένα token που σου στέλνουν φαίνεται ίδιο: πάτα Εξαργύρωση. Το OSHI είναι μόνο ο φάκελος.";
"guide.cashu.s5" = "Στη συνομιλία, γράψε / στο πλαίσιο μηνύματος, διάλεξε /pay και επικόλλησε το token. Το OSHI δείχνει το ποσό πριν την αποστολή, για να το ελέγξεις.";
"guide.cashu.sub" = "Cashu ecash — το OSHI δεν κρατά ποτέ τα χρήματά σου";
"guide.cashu.warning" = "Ένα token Cashu είναι μετρητά. Όποιος αποκτήσει το κείμενο μπορεί να τα ξοδέψει, και όποιος το εξαργυρώσει πρώτος το κρατά — στείλ' το μόνο στο πρόσωπο που εννοείς. Το OSHI δεν μπορεί να ρωτήσει το mint αν ένα token έχει ήδη ξοδευτεί: γίνεται δικό σου μόνο όταν το εξαργυρώσει το δικό σου πορτοφόλι.";
"guide.cashu.learn_more" = "Τι είναι το Cashu;";

   ============================================ */

"about.navigationTitle" = "Σχετικά";
"about.tagline" = "Ο Κυρίαρχος Messenger";
"about.tag.offline" = "Εκτός σύνδεσης";
"about.tag.secure" = "Ασφαλές";
"about.tag.decentralized" = "Αποκεντρωμένο";
"about.vision.title" = "Το Όραμα";
"about.vision.paragraph1" = "Το OSHI δεν είναι απλώς ένας messenger — είναι ένα **πρωτόκολλο επικοινωνίας για ψηφιακή ελευθερία**. Χτισμένο πάνω στις αρχές της κυριαρχίας, του απορρήτου και της ανθεκτικότητας.";
"about.vision.paragraph2" = "Όταν κάποιος βρίσκεται σε εμβέλεια, το OSHI λειτουργεί **χωρίς καθόλου internet και χωρίς κανέναν διακομιστή**, δρομολογώντας τα μηνύματα μέσω **ομότιμου δικτύου πλέγματος** με απευθείας συνδέσεις Bluetooth/Wi-Fi ή αναμεταδόσεις πολλαπλών αλμάτων. Όταν δεν υπάρχει κανείς σε εμβέλεια, καταφεύγει στον δικό μας αναμεταδότη ώστε το μήνυμα να φτάσει ούτως ή άλλως.";
"about.vision.paragraph3" = "Κάθε μήνυμα προστατεύεται από το **Double Ratchet** με συμφωνία κλειδιών **X3DH** και **AES-256-GCM** — την ίδια κατασκευή που χρησιμοποιεί το Signal — και αυτό ισχύει και μέσα από αναμεταδότες εκτός σύνδεσης και παραδόσεις εκτός σειράς.";
"about.principles.title" = "Βασικές Αρχές";
"about.principles.privacy.title" = "Απόρρητο από Προεπιλογή";
"about.principles.privacy.desc" = "Χωρίς αριθμό τηλεφώνου, χωρίς email, χωρίς λογαριασμό, χωρίς παρακολούθηση. Τα μηνύματα που στέλνονται μέσω του δικτύου πλέγματος δεν αφήνουν απολύτως τίποτα σε κανέναν διακομιστή.";
"about.principles.decentralization.title" = "Αποκέντρωση";
"about.principles.decentralization.desc" = "Καμία κεντρική αρχή, κανένα μεμονωμένο σημείο αποτυχίας. Η ισχύς κατανέμεται σε όλο το δίκτυο.";
"about.principles.sovereignty.title" = "Κυριαρχία";
"about.principles.sovereignty.desc" = "Εσείς ελέγχετε την ταυτότητά σας, τα δεδομένα σας και τις συνδέσεις σας. Καμία εταιρεία, καμία παρακολούθηση.";
"about.principles.resilience.title" = "Ανθεκτικότητα";
"about.principles.resilience.desc" = "Λειτουργεί σε διακοπές internet, λογοκρισία ή σενάρια καταστροφών. Η επικοινωνία δεν μπορεί να σταματήσει.";
"about.features.title" = "Τεχνικά Χαρακτηριστικά";
"about.features.doubleRatchet.title" = "Πρωτόκολλο Double Ratchet";
"about.features.doubleRatchet.desc" = "Κρυπτογράφηση από άκρο σε άκρο βασισμένη στο Double Ratchet με X3DH και AES-256-GCM. Όταν και οι δύο συσκευές το υποστηρίζουν, η συμφωνία κλειδιών εκτελεί επιπλέον ένα υβριδικό μετακβαντικό επίπεδο (ML-KEM-768 σε συνδυασμό με X25519), ώστε η κίνηση που καταγράφεται σήμερα να μην είναι αναγνώσιμη από έναν μελλοντικό κβαντικό υπολογιστή.";
"about.features.mesh.title" = "Δρομολόγηση Mesh Πολλαπλών Αλμάτων";
"about.features.mesh.desc" = "Τα μηνύματα αναμεταδίδονται μέσω αξιόπιστων χρηστών για να φτάσουν στον προορισμό τους, ακόμη και offline.";
"about.features.fallback.title" = "Υβριδικό Εφεδρικό Cloud";
"about.features.fallback.desc" = "Πρώτα το mesh, χωρίς κανέναν διακομιστή. Αν έτσι δεν φτάσει στην επαφή σας, το μήνυμα περνά από τον δικό μας relay, που το αποθηκεύει κρυπτογραφημένο και δεν μπορεί να το διαβάσει.";
"about.features.identity.title" = "Κρυπτογραφική Ταυτότητα";
"about.features.identity.desc" = "Η ταυτότητά σας είναι ένα ζεύγος κλειδιών Curve25519 που δημιουργείται στη συσκευή σας. Τίποτα για εγγραφή, τίποτα για κατάσχεση.";
"about.features.ordering.title" = "Διαχείριση Εκτός Σειράς";
"about.features.ordering.desc" = "Η προηγμένη προσωρινή αποθήκευση μηνυμάτων διαχειρίζεται το χάος του δικτύου με ομαλότητα.";
"about.features.media.title" = "Κρυπτογραφημένα Πολυμέσα";
"about.features.media.desc" = "Στείλτε φωτογραφίες και βίντεο με κρυπτογράφηση AES-256-GCM, που αποκρυπτογραφούνται μόνο από τον παραλήπτη.";
"about.features.qr.title" = "Σύζευξη με Κωδικό QR";
"about.features.qr.desc" = "Σαρώστε για επαλήθευση και προσθήκη επαφών με κρυπτογραφικούς αριθμούς ασφαλείας.";
"about.features.serverless.title" = "Αρχιτεκτονική χωρίς Διακομιστές";
"about.features.serverless.desc" = "Χωρίς λογαριασμούς χρήστη, χωρίς αριθμό τηλεφώνου, χωρίς email, χωρίς συλλογή δεδομένων, χωρίς παρακολούθηση.";
"about.howItWorks.title" = "Πώς Λειτουργεί";
"about.howItWorks.step1.title" = "Δημιουργήστε την Ταυτότητά σας";
"about.howItWorks.step1.desc" = "Δημιουργήστε μια κρυπτογραφική ταυτότητα που γίνεται η μοναδική, επαληθεύσιμη ταυτότητά σας.";
"about.howItWorks.step2.title" = "Συνδεθείτε με Χρήστες";
"about.howItWorks.step2.desc" = "Εντοπίστε κοντινές συσκευές μέσω Bluetooth ή WiFi mesh, ή σαρώστε κωδικούς QR για να προσθέσετε αξιόπιστες επαφές.";
"about.howItWorks.step3.title" = "Στείλτε Κρυπτογραφημένα Μηνύματα";
"about.howItWorks.step3.desc" = "Τα μηνύματα κρυπτογραφούνται με Double Ratchet και στέλνονται απευθείας στους χρήστες ή αναμεταδίδονται μέσω του mesh.";
"about.howItWorks.step4.title" = "Εφεδρεία σε Cloud";
"about.howItWorks.step4.desc" = "Αν το mesh δεν φτάσει στην επαφή σας, το κρυπτογραφημένο μήνυμα παραμένει στον δικό μας διακομιστή relay μέχρι να παραδοθεί. Ο relay δεν μπορεί να το διαβάσει και δεν δημοσιεύεται ποτέ σε κανένα δημόσιο δίκτυο.";
"about.howItWorks.step5.title" = "Κλειδιά που αλλάζουν συνεχώς";
"about.howItWorks.step5.desc" = "Κάθε μήνυμα παίρνει το δικό του κλειδί και η αλυσίδα προχωράει μετά από κάθε αποστολή.";

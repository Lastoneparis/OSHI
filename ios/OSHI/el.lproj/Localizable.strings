"info.mesh.title" = "Δίκτυο Mesh";
"info.mesh.section.about" = "ΣΧΕΤΙΚΑ";
"info.mesh.section.features" = "ΛΕΙΤΟΥΡΓΙΕΣ";
"info.mesh.section.tips" = "ΣΥΜΒΟΥΛΕΣ";
"info.mesh.what_title" = "Τι είναι το Mesh;";
"info.mesh.what_description" = "Η δικτύωση mesh δημιουργεί άμεσες συνδέσεις μεταξύ κοντινών συσκευών χρησιμοποιώντας Bluetooth και WiFi, επιτρέποντας την αποστολή μηνυμάτων χωρίς internet.";
"info.mesh.range_title" = "Εμβέλεια";
"info.mesh.range_description" = "Συνδέεται με συσκευές εντός περίπου 30-100 μέτρων ανάλογα με τις συνθήκες.";
"info.mesh.connection_title" = "Σύνδεση";
"info.mesh.connection_description" = "Τα μηνύματα μεταπηδούν μεταξύ συνδεδεμένων συσκευών για να φτάσουν στον προορισμό τους.";
"info.mesh.encryption_title" = "Ασφάλεια";
"info.mesh.encryption_description" = "Τα μηνύματα που αναμεταδίδονται μεταξύ iPhone μέσω του mesh παραμένουν κρυπτογραφημένα από άκρο σε άκρο, οπότε οι συσκευές που τα αναμεταδίδουν βλέπουν μόνο κρυπτογραφημένα δεδομένα. Η γέφυρα προς συσκευές Android και προς ασυρμάτους Meshtastic LoRa δεν προσθέτει δική της κρυπτογράφηση, γι’ αυτό μην θεωρείτε ιδιωτικές αυτές τις συνδέσεις.";
"info.mesh.tip1" = "Μείνετε κοντά σε άλλους χρήστες OSHI για καλύτερη συνδεσιμότητα";
"info.mesh.tip2" = "Ενεργοποιήστε τόσο το Bluetooth όσο και το WiFi για βέλτιστη εμβέλεια";
"info.mesh.tip3" = "Οι αναμεταδόσεις μεταξύ iPhone βλέπουν μόνο κρυπτογραφημένα δεδομένα· οι γέφυρες Android και LoRa δεν κρυπτογραφούν";
"info.mesh.disclaimer_title" = "Πριν βασιστείτε σε αυτό";
"info.mesh.disclaimer_description" = "Το offline mesh έχει μικρή εμβέλεια. Και τα δύο τηλέφωνα πρέπει να έχουν το OSHI ανοιχτό για να βρεθούν, περίπου 100 μέτρα σε ανοιχτό χώρο και πολύ λιγότερο μέσα από τοίχους. Φτάνει πιο μακριά μόνο όταν και άλλοι άνθρωποι κοντά έχουν το OSHI ανοιχτό ώστε να προωθήσουν το μήνυμα. Αν δεν υπάρχει κανείς εντός εμβέλειας, το OSHI στέλνει μέσω internet.";

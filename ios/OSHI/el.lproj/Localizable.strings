// MARK: - FAQ
"faq.q1.question" = "Τι είναι το OSHI;";
"faq.q1.answer" = "Το OSHI είναι μια ασφαλής, αποκεντρωμένη εφαρμογή ανταλλαγής μηνυμάτων που χρησιμοποιεί δικτύωση mesh και κρυπτογράφηση από άκρο σε άκρο για να προστατεύσει το απόρρητό σας.";
"faq.q2.question" = "Πώς λειτουργεί η δικτύωση mesh;";
"faq.q2.answer" = "Το OSHI χρησιμοποιεί Bluetooth και WiFi για να δημιουργήσει ένα δίκτυο peer-to-peer με κοντινές συσκευές. Τα μηνύματα μεταπηδούν μεταξύ συσκευών μέχρι να φτάσουν στον παραλήπτη.";
"faq.q3.question" = "Είναι κρυπτογραφημένα τα δεδομένα μου;";
"faq.q3.answer" = "Ναι! Το OSHI χρησιμοποιεί τον αλγόριθμο Double Ratchet (ίδιο με το Signal) για κρυπτογράφηση από άκρο σε άκρο. Μόνο εσείς και ο παραλήπτης σας μπορείτε να διαβάσετε τα μηνύματα.";
"faq.q4.question" = "Τι γίνεται αν χάσω τη συσκευή μου;";
"faq.q4.answer" = "Βεβαιωθείτε ότι έχετε δημιουργήσει αντίγραφο ασφαλείας των κλειδιών σας στις Ρυθμίσεις > Αντίγραφο Ασφαλείας Κλειδιών. Χωρίς το αντίγραφο ασφαλείας σας, δεν μπορείτε να ανακτήσετε την ταυτότητά σας.";
"faq.q5.question" = "Μπορώ να χρησιμοποιήσω το OSHI χωρίς internet;";
"faq.q5.answer" = "Ναι! Η δικτύωση mesh του OSHI σας επιτρέπει να στέλνετε μηνύματα σε κοντινούς χρήστες χωρίς internet.";
"faq.q6.question" = "Πώς προσθέτω επαφές;";
"faq.q6.answer" = "Μεταβείτε στο Νέο Μήνυμα και είτε σαρώστε τον κωδικό QR της επαφής σας, κοινοποιήστε τον κωδικό QR σας, ή επικολλήστε το δημόσιο κλειδί της.";

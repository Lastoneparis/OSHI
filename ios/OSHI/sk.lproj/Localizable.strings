/* Guide Step Descriptions */
"guide_welcome_desc" = "OSHI je kolaboratívny šifrovaný messenger. Bez internetu správy skáču z telefónu na telefón cez ľudí v okolí, ktorí majú OSHI otvorené. Poďme vás previesť.";
"guide_messages_tab_desc" = "Vaše súkromné konverzácie sa zobrazia tu. Uskutočňujte šifrované hlasové hovory klepnutím na ktorúkoľvek konverzáciu. Správy a hovory prídu len vtedy, keď je aplikácia otvorená 2+ sekúnd – je to zámerné z bezpečnostných dôvodov.";
"guide_groups_tab_desc" = "Vytvárajte súkromné skupiny alebo sa pripojte k verejným v okolí. Objavujte skupiny v dosahu mesh, približne 100 m, a ďalej, keď ostatní prenášajú. Nechajte aplikáciu otvorenú na detekciu skupín okolo vás!";
"guide_new_tab_desc" = "Tu začnite novú konverzáciu. Naskenujte QR kód kontaktu alebo vložte jeho verejný kľúč. Žiadne telefónne čísla, žiadne účty – len kryptografické kľúče.";
"guide_settings_tab_desc" = "Tu žije vaša kryptoidentita. Zdieľajte svoj QR kód alebo verejný kľúč s ostatnými, aby vám mohli písať. Môžete tiež zapnúť biometrický zámok pre väčšiu bezpečnosť.";
"guide_collaborative_desc" = "OSHI je kolaboratívne: keď necháte aplikáciu otvorenú, vaše zariadenie pomáha prenášať správy pre ostatných ľudí v okolí. V krízových situáciách (vojna, výpadok internetu) to vytvára odolnú sieť. Každý telefón dosiahne asi 100 m, takže čím viac ľudí má OSHI otvorené, tým ďalej môžu správy cestovať.";
"guide_complete_desc" = "Všetko je pripravené! Pamätajte: nechajte OSHI otvorené na prijímanie správ a pomoc ostatným komunikovať v núdzi. Vitajte v sieti!";


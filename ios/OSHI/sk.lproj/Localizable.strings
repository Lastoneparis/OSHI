/* ============================================
   MARK: - About View
   ============================================ */

"about.navigationTitle" = "O aplikácii";
"about.tagline" = "Suverénny Messenger";
"about.tag.offline" = "Offline";
"about.tag.secure" = "Bezpečné";
"about.tag.decentralized" = "Decentralizované";
"about.vision.title" = "Vízia";
"about.vision.paragraph1" = "OSHI nie je len messenger — je to **komunikačný protokol pre digitálnu slobodu**. Postavený na princípoch suverenity, súkromia a odolnosti.";
"about.vision.paragraph2" = "Keď je niekto v dosahu, OSHI funguje **úplne bez internetu a bez akéhokoľvek servera** a smeruje správy cez **peer-to-peer mesh sieť** pomocou priamych spojení Bluetooth/Wi-Fi alebo viacskokových prenosov. Keď nie je nikto v dosahu, prepne sa na náš relay, aby správa napriek tomu dorazila.";
"about.vision.paragraph3" = "Každá správa je chránená protokolom **Double Ratchet** s výmenou kľúčov **X3DH** a šifrovaním **AES-256-GCM** — rovnakou konštrukciou, akú používa Signal — a platí to aj cez offline prenosy a doručenie mimo poradia.";
"about.principles.title" = "Základné princípy";
"about.principles.privacy.title" = "Súkromie predvolene";
"about.principles.privacy.desc" = "Žiadne telefónne číslo, žiadny e-mail, žiadny účet, žiadne sledovanie. Správy odoslané cez mesh sieť nezanechajú na žiadnom serveri vôbec nič.";
"about.principles.decentralization.title" = "Decentralizácia";
"about.principles.decentralization.desc" = "Žiadna centrálna autorita, žiadny jediný bod zlyhania. Moc rozdelená naprieč sieťou.";
"about.principles.sovereignty.title" = "Suverenita";
"about.principles.sovereignty.desc" = "Ovládate svoju identitu, svoje údaje a svoje spojenia. Žiadne korporácie, žiadny dohľad.";
"about.principles.resilience.title" = "Odolnosť";
"about.principles.resilience.desc" = "Funguje pri výpadkoch internetu, cenzúre alebo katastrofách. Komunikáciu nie je možné zastaviť.";
"about.features.title" = "Technické funkcie";
"about.features.doubleRatchet.title" = "Protokol Double Ratchet";
"about.features.doubleRatchet.desc" = "Koncové šifrovanie postavené na Double Ratchet s X3DH a AES-256-GCM. Ak to podporujú obe zariadenia, pri dohode kľúčov sa navyše spustí hybridná postkvantová vrstva (ML-KEM-768 v kombinácii s X25519), takže dnes zachytenú komunikáciu nedokáže prečítať ani budúci kvantový počítač.";
"about.features.mesh.title" = "Viacskokové smerovanie mesh";
"about.features.mesh.desc" = "Správy sú prenášané cez dôveryhodné zariadenia, aby dosiahli svoj cieľ, aj offline.";
"about.features.fallback.title" = "Hybridné záložné cloudové riešenie";
"about.features.fallback.desc" = "Najprv mesh, úplne bez servera. Ak takto váš kontakt nedosiahne, správa prejde cez náš vlastný relay, ktorý ju uloží zašifrovanú a nedokáže ju prečítať.";
"about.features.identity.title" = "Kryptografická identita";
"about.features.identity.desc" = "Vaša identita je pár kľúčov Curve25519 vygenerovaný priamo vo vašom zariadení. Nie je čo registrovať, nie je čo zhabať.";
"about.features.ordering.title" = "Spracovanie mimo poradia";
"about.features.ordering.desc" = "Pokročilé ukladanie správ do vyrovnávacej pamäte hravo zvládne chaos siete.";
"about.features.media.title" = "Šifrované médiá";
"about.features.media.desc" = "Posielajte fotky a videá so šifrovaním AES-256-GCM, dešifrovateľné len príjemcom.";
"about.features.qr.title" = "Párovanie QR kódom";
"about.features.qr.desc" = "Naskenujte na overenie a pridanie kontaktov s kryptografickými bezpečnostnými číslami.";
"about.features.serverless.title" = "Architektúra bez serverov";
"about.features.serverless.desc" = "Žiadne používateľské účty, žiadne telefónne číslo, žiadny e-mail, žiadny zber údajov, žiadne sledovanie.";
"about.howItWorks.title" = "Ako to funguje";
"about.howItWorks.step1.title" = "Vygenerujte svoju identitu";
"about.howItWorks.step1.desc" = "Vytvorte kryptografickú identitu, ktorá sa stane vašou jedinečnou, overiteľnou identitou.";
"about.howItWorks.step2.title" = "Pripojte sa k zariadeniam";
"about.howItWorks.step2.desc" = "Objavujte blízke zariadenia cez Bluetooth alebo WiFi mesh, alebo skenujte QR kódy na pridanie dôveryhodných kontaktov.";
"about.howItWorks.step3.title" = "Posielajte šifrované správy";
"about.howItWorks.step3.desc" = "Správy sú šifrované pomocou Double Ratchet a posielané priamo zariadeniam alebo prenášané cez mesh.";
"about.howItWorks.step4.title" = "Záloha do cloudu";
"about.howItWorks.step4.desc" = "Ak mesh váš kontakt nedosiahne, zašifrovaná správa zostáva na našom vlastnom relay serveri, kým nie je doručená. Relay ju nedokáže prečítať a nikdy sa nezverejňuje v žiadnej verejnej sieti.";
"about.howItWorks.step5.title" = "Kľúče, ktoré sa neustále menia";
"about.howItWorks.step5.desc" = "Každá správa dostane vlastný kľúč a reťaz sa po každom odoslaní posunie ďalej.";
"about.useCases.title" = "Vytvorené pre";
"about.useCases.journalists.title" = "Novinári";
"about.useCases.journalists.desc" = "Bezpečná komunikácia v nepriateľskom prostredí";
"about.useCases.activists.title" = "Aktivisti";
"about.useCases.activists.desc" = "Organizujte sa bez dohľadu či cenzúry";
"about.useCases.emergency.title" = "Núdzová reakcia";
"about.useCases.emergency.desc" = "Koordinujte, keď infraštruktúra zlyhá";
"about.useCases.travelers.title" = "Cestovatelia";
"about.useCases.travelers.desc" = "Zostaňte v spojení bez roamingu či internetu";
"about.useCases.privacy.title" = "Zástancovia súkromia";
"about.useCases.privacy.desc" = "Komunikujte bez korporátnych sprostredkovateľov";
"about.useCases.crypto.title" = "Používatelia kryptomien";
"about.useCases.crypto.desc" = "Natívna integrácia identity pre bezpečnú koordináciu";
"about.openSource.title" = "Otvorený zdroj a transparentnosť";
"about.openSource.paragraph1" = "OSHI je **100% open source**, postavený s transparentnosťou a možnosťou auditu vo svojom jadre. Každý riadok kódu je verejný a overiteľný.";
"about.openSource.paragraph2" = "Veríme, že nástroje na ochranu súkromia musia byť otvorené, aby boli dôveryhodné. Žiadne zadné vrátka, žiadna skrytá telemetria, žiadne proprietárne algoritmy.";
"about.openSource.contribute" = "Príspevky komunity sú vítané!";
"about.openSource.viewCode" = "Zobraziť zdrojový kód na GitHube";
"about.philosophy.title" = "Filozofia";
"about.philosophy.quote1" = "Komunikácia je základné ľudské právo, nie produkt na speňaženie.";
"about.philosophy.quote2" = "Súkromie by malo byť predvolené, nie prémiová funkcia.";
"about.philosophy.quote3" = "Nikto by nemal mať moc umlčať váš hlas alebo čítať vaše myšlienky.";
"about.philosophy.quote4" = "Skutočná sloboda vyžaduje nástroje, ktoré nie je možné ovládať, cenzurovať ani sledovať.";
"about.techStack.title" = "Technologický stack";

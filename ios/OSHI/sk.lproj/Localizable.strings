"guide.cashu.s1" = "OSHI nemá peňaženku a nikdy nedrží vaše peniaze. Prenáša token Cashu — ecash krytý bitcoinom — tak ako prenáša fotku.";
"guide.cashu.s2" = "Najprv potrebujete peňaženku Cashu. eNuts, Minibits alebo cashu.me v prehliadači: všetky sú zadarmo a nastavíte ich asi za minútu.";
"guide.cashu.s3" = "V peňaženke vyberte mint a nahrajte trochu peňazí cez Lightning. Pár stoviek satoshi na vyskúšanie stačí.";
"guide.cashu.s4" = "Vytvorte token: v peňaženke stlačte Poslať, zadajte sumu a skopírujte. Dostanete dlhý riadok textu, ktorý začína cashuB. Tento text SÚ tie peniaze.";
"guide.cashu.s6" = "Druhý človek stlačí Vyplatiť a peniaze mu prídu do peňaženky. Token poslaný vám vyzerá rovnako: stlačte Vyplatiť. OSHI je len obálka.";
"guide.cashu.s5" = "V chate napíšte / do poľa správy, vyberte /pay a vložte token. OSHI pred odoslaním zobrazí sumu, aby ste si ju mohli skontrolovať.";

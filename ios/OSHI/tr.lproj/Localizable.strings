"peers.info.how.title" = "Nasıl Çalışır";
"peers.info.how.description" = "Cihazınız, yakındaki eşlere bağlanmak için Bluetooth ve WiFi Direct kullanır. Bir mesaj gönderdiğinizde, alıcı sizinle doğrudan bağlantılı olmasa bile ağ üzerinden ulaşabilir.";
"peers.info.control.title" = "Elle Bağlantı Kontrolü";
"peers.info.control.description" = "Bağlı bir eşin bağlantısını geçici olarak kesmek için dokunun. Tekrar dokunana veya uygulamayı yeniden açana kadar yeniden bağlanmayacaklardır. Bu, belirli bir eş için bulut mesajlaşmasını kullanmak istediğinizde yararlıdır.";
"peers.info.privacy.title" = "Gizlilik ve Güvenlik";

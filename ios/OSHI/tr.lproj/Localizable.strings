"about.vision.title" = "Vizyon";
"about.vision.paragraph1" = "OSHI yalnızca bir mesajlaşma uygulaması değil; **dijital özgürlük için bir iletişim protokolüdür**. Egemenlik, gizlilik ve dayanıklılık ilkeleri üzerine inşa edilmiştir.";
"about.vision.paragraph2" = "Menzilde biri varsa OSHI **hiç internet ve hiçbir sunucu olmadan** çalışır; mesajları doğrudan Bluetooth/Wi-Fi bağlantıları veya çok atlamalı aktarımlar üzerinden **eşler arası örgü ağ** ile iletir. Menzilde kimse yoksa, mesajın yine de ulaşması için kendi aktarıcımıza geçer.";
"about.vision.paragraph3" = "Her mesaj, **X3DH** anahtar anlaşması ve **AES-256-GCM** ile birlikte **Double Ratchet** tarafından korunur — Signal'in kullandığı yapının aynısı — ve bu, çevrimdışı aktarımlarda ve sırasız teslimatta da geçerlidir.";
"about.principles.title" = "Temel İlkeler";
"about.principles.privacy.title" = "Varsayılan Gizlilik";
"about.principles.privacy.desc" = "Telefon numarası yok, e-posta yok, hesap yok, takip yok. Örgü ağ üzerinden gönderilen mesajlar hiçbir sunucuda hiçbir şey bırakmaz.";
"about.principles.decentralization.title" = "Merkeziyetsizlik";
"about.principles.decentralization.desc" = "Merkezi otorite yok, tek hata noktası yok. Güç ağ genelinde dağıtılmıştır.";
"about.principles.sovereignty.title" = "Egemenlik";
"about.principles.sovereignty.desc" = "Kimliğinizi, verilerinizi ve bağlantılarınızı siz kontrol edersiniz. Şirket yok, gözetim yok.";
"about.principles.resilience.title" = "Dayanıklılık";
"about.principles.resilience.desc" = "İnternet kesintilerinde, sansürde veya afet senaryolarında çalışır. İletişim durdurulamaz.";
"about.features.title" = "Teknik Özellikler";
"about.features.doubleRatchet.title" = "Double Ratchet Protokolü";
"about.features.doubleRatchet.desc" = "X3DH ve AES-256-GCM ile Double Ratchet üzerine kurulu uçtan uca şifreleme. Her iki cihaz da destekliyorsa anahtar anlaşmasında ayrıca hibrit bir kuantum sonrası katman (X25519 ile birleştirilmiş ML-KEM-768) çalışır; böylece bugün kaydedilen trafik gelecekteki bir kuantum bilgisayarla da okunamaz.";
"about.features.mesh.title" = "Çok Atlamalı Ağ Yönlendirme";
"about.features.mesh.desc" = "Mesajlar, çevrimdışı olsa bile hedefe ulaşmak için güvenilen eşler üzerinden aktarılır.";
"about.features.fallback.title" = "Hibrit Bulut Yedeği";
"about.features.fallback.desc" = "Önce mesh, hiçbir sunucu olmadan. Bu yolla kişinize ulaşılamazsa mesaj kendi rölemizden geçer; röle mesajı şifreli saklar ve okuyamaz.";
"about.features.identity.title" = "Kriptografik Kimlik";
"about.features.identity.desc" = "Kimliğiniz, cihazınızda oluşturulan bir Curve25519 anahtar çiftidir. Kaydedilecek bir şey yok, el konulacak bir şey yok.";
"about.features.ordering.title" = "Sırasız Mesaj İşleme";
"about.features.ordering.desc" = "Gelişmiş mesaj tamponlama, ağ kaosunu sorunsuz şekilde yönetir.";
"about.features.media.title" = "Şifreli Medya";
"about.features.media.desc" = "Fotoğraf ve video gönderin; AES-256-GCM şifrelemesiyle yalnızca alıcı tarafından çözülür.";
"about.features.qr.title" = "QR Kod Eşleştirme";
"about.features.qr.desc" = "Kriptografik güvenlik numaralarıyla kişileri doğrulamak ve eklemek için tarayın.";
"about.features.serverless.title" = "Sunucusuz Mimari";
"about.features.serverless.desc" = "Kullanıcı hesabı yok, telefon numarası yok, e-posta yok, veri toplama yok, izleme yok.";
"about.howItWorks.title" = "Nasıl Çalışır";
"about.howItWorks.step1.title" = "Kimliğinizi Oluşturun";
"about.howItWorks.step1.desc" = "Benzersiz, doğrulanabilir kimliğiniz olan kriptografik bir kimlik oluşturun.";
"about.howItWorks.step2.title" = "Eşlere Bağlanın";
"about.howItWorks.step2.desc" = "Bluetooth veya WiFi ağı üzerinden yakındaki cihazları keşfedin ya da güvenilir kişi eklemek için QR kodları tarayın.";
"about.howItWorks.step3.title" = "Şifreli Mesaj Gönderin";
"about.howItWorks.step3.desc" = "Mesajlar Double Ratchet ile şifrelenir ve doğrudan eşlere gönderilir ya da ağ üzerinden aktarılır.";
"about.howItWorks.step4.title" = "Bulut Yedeğine Geç";
"about.howItWorks.step4.desc" = "Mesh kişinize ulaşamazsa, şifreli mesaj teslim edilene kadar kendi röle sunucumuzda tutulur. Röle mesajı okuyamaz ve mesaj hiçbir zaman herkese açık bir ağda yayımlanmaz.";
"about.howItWorks.step5.title" = "Sürekli Değişen Anahtarlar";
"about.howItWorks.step5.desc" = "Her mesaj kendi anahtarını alır ve zincir her gönderimden sonra bir adım ilerler.";
"about.useCases.title" = "Kimler İçin";
"about.useCases.journalists.title" = "Gazeteciler";
"about.useCases.journalists.desc" = "Düşmanca ortamlarda güvenli iletişim";
"about.useCases.activists.title" = "Aktivistler";
"about.useCases.activists.desc" = "Gözetim veya sansür olmadan örgütlenin";
"about.useCases.emergency.title" = "Acil Müdahale";
"about.useCases.emergency.desc" = "Altyapı çöktüğünde koordinasyon sağlayın";
"about.useCases.travelers.title" = "Gezginler";
"about.useCases.travelers.desc" = "Dolaşım veya internet olmadan bağlantıda kalın";
"about.useCases.privacy.title" = "Gizlilik Savunucuları";
"about.useCases.privacy.desc" = "Kurumsal aracılar olmadan iletişim kurun";
"about.useCases.crypto.title" = "Kripto Kullanıcıları";
"about.useCases.crypto.desc" = "Güvenli koordinasyon için yerel kimlik entegrasyonu";
"about.openSource.title" = "Açık Kaynak ve Şeffaflık";
"about.openSource.paragraph1" = "OSHI **%100 açık kaynaklıdır**, şeffaflık ve denetlenebilirlik temel ilkeleridir. Her kod satırı herkese açık ve doğrulanabilirdir.";
"about.openSource.paragraph2" = "Gizlilik araçlarının güvenilir olabilmesi için açık olması gerektiğine inanıyoruz. Arka kapı yok, gizli telemetri yok, tescilli algoritma yok.";
"about.openSource.contribute" = "Topluluk katkılarına açığız!";
"about.openSource.viewCode" = "GitHub'da Kaynak Kodu Görüntüle";
"about.philosophy.title" = "Felsefe";
"about.philosophy.quote1" = "İletişim, para kazanılacak bir ürün değil, temel bir insan hakkıdır.";
"about.philosophy.quote2" = "Gizlilik varsayılan olmalı, bir ücretli özellik değil.";
"about.philosophy.quote3" = "Hiç kimse sesinizi susturacak ya da düşüncelerinizi okuyacak güce sahip olmamalıdır.";
"about.philosophy.quote4" = "Gerçek özgürlük, kontrol edilemeyen, sansürlenemeyen ve gözetlenemeyen araçlar gerektirir.";

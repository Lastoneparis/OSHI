/* __IN_APP_GUIDES_2026_11_02__ The two things people keep asking how to do.
   The Cashu warning is a STEP, not a footnote: a token is bearer cash, and
   glossing over that to read more smoothly would be the most expensive
   sentence in the app. */
"guide.add_contact.title" = "Add a contact";
"guide.add_contact.s1" = "Tap the + button, then \"My code\". That QR code IS your address in OSHI. There is no phone number and no username.";
"guide.add_contact.s2" = "Sitting together? Have them tap \"Scan\" and point their camera at your code. You are connected — that is the whole step.";
"guide.add_contact.s3" = "Far apart? Tap \"Invite by link\" and send that link however you like — SMS, email, any app. Opening it on a phone with OSHI adds you.";
"guide.add_contact.s4" = "No internet at all? Open \"Nearby\". Any phone running OSHI within about 100 m appears there over Bluetooth, and you can add each other with no network.";
"guide.cashu.title" = "ارسال بیت‌کوین در گفتگو";
"guide.cashu.s1" = "OSHI کیف پول ندارد و هرگز پول شما را نگه نمی‌دارد. تنها یک توکن Cashu — ایکش پشتیبانی‌شده با بیت‌کوین — را جابه‌جا می‌کند، همان‌طور که یک عکس را جابه‌جا می‌کند.";
"guide.cashu.s2" = "نخست به یک کیف پول Cashu نیاز دارید. eNuts، Minibits یا cashu.me در مرورگر: همه رایگان‌اند و در حدود یک دقیقه آماده می‌شوند.";
"guide.cashu.s3" = "در کیف پول یک mint انتخاب کنید و کمی پول با Lightning شارژ کنید. چند صد ساتوشی برای امتحان کافی است.";
"guide.cashu.s4" = "یک توکن بسازید: در کیف پول «ارسال» را بزنید، مبلغ را وارد کنید و کپی کنید. یک رشته متن بلند می‌گیرید که با cashuB شروع می‌شود. همان متن، خودِ پول است.";
"guide.cashu.s6" = "طرف مقابل «دریافت» را می‌زند و پول به کیف پول او می‌رسد. توکنی که برای شما فرستاده شود هم همین شکل است: «دریافت» را بزنید. OSHI تنها پاکت نامه است.";
"guide.cashu.s5" = "در گفتگو، در کادر پیام / را تایپ کنید، /pay را انتخاب کنید و توکن را بچسبانید. OSHI پیش از ارسال مبلغ را نشان می‌دهد تا بتوانید بررسی کنید.";
"guide.cashu.sub" = "ایکش Cashu — OSHI هرگز پول شما را نگه نمی‌دارد";
"guide.cashu.warning" = "توکن Cashu پول نقد است. هر کسی این متن را به دست بیاورد می‌تواند خرجش کند و هر کس زودتر آن را دریافت کند صاحبش می‌شود — پس تنها برای کسی بفرستید که در نظر دارید. OSHI نمی‌تواند از mint بپرسد که آیا توکن قبلاً خرج شده است: تنها زمانی مال شماست که کیف پول خودتان آن را دریافت کند.";
